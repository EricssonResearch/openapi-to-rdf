TS28572_PlanManagement_TriggerDescriptor:isTriggerActive a rdf:Property ;
    rdfs:comment "The indication if the trigger can start activation jobs (trigger is active), or if the trigger cannot start activation jobs (trigger is inactive)." ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptor ;
    rdfs:range xsd:boolean .

TS28572_PlanManagement_TriggerDescriptor:lastModifiedAt a rdf:Property ;
    rdfs:comment "The date and time at which the trigger condition was modified the last time by a MnS consumer. Upon creation of the trigger condition descriptor the value of the information element is set to the date and time at which the descriptor is created." ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptor ;
    rdfs:range xsd:dateTime .

TS28572_PlanManagement_TriggerDescriptor:lastTriggeredAt a rdf:Property ;
    rdfs:comment "The date and time at which the evaluation result of the trigger condition changed the last time from \"False\" to \"True\"." ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptor ;
    rdfs:range xsd:dateTime .

TS28572_PlanManagement_TriggerDescriptorBaseProperties:activationJobs a rdf:Property ;
    rdfs:comment "The identifiers of one or more activation jobs that shall be triggered by this condition." ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptorBaseProperties .

TS28572_PlanManagement_TriggerDescriptorBaseProperties:conditionExpression a rdf:Property ;
    rdfs:comment "The condition expression" ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptorBaseProperties ;
    rdfs:range xsd:string .

TS28572_PlanManagement_TriggerDescriptorBaseProperties:customProperties a rdf:Property ;
    rdfs:comment "A dynamic set of custom properties provided by client" ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptorBaseProperties ;
    rdfs:range rdfs:Resource .

TS28572_PlanManagement_TriggerDescriptorBaseProperties:description a rdf:Property ;
    rdfs:comment "Used to describe the purpose of the trigger" ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptorBaseProperties ;
    rdfs:range xsd:string .

TS28572_PlanManagement_TriggerDescriptorBaseProperties:evaluationPeriod a rdf:Property ;
    rdfs:comment "The evaluation period specifies the interval of time in seconds  between two consecutive condition expression evaluations." ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptorBaseProperties ;
    rdfs:range xsd:integer .

TS28572_PlanManagement_TriggerDescriptorBaseProperties:hysteresis a rdf:Property ;
    rdfs:comment "The hysteresis, when present, specifies that the trigger shall not be activated immediately when the evaluation result changes from false to true or a specified number of times.  Values greater or equal to 1 are allowed" ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptorBaseProperties .

TS28572_PlanManagement_TriggerDescriptorBaseProperties:isTriggerOnce a rdf:Property ;
    rdfs:comment "The boolean indication, if the trigger is disarmed after the first firing." ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptorBaseProperties ;
    rdfs:range xsd:boolean .

TS28572_PlanManagement_TriggerDescriptorBaseProperties:name a rdf:Property ;
    rdfs:comment "Descriptive name of the trigger descriptor" ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptorBaseProperties ;
    rdfs:range xsd:string .

TS28572_PlanManagement_TriggerDescriptorBaseProperties:startEvaluationAt a rdf:Property ;
    rdfs:comment "The date and time at which the evaluation of the condition expression shall start. The evaluation result is set to \"False\" before that date and time. If the information element is not specified, evaluation of the trigger condition shall start immediately." ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptorBaseProperties ;
    rdfs:range xsd:dateTime .

TS28572_PlanManagement_TriggerDescriptorBaseProperties:stopEvaluationAt a rdf:Property ;
    rdfs:comment "The date and time at which the evaluation of the condition expression shall stop. The evaluation result is set to \"False\" after that date and time. If the information element is not specified, evaluation of the trigger condition shall continue until the deletion of the trigger condition descriptor." ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptorBaseProperties ;
    rdfs:range xsd:dateTime .

TS28572_PlanManagement_TriggerDescriptorBaseProperties:version a rdf:Property ;
    rdfs:comment "an optional version for the Trigger Descriptor" ;
    rdfs:domain TS28572_PlanManagement:TriggerDescriptorBaseProperties ;
    rdfs:range xsd:string .

