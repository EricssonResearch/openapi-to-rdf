@prefix TS28532_StreamingDataMnS_streamInfo_Type: <http://ericsson.com/models/3gpp/TS28532/StreamingDataMnS/streamInfo_Type#> .
@prefix TS28532_StreamingDataMnS_vsDataContainer_Type: <http://ericsson.com/models/3gpp/TS28532/StreamingDataMnS/vsDataContainer_Type#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28532_StreamingDataMnS:analyticsInfo_Type a rdfs:Class ;
    rdfs:comment "Information specific to analytics reporting." .

TS28532_StreamingDataMnS:connectionInfo_Type a rdfs:Class .

TS28532_StreamingDataMnS:connectionRequest_Type a rdfs:Class .

TS28532_StreamingDataMnS:errorResponse_Type a rdfs:Class .

TS28532_StreamingDataMnS:failedConnectionResponse_Type a rdfs:Class .

TS28532_StreamingDataMnS:measObjDn_Type a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI allOf - complex logical constraints partially supported in SHACL" .

TS28532_StreamingDataMnS:performanceInfo_Type a rdfs:Class ;
    rdfs:comment "Information specific to performance data reporting" .

TS28532_StreamingDataMnS:performanceMetrics_Type a rdfs:Class ;
    rdfs:comment "an ordered list of performance metric names (see clause 4.4.1 of 3GPP TS 28.622[11]) whose values are to be reported by the Performance Data Stream Units (see Annex C of TS 28.550 [42]) via this stream. Performance metrics include measurement and KPI" .

TS28532_StreamingDataMnS:producerId_Type a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI allOf - complex logical constraints partially supported in SHACL" .

TS28532_StreamingDataMnS:streamInfoWithReporters_Type a rdfs:Class ;
    rdfs:comment "Reporting stream meta-data with added information about reporters." .

TS28532_StreamingDataMnS:streamInfo_Type a rdfs:Class ;
    rdfs:comment "Reporting stream meta-data." .

TS28532_StreamingDataMnS:traceInfo_Type a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI allOf - complex logical constraints partially supported in SHACL" .

TS28532_StreamingDataMnS:vsDataContainer_Type a rdfs:Class ;
    rdfs:comment "container for vendor specific data (see 3GPP TS 28.622)" .

TS28532_StreamingDataMnS:errorInfo a rdf:Property ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS:errorReason a rdf:Property ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS:serializationFormat_Type a rdfs:Datatype .

TS28532_StreamingDataMnS:streamId a rdf:Property ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS:streamType_Type a rdfs:Datatype .

TS28532_StreamingDataMnS:systemDN_Type a rdfs:Datatype ;
    rdfs:comment "See 3GPP TS 32.300 for details" .

TS28532_StreamingDataMnS:traceReference_Type a rdfs:Datatype ;
    rdfs:comment "Trace Reference (see clause 5.6 of 3GPP TS 32.422) as stream identifier for streaming trace data reporting" .

TS28532_StreamingDataMnS:uri_Type a rdfs:Datatype ;
    rdfs:comment "Resource URI" .

TS28532_StreamingDataMnS:websocketHeaderConnection_Type a rdfs:Datatype ;
    rdfs:comment "Header value for the upgrade request and response." .

TS28532_StreamingDataMnS:websocketHeaderUpgrade_Type a rdfs:Datatype ;
    rdfs:comment "Header value for the upgrade to WebSocket request and response." .

TS28532_StreamingDataMnS:websocketHeader_Sec_WebSocket_Accept_Type a rdfs:Datatype ;
    rdfs:comment "Header value for secure WebSocket response. Carries hash." .

TS28532_StreamingDataMnS:websocketHeader_Sec_WebSocket_Extensions_Type a rdfs:Datatype ;
    rdfs:comment "Header value for secure WebSocket request. Carries protocol extensions." .

TS28532_StreamingDataMnS:websocketHeader_Sec_WebSocket_Key_Type a rdfs:Datatype ;
    rdfs:comment "Header value for secure WebSocket request. Provides information to the server which is needed in order to confirm that the client is entitled to request an upgrade to WebSocket." .

TS28532_StreamingDataMnS:websocketHeader_Sec_WebSocket_Protocol_Type a rdfs:Datatype ;
    rdfs:comment "Header value for secure WebSocket request. Carries a comma-separated list of subprotocol names, in the order of preference." .

TS28532_StreamingDataMnS:websocketHeader_Sec_WebSocket_Version_Type a rdfs:Datatype ;
    rdfs:comment "Header value for secure WebSocket request and response. Carries the WebSocket protocol version to be used." .

TS28532_StreamingDataMnS_analyticsInfo_Type:activityDetails a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:analyticsInfo_Type ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS_connectionInfo_Type:connection a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:connectionInfo_Type ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS_connectionInfo_Type:producer a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:connectionInfo_Type ;
    rdfs:range TS28532_StreamingDataMnS:producerId_Type .

TS28532_StreamingDataMnS_connectionInfo_Type:streams a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:connectionInfo_Type ;
    rdfs:range TS28532_StreamingDataMnS:streamId_Type .

TS28532_StreamingDataMnS_connectionRequest_Type:producer a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:connectionRequest_Type ;
    rdfs:range TS28532_StreamingDataMnS:producerId_Type .

TS28532_StreamingDataMnS_connectionRequest_Type:streams a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:connectionRequest_Type ;
    rdfs:range TS28532_StreamingDataMnS:streamInfo_Type .

TS28532_StreamingDataMnS_errorResponse_Type:error a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:errorResponse_Type ;
    rdfs:range rdfs:Resource .

TS28532_StreamingDataMnS_failedConnectionResponse_Type:error a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:failedConnectionResponse_Type ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS_performanceInfo_Type:jobId a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:performanceInfo_Type ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS_performanceInfo_Type:measObjDn a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:performanceInfo_Type ;
    rdfs:range TS28532_StreamingDataMnS:measObjDn_Type .

TS28532_StreamingDataMnS_performanceInfo_Type:performanceMetrics a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:performanceInfo_Type ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS_streamInfoWithReporters_Type:reporters a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:streamInfoWithReporters_Type ;
    rdfs:range TS28532_StreamingDataMnS:producerId_Type .

TS28532_StreamingDataMnS_streamInfoWithReporters_Type:streamInfo a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:streamInfoWithReporters_Type ;
    rdfs:range TS28532_StreamingDataMnS:streamInfo_Type .

TS28532_StreamingDataMnS_streamInfo_Type:additionalInfo a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:streamInfo_Type ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS_streamInfo_Type:serializationFormat a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:streamInfo_Type ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS_streamInfo_Type:streamId a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:streamInfo_Type ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS_streamInfo_Type:streamType a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:streamInfo_Type ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS_vsDataContainer_Type:vsData a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:vsDataContainer_Type ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS_vsDataContainer_Type:vsDataFormatVersion a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:vsDataContainer_Type ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS_vsDataContainer_Type:vsDataType a rdf:Property ;
    rdfs:domain TS28532_StreamingDataMnS:vsDataContainer_Type ;
    rdfs:range xsd:string .

TS28532_StreamingDataMnS:streamId_Type a rdfs:Datatype ;
    rdfs:comment "globally unique stream identifier" .

