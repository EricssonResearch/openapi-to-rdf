@prefix TS28532_StreamingDataMnS_connectionInfo_Type: <http://ericsson.com/models/3gpp/TS28532/StreamingDataMnS/connectionInfo_Type#> .
@prefix TS28532_StreamingDataMnS_connectionRequest_Type: <http://ericsson.com/models/3gpp/TS28532/StreamingDataMnS/connectionRequest_Type#> .
@prefix TS28532_StreamingDataMnS_errorResponse_Type: <http://ericsson.com/models/3gpp/TS28532/StreamingDataMnS/errorResponse_Type#> .
@prefix TS28532_StreamingDataMnS_failedConnectionResponse_Type: <http://ericsson.com/models/3gpp/TS28532/StreamingDataMnS/failedConnectionResponse_Type#> .
@prefix TS28532_StreamingDataMnS_performanceInfo_Type: <http://ericsson.com/models/3gpp/TS28532/StreamingDataMnS/performanceInfo_Type#> .
