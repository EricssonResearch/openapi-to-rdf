@prefix TS28532_FileDataReportingMnS: <https://example.org/TS28532_FileDataReportingMnS/> .
@prefix TS28532_FileDataReportingMnS_FileInfo: <https://example.org/TS28532_FileDataReportingMnS/FileInfo/> .
@prefix TS28532_FileDataReportingMnS_NotifyFilePreparationError: <https://example.org/TS28532_FileDataReportingMnS/NotifyFilePreparationError/> .
@prefix TS28532_FileDataReportingMnS_NotifyFileReady: <https://example.org/TS28532_FileDataReportingMnS/NotifyFileReady/> .
@prefix TS28623_ComDefs: <https://example.org/TS28623_ComDefs/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28532_FileDataReportingMnS:FileInfo a rdfs:Class .

TS28532_FileDataReportingMnS:NotifyFilePreparationError a rdfs:Class ;
    rdfs:subClassOf TS28623_ComDefs:NotificationHeader .

TS28532_FileDataReportingMnS:NotifyFileReady a rdfs:Class ;
    rdfs:subClassOf TS28623_ComDefs:NotificationHeader .

TS28532_FileDataReportingMnS:FileDataType a rdfs:Datatype .

TS28532_FileDataReportingMnS_FileInfo:fileCompression a rdf:Property ;
    rdfs:domain TS28532_FileDataReportingMnS:FileInfo ;
    rdfs:range xsd:string .

TS28532_FileDataReportingMnS_FileInfo:fileDataType a rdf:Property ;
    rdfs:domain TS28532_FileDataReportingMnS:FileInfo ;
    rdfs:range xsd:string .

TS28532_FileDataReportingMnS_FileInfo:fileExpirationTime a rdf:Property ;
    rdfs:domain TS28532_FileDataReportingMnS:FileInfo ;
    rdfs:range xsd:dateTime .

TS28532_FileDataReportingMnS_FileInfo:fileFormat a rdf:Property ;
    rdfs:domain TS28532_FileDataReportingMnS:FileInfo ;
    rdfs:range xsd:string .

TS28532_FileDataReportingMnS_FileInfo:fileLocation a rdf:Property ;
    rdfs:domain TS28532_FileDataReportingMnS:FileInfo ;
    rdfs:range xsd:string .

TS28532_FileDataReportingMnS_FileInfo:fileReadyTime a rdf:Property ;
    rdfs:domain TS28532_FileDataReportingMnS:FileInfo ;
    rdfs:range xsd:dateTime .

TS28532_FileDataReportingMnS_FileInfo:fileSize a rdf:Property ;
    rdfs:domain TS28532_FileDataReportingMnS:FileInfo ;
    rdfs:range xsd:integer .

TS28532_FileDataReportingMnS:FileNotificationTypes a rdfs:Datatype .

TS28532_FileDataReportingMnS_NotifyFilePreparationError:additionalText a rdf:Property ;
    rdfs:domain TS28532_FileDataReportingMnS:NotifyFilePreparationError ;
    rdfs:range xsd:string .

TS28532_FileDataReportingMnS_NotifyFilePreparationError:fileInfoList a rdf:Property ;
    rdfs:domain TS28532_FileDataReportingMnS:NotifyFilePreparationError ;
    rdfs:range TS28532_FileDataReportingMnS:FileInfo .

TS28532_FileDataReportingMnS_NotifyFilePreparationError:reason a rdf:Property ;
    rdfs:domain TS28532_FileDataReportingMnS:NotifyFilePreparationError ;
    rdfs:range xsd:string .

TS28532_FileDataReportingMnS_NotifyFileReady:additionalText a rdf:Property ;
    rdfs:domain TS28532_FileDataReportingMnS:NotifyFileReady ;
    rdfs:range xsd:string .

TS28532_FileDataReportingMnS_NotifyFileReady:fileInfoList a rdf:Property ;
    rdfs:domain TS28532_FileDataReportingMnS:NotifyFileReady ;
    rdfs:range TS28532_FileDataReportingMnS:FileInfo .

TS28532_FileDataReportingMnS:additionalText a rdf:Property ;
    rdfs:range xsd:string .

TS28532_FileDataReportingMnS:fileInfoList a rdf:Property ;
    rdfs:range TS28532_FileDataReportingMnS:FileInfo .

TS28532_FileDataReportingMnS:reason a rdf:Property ;
    rdfs:range xsd:string .

