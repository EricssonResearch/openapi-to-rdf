@prefix TS28319_MsacNrm: <http://ericsson.com/models/3gpp/TS28319/MsacNrm#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28319_MsacNrm:AccessRule_Single a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI allOf - complex logical constraints partially supported in SHACL" .

TS28319_MsacNrm:Identity_Single a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI allOf - complex logical constraints partially supported in SHACL" .

TS28319_MsacNrm:Role_Single a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI allOf - complex logical constraints partially supported in SHACL" .

TS28319_MsacNrm:resources_msacNrm a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" .

TS28319_MsacNrm:accessRulesList a rdf:Property ;
    rdfs:range xsd:string .

TS28319_MsacNrm:actions a rdf:Property ;
    rdfs:range xsd:string .

TS28319_MsacNrm:attributes a rdf:Property ;
    rdfs:domain TS28319_MsacNrm:AccessRule_Single ;
    rdfs:range rdfs:Resource .

TS28319_MsacNrm:componentCData a rdf:Property ;
    rdfs:range xsd:string .

TS28319_MsacNrm:credential a rdf:Property ;
    rdfs:range xsd:string .

TS28319_MsacNrm:identityName a rdf:Property ;
    rdfs:range xsd:string .

TS28319_MsacNrm:identityType a rdf:Property ;
    rdfs:range xsd:string .

TS28319_MsacNrm:operations a rdf:Property ;
    rdfs:range xsd:string .

TS28319_MsacNrm:resources a rdf:Property ;
    rdfs:range xsd:string .

TS28319_MsacNrm:roleName a rdf:Property ;
    rdfs:range xsd:string .

TS28319_MsacNrm:roleRefList a rdf:Property ;
    rdfs:range xsd:string .

TS28319_MsacNrm:ruleName a rdf:Property ;
    rdfs:range xsd:string .

