@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28317_RanScNrm:NEIdentification a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" .

TS28317_RanScNrm:NEInfomration a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI anyOf - complex logical constraints partially supported in SHACL" .

TS28317_RanScNrm:ScMgmtProfile_Multiple a rdfs:Class .

TS28317_RanScNrm:ScMgmtProfile_Single a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI allOf - complex logical constraints partially supported in SHACL" .

TS28317_RanScNrm:ScProcessMonitor a rdfs:Class ;
    rdfs:comment "This data type is the \"ProcessMonitor\" data type with specialisations for usage in the RANSC management for monitoring for the self configuration process." .

TS28317_RanScNrm:Sc_Process_Multiple a rdfs:Class .

TS28317_RanScNrm:Sc_Process_Single a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI allOf - complex logical constraints partially supported in SHACL" .

TS28317_RanScNrm:SubNetwork_ncO_RanScNrm a rdfs:Class .

TS28317_RanScNrm:resources_RanScNrm a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" .

TS28317_RanScNrm:EnbId a rdfs:Datatype ;
    rdfs:comment "It is the identity of ng-eNB" .

TS28317_RanScNrm:GnbId a rdfs:Datatype ;
    rdfs:comment "It is the identity of gNB" .

TS28317_RanScNrm:NEType a rdfs:Datatype ;
    rdfs:comment "It defines the type of RAN NE" .

TS28317_RanScNrm_ScMgmtProfile_Single:configDataFileLocation a rdf:Property ;
    rdfs:domain TS28317_RanScNrm:ScMgmtProfile_Single ;
    rdfs:range xsd:string .

TS28317_RanScNrm_ScMgmtProfile_Single:nEInformation a rdf:Property ;
    rdfs:comment "This attribute defines the NE Type(s) or the NE instance(s) for which this  ScMgmtProfile instance is valid." ;
    rdfs:domain TS28317_RanScNrm:ScMgmtProfile_Single ;
    rdfs:range TS28317_RanScNrm:NEInfomration .

TS28317_RanScNrm_ScProcessMonitor:endTime a rdf:Property ;
    rdfs:domain TS28317_RanScNrm:ScProcessMonitor ;
    rdfs:range xsd:dateTime .

TS28317_RanScNrm_ScProcessMonitor:jobId a rdf:Property ;
    rdfs:domain TS28317_RanScNrm:ScProcessMonitor ;
    rdfs:range xsd:string .

TS28317_RanScNrm_ScProcessMonitor:progressPercentage a rdf:Property ;
    rdfs:domain TS28317_RanScNrm:ScProcessMonitor ;
    rdfs:range xsd:integer .

TS28317_RanScNrm_ScProcessMonitor:progressStateInfo a rdf:Property ;
    rdfs:domain TS28317_RanScNrm:ScProcessMonitor ;
    rdfs:range xsd:string .

TS28317_RanScNrm_ScProcessMonitor:resultStateInfo a rdf:Property ;
    rdfs:domain TS28317_RanScNrm:ScProcessMonitor ;
    rdfs:range xsd:string .

TS28317_RanScNrm_ScProcessMonitor:startTime a rdf:Property ;
    rdfs:domain TS28317_RanScNrm:ScProcessMonitor ;
    rdfs:range xsd:dateTime .

TS28317_RanScNrm_ScProcessMonitor:status a rdf:Property ;
    rdfs:domain TS28317_RanScNrm:ScProcessMonitor ;
    rdfs:range xsd:string .

TS28317_RanScNrm_Sc_Process_Single:cancelScProcess a rdf:Property ;
    rdfs:comment "Setting this attribute to \"TRUE\" cancels the self configuration process. " ;
    rdfs:domain TS28317_RanScNrm:Sc_Process_Single ;
    rdfs:range xsd:string .

TS28317_RanScNrm_Sc_Process_Single:nEIdentification a rdf:Property ;
    rdfs:domain TS28317_RanScNrm:Sc_Process_Single ;
    rdfs:range TS28317_RanScNrm:NEIdentification .

TS28317_RanScNrm_Sc_Process_Single:scMgmtProfileRef a rdf:Property ;
    rdfs:domain TS28317_RanScNrm:Sc_Process_Single ;
    rdfs:range xsd:string .

TS28317_RanScNrm_Sc_Process_Single:scProcessMonitor a rdf:Property ;
    rdfs:domain TS28317_RanScNrm:Sc_Process_Single ;
    rdfs:range TS28317_RanScNrm:ScProcessMonitor .

TS28317_RanScNrm_SubNetwork_ncO_RanScNrm:ScMgmtProfile a rdf:Property ;
    rdfs:domain TS28317_RanScNrm:SubNetwork_ncO_RanScNrm ;
    rdfs:range TS28317_RanScNrm:ScMgmtProfile_Multiple .

TS28317_RanScNrm_SubNetwork_ncO_RanScNrm:Sc_Process a rdf:Property ;
    rdfs:domain TS28317_RanScNrm:SubNetwork_ncO_RanScNrm ;
    rdfs:range TS28317_RanScNrm:Sc_Process_Multiple .

