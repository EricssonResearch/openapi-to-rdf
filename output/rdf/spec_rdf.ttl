@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix spec: <https://example.com/ontology/x/rdf/spec#> .
@prefix spec_A: <https://example.com/ontology/x/rdf/spec/A#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

spec:A a rdfs:Class .

spec_A:id a rdf:Property ;
    rdfs:domain spec:A ;
    rdfs:range xsd:string .

