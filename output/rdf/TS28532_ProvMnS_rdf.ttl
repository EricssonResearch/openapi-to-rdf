    rdfs:range TS28623_ComDefs:AttributeNameValuePairSet .

TS28532_ProvMnS:additionalText a rdf:Property ;
    rdfs:domain TS28532_ProvMnS:NotifyEvent ;
    rdfs:range xsd:string .

TS28532_ProvMnS:attributeList a rdf:Property ;
    rdfs:range TS28623_ComDefs:AttributeNameValuePairSet .

TS28532_ProvMnS:attributeListValueChanges a rdf:Property ;
    rdfs:domain TS28532_ProvMnS:NotifyMoiAttributeValueChanges ;
    rdfs:range TS28623_ComDefs:AttributeValueChangeSet .

TS28532_ProvMnS:correlatedNotifications a rdf:Property ;
    rdfs:range TS28532_ProvMnS:CorrelatedNotification .

TS28532_ProvMnS:from a rdf:Property ;
    rdfs:domain TS28532_ProvMnS:PatchItem ;
    rdfs:range xsd:string .

TS28532_ProvMnS:insert a rdf:Property ;
