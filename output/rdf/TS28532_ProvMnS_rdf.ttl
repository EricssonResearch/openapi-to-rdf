TS28532_ProvMnS:NotifyMoiDeletion a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI allOf - complex logical constraints partially supported in SHACL" .

TS28532_ProvMnS:PatchItem a rdfs:Class .

TS28532_ProvMnS:Resource a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" .

TS28532_ProvMnS:Scope a rdfs:Class .

TS28532_ProvMnS:CmNotificationTypes a rdfs:Datatype .

TS28532_ProvMnS:Insert a rdfs:Datatype .

TS28532_ProvMnS:Operation a rdfs:Datatype .

