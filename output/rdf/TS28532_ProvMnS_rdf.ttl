    rdfs:range xsd:string .

TS28532_ProvMnS:path a rdf:Property ;
    rdfs:range xsd:string .

TS28532_ProvMnS:scopeLevel a rdf:Property ;
    rdfs:domain TS28532_ProvMnS:Scope ;
    rdfs:range xsd:integer .

TS28532_ProvMnS:scopeType a rdf:Property ;
    rdfs:domain TS28532_ProvMnS:Scope ;
    rdfs:range xsd:string .

TS28532_ProvMnS:source a rdf:Property ;
