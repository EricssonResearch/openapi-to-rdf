TS28623_TraceControlNrm:UECoreMeasConfig_Type a rdfs:Class ;
    rdfs:comment "UE level measurements configuration parameters for 5G system. See details in 3GPP TS 28.622 clause 4.3.x." .

TS28623_TraceControlNrm:eventThresholdL1_Type a rdfs:Class ;
    rdfs:comment "See details in 3GPP TS 32.422 clause 5.10.36." .

TS28623_TraceControlNrm:eventThreshold_Type a rdfs:Class ;
    rdfs:comment "See details in 3GPP TS 32.422 clause 5.10.7 (LTE/NR Event A2 RSRP, RSRQ, SINR), 5.10.13 (UMTS Event 1f) and 5.10.14 (UMTS Event 1i)." .

TS28623_TraceControlNrm:excessPacketDelayThreshold_Type a rdfs:Class ;
    rdfs:comment "Excess Packet Delay Threshold for NR MDT. See details in 3GPP TS 32.422 clause 4.1.1 and 4.1.2." .

TS28623_TraceControlNrm:excessPacketDelayThresholds_Type a rdfs:Class ;
    rdfs:comment "Array of type excessPacketDelayThreshold-Type." .

TS28623_TraceControlNrm:immediateMDTConfig_Type a rdfs:Class ;
    rdfs:comment "Immediate MDT configuration parameters. See details in 3GPP TS 28.622 clause 4.3.30." .

TS28623_TraceControlNrm:listOfInterfaces_Type a rdfs:Class ;
    rdfs:comment "The interfaces to be recorded in the Network Element. See 3GPP TS 32.422 clause 5.5 for additional details." .

TS28623_TraceControlNrm:listOfMeasurements_Type a rdfs:Class ;
    rdfs:comment "See details in 3GPP TS 32.422 clause 5.10.3 for details." .

TS28623_TraceControlNrm:listOfNeTypes_Type a rdfs:Class ;
    rdfs:comment "The Network Element types where Trace Session activation is needed. See 3GPP TS 32.422 clause 5.4 for additional details." .

TS28623_TraceControlNrm:listOfTraceMetrics a rdfs:Class ;
    rdfs:comment "The trace metrics to be reported. See 3GPP TS 32.422 clause 10 for additional details." .

TS28623_TraceControlNrm:loggedMDTConfig_Type a rdfs:Class ;
    rdfs:comment "Logged MDT configuration parameters. See details in 3GPP TS 28.622 clause 4.3.30." .

TS28623_TraceControlNrm:loggingInterval_Type a rdfs:Class ;
    rdfs:comment "See details in 3GPP TS 32.422 clause 5.10.8." .

TS28623_TraceControlNrm:mdtConfig_Type a rdfs:Class ;
    rdfs:comment "MDT config parameters. See details in 3GPP TS 28.622 clause 4.3.30." .

TS28623_TraceControlNrm:plmnList_Type a rdfs:Class ;
    rdfs:comment "See details in 3GPP TS 32.422 clause 5.10.24." .

TS28623_TraceControlNrm:plmnTarget_Type a rdfs:Class ;
    rdfs:comment "The PLMN for which sessions shall be selected in the Trace Session in case of management based activation when several PLMNs are supported in the RAN (this means that shared cells and not shared cells are allowed for the specified PLMN. Note that the PLMN Target might differ from the PLMN specified in the Trace Reference, as that specifies the PLMN that is containing the management system requesting the Trace Session from the NE. See 3GPP TS 32.422 clause 5.9b for additional details." .

TS28623_TraceControlNrm:reportInterval_Type a rdfs:Class ;
    rdfs:comment "See details in 3GPP TS 32.422 clause 5.10.5." .

TS28623_TraceControlNrm:reportingTrigger_Type a rdfs:Class ;
    rdfs:comment "See details in 3GPP TS 32.422 clause 5.10.4." .

TS28623_TraceControlNrm:resources_traceControlNrm a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" .

TS28623_TraceControlNrm:sensorInformation_Type a rdfs:Class ;
    rdfs:comment "See details in 3GPP TS 32.422 clause 5.10.29." .

TS28623_TraceControlNrm:traceConfig_Type a rdfs:Class ;
    rdfs:comment "Trace configuration parameters for NR. See details in 3GPP TS 28.622 clause 4.3.30." .

TS28623_TraceControlNrm:traceReference_Type a rdfs:Class ;
    rdfs:comment "The Trace Reference parameter shall be globally unique, therefore the Trace Reference shall compose as follows - MCC+MNC+Trace ID, where the MCC and MNC are coming with the Trace activation request from the management system to identify one PLMN containing the management system, and Trace ID is a 3 byte Octet String. See 3GPP TS 32.422 clause 5.6 for additional details." .

TS28623_TraceControlNrm:traceTarget_Type a rdfs:Class ;
    rdfs:comment "Trace target conveying both the type and value of the target ID. For additional details see 3GPP TS 32.422" .

TS28623_TraceControlNrm:triggeringEvents_Type a rdfs:Class ;
    rdfs:comment "Specifies when to start a Trace Recording Session and which message shall be recorded first, when to stop a Trace Recording Session and which message shall be recorded last respectively. See 3GPP TS 32.422 clause 5.1 for additional details." .

