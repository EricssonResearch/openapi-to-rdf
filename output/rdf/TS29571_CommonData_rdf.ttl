    rdfs:range TS29571_CommonData:TacNid .

TS29571_CommonData:TacRm a rdfs:Datatype ;
    rdfs:comment """This data type is defined in the same way as the 'Tac' data type, but with the OpenAPI 'nullable: true' property.
""" .

