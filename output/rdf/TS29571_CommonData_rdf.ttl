TS29571_CommonData:TimeOfDay a rdfs:Datatype ;
    rdfs:comment """String with format partial-time or full-time as defined in clause 5.6 of IETF RFC 3339. Examples, 20:15:00, 20:15:00-08:00 (for 8 hours behind UTC). 
""" .

TS29571_CommonData:TimeZone a rdfs:Datatype ;
    rdfs:comment """String with format "time-numoffset" optionally appended by "daylightSavingTime", where 
- "time-numoffset" shall represent the time zone adjusted for daylight saving time and be
   encoded as time-numoffset as defined in clause 5.6 of IETF RFC 3339; 
- "daylightSavingTime" shall represent the adjustment that has been made and shall be
   encoded as "+1" or "+2" for a +1 or +2 hours adjustment. 

The example is for 8 hours behind UTC, +1 hour adjustment for Daylight Saving Time.
""" .

TS29571_CommonData:TimeZoneRm a rdfs:Datatype ;
    rdfs:comment """"String with format 'time-numoffset' optionally appended by '<daylightSavingTime>', where
  - 'time-numoffset' shall represent the time zone adjusted for daylight saving time and be
    encoded as time-numoffset as defined in clause 5.6 of IETF RFC 3339;
  - 'daylightSavingTime' shall represent the adjustment that has been made and shall be
    encoded as '+1' or '+2' for a +1 or +2 hours adjustment.

  But with the OpenAPI 'nullable: true' property."
""" .

TS29571_CommonData:TlsId a rdfs:Datatype ;
    rdfs:comment "The TLS ID for the media stream." .

