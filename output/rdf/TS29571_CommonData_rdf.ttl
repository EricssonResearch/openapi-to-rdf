    rdfs:comment """This IE may be present if the praId IE is present and if it contains a PRA identifier referring to a set of Core Network predefined Presence Reporting Areas. When present, this IE shall contain a PRA Identifier of an individual PRA within the Set of Core Network predefined Presence Reporting Areas indicated by the praId IE. 
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfo ;
    rdfs:range xsd:string .

TS29571_CommonData_PresenceInfo:ecgiList a rdf:Property ;
    rdfs:comment """Represents the list of EUTRAN cell Ids that constitutes the area. This IE shall be present if the Area of Interest subscribed is a list of EUTRAN cell Ids. 
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfo ;
    rdfs:range TS29571_CommonData:Ecgi .

TS29571_CommonData_PresenceInfo:globalRanNodeIdList a rdf:Property ;
    rdfs:comment """Represents the list of NG RAN node identifiers that constitutes the area. This IE shall be present if the Area of Interest subscribed is a list of NG RAN node identifiers. 
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfo ;
    rdfs:range xsd:string .

TS29571_CommonData_PresenceInfo:globaleNbIdList a rdf:Property ;
    rdfs:comment """Represents the list of eNodeB identifiers that constitutes the area. This IE shall be  present if the Area of Interest subscribed is a list of eNodeB identifiers.
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfo ;
    rdfs:range xsd:string .

TS29571_CommonData_PresenceInfo:ncgiList a rdf:Property ;
    rdfs:comment """Represents the list of NR cell Ids that constitutes the area. This IE shall be present if the Area of Interest subscribed is a list of NR cell Ids. 
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfo ;
    rdfs:range TS29571_CommonData:Ncgi .

TS29571_CommonData_PresenceInfo:praId a rdf:Property ;
    rdfs:comment """Represents an identifier of the Presence Reporting Area (see clause 28.10 of 3GPP  TS 23.003.  This IE shall be present  if the Area of Interest subscribed or reported is a Presence Reporting Area or a Set of Core Network predefined Presence Reporting Areas. When present, it shall be encoded as a string representing an integer in the following ranges: 0 to 8 388 607 for UE-dedicated PRA 8 388 608 to 16 777 215 for Core Network predefined PRA Examples: PRA ID 123 is encoded as "123" PRA ID 11 238 660 is encoded as "11238660"
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfo ;
    rdfs:range xsd:string .

TS29571_CommonData_PresenceInfo:presenceState a rdf:Property ;
    rdfs:domain TS29571_CommonData:PresenceInfo ;
    rdfs:range xsd:string .

TS29571_CommonData_PresenceInfo:trackingAreaList a rdf:Property ;
    rdfs:comment """Represents the list of tracking areas that constitutes the area. This IE shall be present if the subscription or  the event report is for tracking UE presence in the tracking areas. For non 3GPP access the TAI shall be the N3GPP TAI. 
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfo ;
    rdfs:range TS29571_CommonData:Tai .

TS29571_CommonData_PresenceInfoRm:additionalPraId a rdf:Property ;
    rdfs:comment """This IE may be present if the praId IE is present and if it contains a PRA identifier referring to a set of Core Network predefined Presence Reporting Areas. When present, this IE shall contain a PRA Identifier of an individual PRA within the Set of Core Network predefined Presence Reporting Areas indicated by the praId IE.
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfoRm ;
    rdfs:range xsd:string .

TS29571_CommonData_PresenceInfoRm:ecgiList a rdf:Property ;
    rdfs:comment """Represents the list of EUTRAN cell Ids that constitutes the area. This IE shall be present if the Area of Interest subscribed is a list of EUTRAN cell Ids.
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfoRm ;
    rdfs:range TS29571_CommonData:Ecgi .

TS29571_CommonData_PresenceInfoRm:globalRanNodeIdList a rdf:Property ;
    rdfs:comment """Represents the list of NG RAN node identifiers that constitutes the area. This IE shall be present if the Area of Interest subscribed is a list of NG RAN node identifiers.
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfoRm ;
    rdfs:range xsd:string .

TS29571_CommonData_PresenceInfoRm:globaleNbIdList a rdf:Property ;
    rdfs:comment """Represents the list of eNodeB identifiers that constitutes the area. This IE shall be present if the Area of Interest subscribed is a list of eNodeB identifiers.
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfoRm ;
    rdfs:range xsd:string .

TS29571_CommonData_PresenceInfoRm:ncgiList a rdf:Property ;
    rdfs:comment """Represents the list of NR cell Ids that constitutes the area. This IE shall be present if the Area of Interest subscribed is a list of NR cell Ids.
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfoRm ;
    rdfs:range TS29571_CommonData:Ncgi .

TS29571_CommonData_PresenceInfoRm:praId a rdf:Property ;
    rdfs:comment """Represents an identifier of the Presence Reporting Area (see clause 28.10 of 
3GPP TS 23.003. This IE shall be present  if the Area of Interest subscribed or
reported is a Presence Reporting Area or a Set of Core Network predefined Presence
Reporting Areas. When present, it shall be encoded as a string representing an integer
in the following ranges:
- 0 to 8 388 607 for UE-dedicated PRA
- 8 388 608 to 16 777 215 for Core Network predefined PRA
Examples:
PRA ID 123 is encoded as "123"
PRA ID 11 238 660 is encoded as "11238660"
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfoRm ;
    rdfs:range xsd:string .

TS29571_CommonData_PresenceInfoRm:presenceState a rdf:Property ;
    rdfs:domain TS29571_CommonData:PresenceInfoRm ;
    rdfs:range xsd:string .

TS29571_CommonData_PresenceInfoRm:trackingAreaList a rdf:Property ;
    rdfs:comment """Represents the list of tracking areas that constitutes the area. This IE shall be present if the subscription or the event report  is for tracking UE presence in the tracking areas. For non 3GPP access the TAI shall be the N3GPP TAI.
""" ;
    rdfs:domain TS29571_CommonData:PresenceInfoRm ;
    rdfs:range TS29571_CommonData:Tai .

