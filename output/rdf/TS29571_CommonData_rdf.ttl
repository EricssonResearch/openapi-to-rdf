    rdfs:comment "String representing the Wildcard DNN. It shall contain the string \"*\"." .

TS29571_CommonData:WildcardDnnRm a rdfs:Datatype ;
    rdfs:comment """String representing the Wildcard DNN. It shall contain the string '*' but with the  OpenAPI 'nullable: true' property.
""" .

