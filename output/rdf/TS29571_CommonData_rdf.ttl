""" ;
    rdfs:domain TS29571_CommonData:IdentificationProperties .

TS29571_CommonData_IdentificationProperties:nProp a rdf:Property ;
    rdfs:comment """Represent the "n" property which provides the components of the name of the object the jCard represents as defined as defined in IETF RFC 6350, section 6.2.2.
""" ;
    rdfs:domain TS29571_CommonData:IdentificationProperties ;
    rdfs:range xsd:string .

TS29571_CommonData_IdentificationProperties:nickNames a rdf:Property ;
    rdfs:comment """Represent the "nickname" property which provides the text corresponding to the nickname of the object the jCard represents as defined in IETF RFC 6350, section 6.2.3.
""" ;
    rdfs:domain TS29571_CommonData:IdentificationProperties .

TS29571_CommonData_IdentificationProperties:photos a rdf:Property ;
    rdfs:comment """Represent the "photo" property which provides image or photograph information that annotates some aspect of the object the jCard represents as defined in IETF RFC 6350, section 6.2.4.
""" ;
