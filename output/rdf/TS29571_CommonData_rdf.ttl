    rdfs:domain TS29571_CommonData:SmallDataRateStatus ;
    rdfs:range xsd:integer .

TS29571_CommonData_SmallDataRateStatus:validityTime a rdf:Property ;
    rdfs:domain TS29571_CommonData:SmallDataRateStatus ;
