    rdfs:range xsd:dateTime .

TS28318_DsoNrm:isAffectedAreaPriority a rdf:Property ;
    rdfs:range xsd:boolean .

TS28318_DsoNrm:mnoInterventionDuration a rdf:Property ;
    rdfs:range xsd:integer .

TS28318_DsoNrm:mnoInterventionTime a rdf:Property ;
