TS28318_DsoNrm:SubNetwork-ncO-DsoNrm a rdfs:Class .

TS28318_DsoNrm_DsoThresholdMonitor-Single:targetThresholdLocation a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:DsoThresholdMonitor-Single ;
    rdfs:range xsd:string .

