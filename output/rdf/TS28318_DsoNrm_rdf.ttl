TS28318_DsoNrm_OutageAndRecoveryInfo-Single:dsoRapidInterventionDuration a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo-Single ;
    rdfs:range xsd:integer .

TS28318_DsoNrm_OutageAndRecoveryInfo-Single:dsoRapidInterventionTime a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo-Single ;
    rdfs:range xsd:dateTime .

TS28318_DsoNrm_OutageAndRecoveryInfo-Single:expectedOutageEndTime a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo-Single ;
    rdfs:range xsd:dateTime .

TS28318_DsoNrm_OutageAndRecoveryInfo-Single:isAffectedAreaPriority a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo-Single ;
    rdfs:range xsd:boolean .

TS28318_DsoNrm_OutageAndRecoveryInfo-Single:mnoInterventionDuration a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo-Single ;
    rdfs:range xsd:integer .

TS28318_DsoNrm_OutageAndRecoveryInfo-Single:mnoInterventionTime a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo-Single ;
    rdfs:range xsd:dateTime .

TS28318_DsoNrm_OutageAndRecoveryInfo-Single:mnoMaxServiceDuration a rdf:Property ;
