TS28318_DsoNrm:DsoThresholdMonitor-Multiple a rdfs:Class .

TS28318_DsoNrm:DsoThresholdMonitor-Single a rdfs:Class ;
    rdfs:subClassOf TS28623_ThresholdMonitorNrm:ThresholdMonitor-Single .

TS28318_DsoNrm:EnergyServiceLocation a rdfs:Class .

TS28318_DsoNrm:OutageAndRecoveryInfo-Multiple a rdfs:Class .

TS28318_DsoNrm:OutageAndRecoveryInfo-Single a rdfs:Class ;
