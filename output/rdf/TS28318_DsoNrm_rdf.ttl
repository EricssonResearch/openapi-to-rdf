    rdfs:range TS28318_DsoNrm:DsoThresholdMonitor_Multiple .

TS28318_DsoNrm_SubNetwork_ncO_DsoNrm:OutageAndRecoveryInfo a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:SubNetwork_ncO_DsoNrm ;
