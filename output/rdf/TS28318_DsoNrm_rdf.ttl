@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28318_DsoNrm:DsoThresholdMonitor_Multiple a rdfs:Class .

TS28318_DsoNrm:DsoThresholdMonitor_Single a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI allOf - complex logical constraints partially supported in SHACL" .

TS28318_DsoNrm:EnergyServiceLocation a rdfs:Class .

TS28318_DsoNrm:OutageAndRecoveryInfo_Multiple a rdfs:Class .

TS28318_DsoNrm:OutageAndRecoveryInfo_Single a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI allOf - complex logical constraints partially supported in SHACL" .

TS28318_DsoNrm:SubNetwork_ncO_DsoNrm a rdfs:Class .

TS28318_DsoNrm:resources_DSORecovery a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" .

TS28318_DsoNrm_DsoThresholdMonitor_Single:targetThresholdLocation a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:DsoThresholdMonitor_Single ;
    rdfs:range TS28623_ComDefs:AreaOfInterest .

TS28318_DsoNrm_EnergyServiceLocation:CGI a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:EnergyServiceLocation ;
    rdfs:range xsd:string .

TS28318_DsoNrm_EnergyServiceLocation:energySupplyId a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:EnergyServiceLocation ;
    rdfs:range xsd:string .

