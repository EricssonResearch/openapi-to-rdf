    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo_Single ;
    rdfs:range xsd:dateTime .

TS28318_DsoNrm_OutageAndRecoveryInfo_Single:affectedArea a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo_Single ;
    rdfs:range TS28318_DsoNrm:EnergyServiceLocation .

TS28318_DsoNrm_OutageAndRecoveryInfo_Single:dsoRapidInterventionDuration a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo_Single ;
    rdfs:range xsd:integer .

TS28318_DsoNrm_OutageAndRecoveryInfo_Single:dsoRapidInterventionTime a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo_Single ;
    rdfs:range xsd:dateTime .

TS28318_DsoNrm_OutageAndRecoveryInfo_Single:expectedOutageEndTime a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo_Single ;
    rdfs:range xsd:dateTime .

TS28318_DsoNrm_OutageAndRecoveryInfo_Single:isAffectedAreaPriority a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo_Single ;
    rdfs:range xsd:boolean .

TS28318_DsoNrm_OutageAndRecoveryInfo_Single:mnoInterventionDuration a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo_Single ;
    rdfs:range xsd:integer .

TS28318_DsoNrm_OutageAndRecoveryInfo_Single:mnoInterventionTime a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo_Single ;
    rdfs:range xsd:dateTime .

TS28318_DsoNrm_OutageAndRecoveryInfo_Single:mnoMaxServiceDuration a rdf:Property ;
    rdfs:domain TS28318_DsoNrm:OutageAndRecoveryInfo_Single ;
    rdfs:range xsd:integer .

TS28318_DsoNrm_OutageAndRecoveryInfo_Single:outageStartTime a rdf:Property ;
