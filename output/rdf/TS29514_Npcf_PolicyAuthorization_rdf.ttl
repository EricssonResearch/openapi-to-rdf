TS29514_Npcf_PolicyAuthorization:AcceptableServiceInfo a rdfs:Class ;
    rdfs:comment "Indicates the maximum bandwidth that shall be authorized by the PCF." .

TS29514_Npcf_PolicyAuthorization:AccessNetChargingIdentifier a rdfs:Class ;
    rdfs:comment "Describes the access network charging identifier." .

TS29514_Npcf_PolicyAuthorization:AfEvent a rdfs:Class ;
