@prefix TS28532_PerfMnS: <http://ericsson.com/models/3gpp/TS28532/PerfMnS#> .
@prefix TS28532_PerfMnS_NotifyThresholdCrossing: <http://ericsson.com/models/3gpp/TS28532/PerfMnS/NotifyThresholdCrossing#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28532_PerfMnS:NotifyThresholdCrossing a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI allOf - complex logical constraints partially supported in SHACL" .

TS28532_PerfMnS:PerfMetricValue a rdfs:Class ;
    rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" .

TS28532_PerfMnS:PerfMetricDirection a rdfs:Datatype .

TS28532_PerfMnS:PerfNotificationTypes a rdfs:Datatype .

TS28532_PerfMnS_NotifyThresholdCrossing:additionalText a rdf:Property ;
    rdfs:domain TS28532_PerfMnS:NotifyThresholdCrossing ;
    rdfs:range xsd:string .

TS28532_PerfMnS_NotifyThresholdCrossing:hysteresis a rdf:Property ;
    rdfs:domain TS28532_PerfMnS:NotifyThresholdCrossing ;
    rdfs:range TS28532_PerfMnS:PerfMetricValue .

TS28532_PerfMnS_NotifyThresholdCrossing:monitorGranularityPeriod a rdf:Property ;
    rdfs:domain TS28532_PerfMnS:NotifyThresholdCrossing ;
    rdfs:range xsd:integer .

TS28532_PerfMnS_NotifyThresholdCrossing:observedPerfMetricDirection a rdf:Property ;
    rdfs:domain TS28532_PerfMnS:NotifyThresholdCrossing ;
    rdfs:range xsd:string .

TS28532_PerfMnS_NotifyThresholdCrossing:observedPerfMetricName a rdf:Property ;
    rdfs:domain TS28532_PerfMnS:NotifyThresholdCrossing ;
    rdfs:range xsd:string .

TS28532_PerfMnS_NotifyThresholdCrossing:observedPerfMetricValue a rdf:Property ;
    rdfs:domain TS28532_PerfMnS:NotifyThresholdCrossing ;
    rdfs:range TS28532_PerfMnS:PerfMetricValue .

TS28532_PerfMnS_NotifyThresholdCrossing:thresholdValue a rdf:Property ;
    rdfs:domain TS28532_PerfMnS:NotifyThresholdCrossing ;
    rdfs:range TS28532_PerfMnS:PerfMetricValue .

