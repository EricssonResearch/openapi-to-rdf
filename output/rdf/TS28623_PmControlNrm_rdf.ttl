@prefix TS28623_FileManagementNrm: <https://example.org/TS28623_FileManagementNrm/> .
@prefix TS28623_GenericNrm: <https://example.org/TS28623_GenericNrm/> .
@prefix TS28623_PmControlNrm: <https://example.org/TS28623_PmControlNrm/> .
@prefix TS28623_PmControlNrm_ManagedElement-PmControlNrm: <https://example.org/TS28623_PmControlNrm/ManagedElement-PmControlNrm/> .
@prefix TS28623_PmControlNrm_PerfMetricJob-Single: <https://example.org/TS28623_PmControlNrm/PerfMetricJob-Single/> .
@prefix TS28623_PmControlNrm_SubNetwork-ncO-PmControlNrm: <https://example.org/TS28623_PmControlNrm/SubNetwork-ncO-PmControlNrm/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28623_PmControlNrm:ManagedElement-PmControlNrm a rdfs:Class .

TS28623_PmControlNrm:PerfMetricJob-Multiple a rdfs:Class .

TS28623_PmControlNrm:PerfMetricJob-Single a rdfs:Class ;
    rdfs:subClassOf TS28623_GenericNrm:Top .

TS28623_PmControlNrm:SubNetwork-ncO-PmControlNrm a rdfs:Class .

TS28623_PmControlNrm:Files a rdf:Property ;
    rdfs:range TS28623_FileManagementNrm:Files-Multiple .

TS28623_PmControlNrm_ManagedElement-PmControlNrm:PerfMetricJob a rdf:Property ;
    rdfs:domain TS28623_PmControlNrm:ManagedElement-PmControlNrm ;
    rdfs:range TS28623_PmControlNrm:PerfMetricJob-Multiple .

TS28623_PmControlNrm_PerfMetricJob-Single:Files a rdf:Property ;
    rdfs:domain TS28623_PmControlNrm:PerfMetricJob-Single ;
    rdfs:range TS28623_FileManagementNrm:Files-Multiple .

TS28623_PmControlNrm_PerfMetricJob-Single:attributes a rdf:Property ;
    rdfs:domain TS28623_PmControlNrm:PerfMetricJob-Single ;
    rdfs:range rdfs:Resource .

TS28623_PmControlNrm_SubNetwork-ncO-PmControlNrm:PerfMetricJob a rdf:Property ;
    rdfs:domain TS28623_PmControlNrm:SubNetwork-ncO-PmControlNrm ;
    rdfs:range TS28623_PmControlNrm:PerfMetricJob-Multiple .

TS28623_PmControlNrm:administrativeState a rdf:Property ;
    rdfs:range xsd:string .

TS28623_PmControlNrm:attributes a rdf:Property ;
    rdfs:range rdfs:Resource .

TS28623_PmControlNrm:conditionMonitorRef a rdf:Property ;
    rdfs:range xsd:string .

TS28623_PmControlNrm:granularityPeriod a rdf:Property ;
    rdfs:range xsd:integer .

TS28623_PmControlNrm:jobId a rdf:Property ;
    rdfs:range xsd:string .

TS28623_PmControlNrm:objectInstances a rdf:Property ;
    rdfs:range xsd:string .

TS28623_PmControlNrm:operationalState a rdf:Property ;
    rdfs:range xsd:string .

TS28623_PmControlNrm:performanceMetrics a rdf:Property .

TS28623_PmControlNrm:reportingCtrl a rdf:Property ;
    rdfs:range xsd:string .

TS28623_PmControlNrm:rootObjectInstances a rdf:Property ;
    rdfs:range xsd:string .

TS28623_PmControlNrm:schedulerRef a rdf:Property ;
    rdfs:range xsd:string .

