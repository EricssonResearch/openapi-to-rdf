@prefix TS28532_HeartbeatNtf: <https://example.org/TS28532_HeartbeatNtf/> .
@prefix TS28532_HeartbeatNtf_NotifyHeartbeat: <https://example.org/TS28532_HeartbeatNtf/NotifyHeartbeat/> .
@prefix TS28623_ComDefs: <https://example.org/TS28623_ComDefs/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:class TS28623_ComDefs:NotificationHeader ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:path TS28532_HeartbeatNtf:heartbeatNtfPeriod ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS28532_HeartbeatNtf_NotifyHeartbeat:heartbeatNtfPeriod ] ;
    sh:targetClass TS28532_HeartbeatNtf:NotifyHeartbeat .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "notifyHeartbeat"^^xsd:string ) ;
    sh:targetClass TS28532_HeartbeatNtf:HeartbeatNotificationTypes .

