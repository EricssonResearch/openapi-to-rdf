@prefix TS28532_FileDataReportingMnS: <http://ericsson.com/models/3gpp/TS28532/FileDataReportingMnS#> .
@prefix TS28623_ComDefs: <http://ericsson.com/models/3gpp/TS28623/ComDefs#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:class TS28623_ComDefs:NotificationHeader ;
    sh:targetClass TS28532_FileDataReportingMnS:NotifyFilePreparationError .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "Performance"^^xsd:string "Trace"^^xsd:string "Analytics"^^xsd:string "Proprietary"^^xsd:string ) ;
    sh:targetClass TS28532_FileDataReportingMnS:FileDataType .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "notifyFileReady"^^xsd:string "notifyFilePreparationError"^^xsd:string ) ;
    sh:targetClass TS28532_FileDataReportingMnS:FileNotificationTypes .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS:reason ],
        [ a sh:PropertyShape ;
            sh:class TS28532_FileDataReportingMnS:FileInfo ;
            sh:path TS28532_FileDataReportingMnS:fileInfoList ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS:additionalText ] ;
    sh:targetClass TS28532_FileDataReportingMnS:NotifyFilePreparationError .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS:fileFormat ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS:fileReadyTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS:fileCompression ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS:fileSize ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS:fileLocation ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS:fileExpirationTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "Performance"^^xsd:string "Trace"^^xsd:string "Analytics"^^xsd:string "Proprietary"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS:fileDataType ] ;
    sh:targetClass TS28532_FileDataReportingMnS:FileInfo .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28532_FileDataReportingMnS:FileInfo ;
            sh:path TS28532_FileDataReportingMnS:fileInfoList ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS:additionalText ] ;
    sh:targetClass TS28532_FileDataReportingMnS:NotifyFileReady .

[] a sh:NodeShape ;
    sh:class TS28623_ComDefs:NotificationHeader ;
    sh:targetClass TS28532_FileDataReportingMnS:NotifyFileReady .

