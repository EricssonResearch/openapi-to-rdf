@prefix TS28532_FileDataReportingMnS: <https://example.org/TS28532_FileDataReportingMnS/> .
@prefix TS28532_FileDataReportingMnS_FileInfo: <https://example.org/TS28532_FileDataReportingMnS/FileInfo#> .
@prefix TS28532_FileDataReportingMnS_NotifyFilePreparationError: <https://example.org/TS28532_FileDataReportingMnS/NotifyFilePreparationError#> .
@prefix TS28532_FileDataReportingMnS_NotifyFileReady: <https://example.org/TS28532_FileDataReportingMnS/NotifyFileReady#> .
@prefix TS28623_ComDefs: <http://ericsson.com/models/3gpp/TS28623/ComDefs#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "Performance"^^xsd:string "Trace"^^xsd:string "Analytics"^^xsd:string "Proprietary"^^xsd:string ) ;
    sh:targetClass TS28532_FileDataReportingMnS:FileDataType .

[] a sh:NodeShape ;
    sh:class TS28623_ComDefs:NotificationHeader ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:class TS28532_FileDataReportingMnS:FileInfo ;
                    sh:path TS28532_FileDataReportingMnS:fileInfoList ],
                [ a sh:PropertyShape ;
                    sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:path TS28532_FileDataReportingMnS:additionalText ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28532_FileDataReportingMnS:FileInfo ;
            sh:path TS28532_FileDataReportingMnS_NotifyFileReady:fileInfoList ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS_NotifyFileReady:additionalText ] ;
    sh:targetClass TS28532_FileDataReportingMnS:NotifyFileReady .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS_FileInfo:fileFormat ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS_FileInfo:fileSize ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS_FileInfo:fileLocation ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "Performance"^^xsd:string "Trace"^^xsd:string "Analytics"^^xsd:string "Proprietary"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS_FileInfo:fileDataType ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS_FileInfo:fileExpirationTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS_FileInfo:fileReadyTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS_FileInfo:fileCompression ] ;
    sh:targetClass TS28532_FileDataReportingMnS:FileInfo .

[] a sh:NodeShape ;
    sh:class TS28623_ComDefs:NotificationHeader ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:path TS28532_FileDataReportingMnS:additionalText ],
                [ a sh:PropertyShape ;
                    sh:class TS28532_FileDataReportingMnS:FileInfo ;
                    sh:path TS28532_FileDataReportingMnS:fileInfoList ],
                [ a sh:PropertyShape ;
                    sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:path TS28532_FileDataReportingMnS:reason ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS_NotifyFilePreparationError:reason ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_FileDataReportingMnS_NotifyFilePreparationError:additionalText ],
        [ a sh:PropertyShape ;
            sh:class TS28532_FileDataReportingMnS:FileInfo ;
            sh:path TS28532_FileDataReportingMnS_NotifyFilePreparationError:fileInfoList ] ;
    sh:targetClass TS28532_FileDataReportingMnS:NotifyFilePreparationError .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "notifyFileReady"^^xsd:string "notifyFilePreparationError"^^xsd:string ) ;
    sh:targetClass TS28532_FileDataReportingMnS:FileNotificationTypes .

