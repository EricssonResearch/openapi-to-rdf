            sh:in ( "0ms"^^xsd:string "40ms"^^xsd:string "64ms"^^xsd:string "80ms"^^xsd:string "100ms"^^xsd:string "128ms"^^xsd:string "160ms"^^xsd:string "256ms"^^xsd:string "320ms"^^xsd:string "480ms"^^xsd:string "512ms"^^xsd:string "640ms"^^xsd:string "1024ms"^^xsd:string "1280ms"^^xsd:string "2560ms"^^xsd:string "5120ms"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_EventTriggerConfig:timeToTriggerRAN ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 127 ;
            sh:minInclusive 0 ;
            sh:path TS28623_ComDefs_EventTriggerConfig:thresholdRAN ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 30 ;
            sh:minInclusive 0 ;
            sh:path TS28623_ComDefs_EventTriggerConfig:hysteresisRAN ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "RSRP"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_EventTriggerConfig:measurementQuantityRAN ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "eventA1"^^xsd:string "eventA2"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_EventTriggerConfig:eventType ] ;
    sh:targetClass TS28623_ComDefs:EventTriggerConfig .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "LOCKED"^^xsd:string "UNLOCKED"^^xsd:string ) ;
    sh:targetClass TS28623_ComDefs:AdministrativeState .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_PlmnId:mnc ;
            sh:pattern "^[0-9]{2,3}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_PlmnId:mcc ;
            sh:pattern "^[0-9]{3}$" ] ;
    sh:targetClass TS28623_ComDefs:PlmnId .

