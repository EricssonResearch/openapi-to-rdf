@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "ENABLED"^^xsd:string "DISABLED"^^xsd:string ) ;
    sh:targetClass TS28623_ComDefs:OperationalState .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^[A-Fa-f0-9]{7}$" ;
    sh:targetClass TS28623_ComDefs:EutraCellId .

[] a sh:NodeShape ;
    sh:class TS28623_ComDefs:GeoCoordinate ;
    sh:targetClass TS28623_ComDefs:ConvexGeoPolygon .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:maxLength 253 ;
    sh:minLength 4 ;
    sh:pattern "^([0-9A-Za-z]([-0-9A-Za-z]{0,61}[0-9A-Za-z])?\\.)+[A-Za-z]{2,63}\\.?$" ;
    sh:targetClass TS28623_ComDefs:FqdnRo .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28623_ComDefs_NotificationHeader:eventTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28623_ComDefs_NotificationHeader:notificationId ],
        [ a sh:PropertyShape ;
            rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28623_ComDefs_NotificationHeader:notificationType ;
            sh:xone ( [ a sh:NodeShape ;
                        sh:datatype xsd:string ;
                        sh:in ( "notifyNewAlarm"^^xsd:string "notifyChangedAlarm"^^xsd:string "notifyChangedAlarmGeneral"^^xsd:string "notifyAckStateChanged"^^xsd:string "notifyCorrelatedNotificationChanged"^^xsd:string "notifyComments"^^xsd:string "notifyClearedAlarm"^^xsd:string "notifyAlarmListRebuilt"^^xsd:string "notifyPotentialFaultyAlarmList"^^xsd:string ) ] [ a sh:NodeShape ;
                        sh:datatype xsd:string ;
                        sh:in ( "notifyMOICreation"^^xsd:string "notifyMOIDeletion"^^xsd:string "notifyMOIAttributeValueChanges"^^xsd:string "notifyEvent"^^xsd:string "notifyMOIChanges"^^xsd:string ) ] [ a sh:NodeShape ;
                        sh:datatype xsd:string ;
                        sh:in ( "notifyThresholdCrossing"^^xsd:string ) ] [ a sh:NodeShape ;
                        sh:datatype xsd:string ;
                        sh:in ( "notifyHeartbeat"^^xsd:string ) ] [ a sh:NodeShape ;
                        sh:datatype xsd:string ;
                        sh:in ( "notifyFileReady"^^xsd:string "notifyFilePreparationError"^^xsd:string ) ] ) ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28623_ComDefs_NotificationHeader:systemDN ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28623_ComDefs_NotificationHeader:href ] ;
    sh:targetClass TS28623_ComDefs:NotificationHeader .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_ErrorResponsePatch:title ],
        [ a sh:PropertyShape ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_ComDefs:reason ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_ComDefs:status ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path TS28623_ComDefs:type ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path TS28623_ComDefs:badOp ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_ComDefs:title ] ] ;
            sh:path TS28623_ComDefs_ErrorResponsePatch:otherProblems ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_ErrorResponsePatch:status ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_ErrorResponsePatch:badOP ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_ErrorResponsePatch:reason ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28623_ComDefs_ErrorResponsePatch:type ] ;
    sh:targetClass TS28623_ComDefs:ErrorResponsePatch .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS28623_ComDefs:Ipv6PrefixRo .

