[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9]{2,3}$" ;
    sh:targetClass TS28623_ComDefs:MncRo .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28623_ComDefs:GeoCoordinate ;
            sh:path TS28623_ComDefs_GeoArea:convexGeoPolygon ] ;
    sh:targetClass TS28623_ComDefs:GeoArea .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" ;
    sh:targetClass TS28623_ComDefs:Ipv4Addr .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:targetClass TS28623_ComDefs:NotificationId .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "IN_TEST"^^xsd:string "FAILED"^^xsd:string "POWER_OFF"^^xsd:string "OFF_LINE"^^xsd:string "OFF_DUTY"^^xsd:string "DEPENDENCY"^^xsd:string "DEGRADED"^^xsd:string "NOT_INSTALLED"^^xsd:string "LOG_FULL"^^xsd:string ) ;
    sh:targetClass TS28623_ComDefs:AvailabilityStatus .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
