                            sh:path TS28623_ComDefs:title ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path TS28623_ComDefs:type ] ] ;
            sh:path TS28623_ComDefs_ErrorResponseGet:otherProblems ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:path TS28623_ComDefs_ErrorResponseGet:badQueryParams ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_ErrorResponseGet:title ] ;
    sh:targetClass TS28623_ComDefs:ErrorResponseGet .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS28623_ComDefs:DnListRo .

[] a sh:NodeShape ;
    sh:targetClass TS28623_ComDefs:IpAddrRo ;
    sh:xone ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:pattern "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS28623_ComDefs:Ipv6Addr .

[] a sh:NodeShape ;
    sh:targetClass TS28623_ComDefs:Host ;
    sh:xone ( [ a sh:NodeShape ;
                sh:datatype xsd:string ] [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:maxLength 253 ;
                sh:minLength 4 ;
                sh:pattern "^([0-9A-Za-z]([-0-9A-Za-z]{0,61}[0-9A-Za-z])?\\.)+[A-Za-z]{2,63}\\.?$" ] ) .

[] a sh:NodeShape ;
    sh:targetClass TS28623_ComDefs:AttributeNameValuePairSet .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS28623_ComDefs:Ipv6Prefix .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28623_ComDefs:GeoCoordinate ;
            sh:minCount 3 ;
            sh:path TS28623_ComDefs_GeoArea:convexGeoPolygon ] ;
    sh:targetClass TS28623_ComDefs:GeoArea .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^[A-Fa-f0-9]{7}$" ;
    sh:targetClass TS28623_ComDefs:EutraCellId .

[] a sh:NodeShape ;
    sh:datatype xsd:dateTime ;
    sh:targetClass TS28623_ComDefs:DateTimeRo .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS28623_ComDefs:DnList .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_ComDefs:errorInfo ] ] ;
            sh:path TS28623_ComDefs_ErrorResponse:error ] ;
    sh:targetClass TS28623_ComDefs:ErrorResponse .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS28623_ComDefs:DnRo .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "LOCKED"^^xsd:string "UNLOCKED"^^xsd:string ) ;
    sh:targetClass TS28623_ComDefs:BasicAdministrativeState .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS28623_ComDefs:Filter .

[] a sh:NodeShape ;
