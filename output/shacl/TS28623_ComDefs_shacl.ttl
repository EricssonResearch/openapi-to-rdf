[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:maxLength 253 ;
    sh:minLength 4 ;
    sh:pattern "^([0-9A-Za-z]([-0-9A-Za-z]{0,61}[0-9A-Za-z])?\\.)+[A-Za-z]{2,63}\\.?$" ;
    sh:targetClass TS28623_ComDefs:Fqdn .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" ;
    sh:targetClass TS28623_ComDefs:Ipv4AddrRo .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28623_ComDefs_ErrorResponseDefault:type ],
        [ a sh:PropertyShape ;
