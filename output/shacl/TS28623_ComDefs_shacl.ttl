            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_ErrorResponseGet:status ],
        [ a sh:PropertyShape ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_ComDefs:title ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:path TS28623_ComDefs:badQueryParams ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
