    sh:pattern "^[0-9]{2,3}$" ;
    sh:targetClass TS28623_ComDefs:Mnc .

[] a sh:NodeShape ;
    sh:datatype xsd:dateTime ;
    sh:targetClass TS28623_ComDefs:DateTime .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_PlmnIdRo:mcc ;
            sh:pattern "^[0-9]{3}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_PlmnIdRo:mnc ;
            sh:pattern "^[0-9]{2,3}$" ] ;
    sh:targetClass TS28623_ComDefs:PlmnIdRo .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "IDLE"^^xsd:string "ACTIVE"^^xsd:string "BUSY"^^xsd:string ) ;
    sh:targetClass TS28623_ComDefs:UsageState .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS28623_ComDefs:UriRo .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS28623_ComDefs:Ipv6Prefix .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_PlmnId:mcc ;
            sh:pattern "^[0-9]{3}$" ],
        [ a sh:PropertyShape ;
