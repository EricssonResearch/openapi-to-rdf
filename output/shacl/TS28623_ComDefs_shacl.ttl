    sh:pattern "^[0-9]{3}$" ;
    sh:targetClass TS28623_ComDefs:MccRo .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:path TS28623_ComDefs_GeoCoordinate:altitude ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:maxInclusive 180 ;
            sh:minInclusive -180 ;
            sh:path TS28623_ComDefs_GeoCoordinate:longitude ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:maxInclusive 90 ;
            sh:minInclusive -90 ;
            sh:path TS28623_ComDefs_GeoCoordinate:latitude ] ;
    sh:targetClass TS28623_ComDefs:GeoCoordinate .

[] a sh:NodeShape ;
    sh:datatype xsd:float ;
    sh:targetClass TS28623_ComDefs:Float .

