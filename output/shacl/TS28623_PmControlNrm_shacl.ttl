                            sh:maxCount 1 ;
                            sh:minInclusive 1 ;
                            sh:path TS28623_PmControlNrm:granularityPeriod ] ] ;
            sh:path TS28623_PmControlNrm_PerfMetricJob-Single:attributes ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:path TS28623_PmControlNrm_PerfMetricJob-Single:Files ] ;
