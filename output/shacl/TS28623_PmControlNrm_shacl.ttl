                                    sh:path TS28623_PmControlNrm:schedulerRef ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:integer ;
                                    sh:maxCount 1 ;
                                    sh:minInclusive 1 ;
                                    sh:path TS28623_PmControlNrm:granularityPeriod ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_PmControlNrm:jobId ],
                                [ a sh:PropertyShape ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_PmControlNrm:reportingCtrl ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:path TS28623_PmControlNrm:performanceMetrics ],
                                [ a sh:PropertyShape ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_PmControlNrm:objectInstances ],
                                [ a sh:PropertyShape ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_PmControlNrm:operationalState ],
                                [ a sh:PropertyShape ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_PmControlNrm:conditionMonitorRef ] ] ;
                    sh:path TS28623_PmControlNrm:attributes ],
                [ a sh:PropertyShape ;
                    sh:maxCount 1 ;
                    sh:path TS28623_PmControlNrm:Files ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:maxCount 1 ;
                            sh:path TS28623_PmControlNrm:schedulerRef ],
                        [ a sh:PropertyShape ;
                            sh:maxCount 1 ;
                            sh:path TS28623_PmControlNrm:reportingCtrl ],
                        [ a sh:PropertyShape ;
                            sh:maxCount 1 ;
                            sh:path TS28623_PmControlNrm:conditionMonitorRef ],
                        [ a sh:PropertyShape ;
                            sh:maxCount 1 ;
                            sh:path TS28623_PmControlNrm:administrativeState ],
                        [ a sh:PropertyShape ;
                            sh:maxCount 1 ;
                            sh:path TS28623_PmControlNrm:rootObjectInstances ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_PmControlNrm:jobId ],
                        [ a sh:PropertyShape ;
                            sh:maxCount 1 ;
                            sh:path TS28623_PmControlNrm:objectInstances ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:path TS28623_PmControlNrm:performanceMetrics ],
                        [ a sh:PropertyShape ;
                            sh:maxCount 1 ;
                            sh:path TS28623_PmControlNrm:operationalState ],
                        [ a sh:PropertyShape ;
