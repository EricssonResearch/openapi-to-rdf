[] a sh:NodeShape ;
    sh:class TS28623_PmControlNrm:PerfMetricJob-Single ;
    sh:targetClass TS28623_PmControlNrm:PerfMetricJob-Multiple .

[] a sh:NodeShape ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:maxCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ a sh:PropertyShape ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_PmControlNrm:rootObjectInstances ],
                                [ a sh:PropertyShape ;
