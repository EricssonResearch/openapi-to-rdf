@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28623_PmControlNrm:PerfMetricJob-Single ;
            sh:path TS28623_PmControlNrm_ManagedElement-PmControlNrm:PerfMetricJob ] ;
    sh:targetClass TS28623_PmControlNrm:ManagedElement-PmControlNrm .

[] a sh:NodeShape ;
