@prefix TS28319_MsacNrm: <https://example.org/TS28319_MsacNrm/> .
@prefix TS28319_MsacNrm_AccessRule-Single: <https://example.org/TS28319_MsacNrm/AccessRule-Single#> .
@prefix TS28319_MsacNrm_Identity-Single: <https://example.org/TS28319_MsacNrm/Identity-Single#> .
@prefix TS28319_MsacNrm_Role-Single: <https://example.org/TS28319_MsacNrm/Role-Single#> .
@prefix TS28623_GenericNrm: <http://ericsson.com/models/3gpp/TS28623/GenericNrm#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:maxCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28319_MsacNrm:roleName ],
                                [ a sh:PropertyShape ;
                                    rdfs:comment "This datatype is used for writable attribute" ;
                                    sh:maxCount 1 ;
                                    sh:path TS28319_MsacNrm:accessRulesList ] ] ;
                    sh:path TS28319_MsacNrm:attributes ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28319_MsacNrm:roleName ],
                        [ a sh:PropertyShape ;
                            rdfs:comment "This datatype is used for writable attribute" ;
                            sh:maxCount 1 ;
                            sh:path TS28319_MsacNrm:accessRulesList ] ] ;
            sh:path TS28319_MsacNrm_Role-Single:attributes ] ;
    sh:targetClass TS28319_MsacNrm:Role-Single .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:maxCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:path TS28319_MsacNrm:operations ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:path TS28319_MsacNrm:componentCData ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28319_MsacNrm:ruleName ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28319_MsacNrm:resources ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:in ( "ALLOW"^^xsd:string "DENY"^^xsd:string ) ;
                                    sh:maxCount 1 ;
                                    sh:path TS28319_MsacNrm:actions ] ] ;
                    sh:path TS28319_MsacNrm:attributes ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:path TS28319_MsacNrm:operations ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:in ( "ALLOW"^^xsd:string "DENY"^^xsd:string ) ;
                            sh:maxCount 1 ;
                            sh:path TS28319_MsacNrm:actions ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:path TS28319_MsacNrm:componentCData ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28319_MsacNrm:resources ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28319_MsacNrm:ruleName ] ] ;
            sh:path TS28319_MsacNrm_AccessRule-Single:attributes ] ;
    sh:targetClass TS28319_MsacNrm:AccessRule-Single .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:maxCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28319_MsacNrm:identityName ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28319_MsacNrm:credential ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:in ( "USERNAME"^^xsd:string "EMAIL_ADDRESS"^^xsd:string "PHONE_NUMBER"^^xsd:string "IP_ADDRESS"^^xsd:string "MACHINEUSER"^^xsd:string ) ;
                                    sh:maxCount 1 ;
                                    sh:path TS28319_MsacNrm:identityType ],
                                [ a sh:PropertyShape ;
                                    rdfs:comment "This datatype is used for writable attribute" ;
                                    sh:maxCount 1 ;
                                    sh:path TS28319_MsacNrm:roleRefList ] ] ;
                    sh:path TS28319_MsacNrm:attributes ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            rdfs:comment "This datatype is used for writable attribute" ;
                            sh:maxCount 1 ;
                            sh:path TS28319_MsacNrm:roleRefList ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28319_MsacNrm:credential ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28319_MsacNrm:identityName ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:in ( "USERNAME"^^xsd:string "EMAIL_ADDRESS"^^xsd:string "PHONE_NUMBER"^^xsd:string "IP_ADDRESS"^^xsd:string "MACHINEUSER"^^xsd:string ) ;
                            sh:maxCount 1 ;
                            sh:path TS28319_MsacNrm:identityType ] ] ;
            sh:path TS28319_MsacNrm_Identity-Single:attributes ] ;
    sh:targetClass TS28319_MsacNrm:Identity-Single .

