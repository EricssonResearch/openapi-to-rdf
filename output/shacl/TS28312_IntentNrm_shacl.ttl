[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "INTENT_CONFLICT"^^xsd:string "EXPECTATION_CONFLICT"^^xsd:string "TARGET_CONFLICT"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentConflictReport:conflictType ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentConflictReport:conflictId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "MODIFY"^^xsd:string "DELETE"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentConflictReport:recommendedSolutions ],
        [ a sh:PropertyShape ;
            rdfs:comment "This will be present if the value of conflictType is TARGET_CONFLICT. It describes the targetName of the conflicting ExpectationTarget with an IntentExpectation           " ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentConflictReport:conflictingTarget ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentConflictReport:conflictingIntent ],
        [ a sh:PropertyShape ;
            rdfs:comment "This will be present if the value of conflictType is EXPECTATION_CONFLICT. It describes the expectationId of the conflicting IntentExpectation with an Intent       " ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentConflictReport:conflictingExpectation ] ;
    sh:targetClass TS28312_IntentNrm:IntentConflictReport .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "ALL_OF"^^xsd:string "ONE_OF"^^xsd:string "ANY_OF"^^xsd:string ) ;
