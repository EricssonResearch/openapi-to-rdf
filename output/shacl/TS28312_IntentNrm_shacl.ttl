            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_ExpectationObject:objectType ] ;
    sh:targetClass TS28312_IntentNrm:ExpectationObject .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:or ( [ a sh:NodeShape ;
                        sh:datatype xsd:double ] [ a sh:NodeShape ;
                        sh:datatype xsd:string ] [ a sh:NodeShape ;
                        sh:datatype xsd:boolean ] [ a sh:NodeShape ;
                        sh:datatype xsd:integer ] [ a sh:NodeShape ;
                        sh:datatype xsd:dateTime ] ),
                ( [ a sh:NodeShape ;
                        sh:class TS28623_ComDefs:GeoArea ] [ a sh:NodeShape ;
                        sh:class TS28623_ComDefs:PlmnId ] [ a sh:NodeShape ;
                        sh:class TS28623_ComDefs:GeoCoordinate ] [ a sh:NodeShape ;
                        sh:class TS28312_IntentNrm:UEGroup ] [ a sh:NodeShape ;
                        sh:class TS28312_IntentNrm:Frequency ] [ rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
                        sh:or ( [ a sh:NodeShape ;
                                    sh:class TS28623_ComDefs:GeoArea ] [ a sh:NodeShape ;
                                    sh:class TS28623_ComDefs:PlmnId ] [ a sh:NodeShape ;
                                    sh:class TS28623_ComDefs:GeoCoordinate ] [ a sh:NodeShape ;
                                    sh:class TS28312_IntentNrm:UEGroup ] [ a sh:NodeShape ;
                                    sh:class TS28312_IntentNrm:Frequency ] [ sh:node [ a sh:NodeShape ;
                                            sh:property [ a sh:PropertyShape ;
                                                    sh:datatype xsd:dateTime ;
                                                    sh:maxCount 1 ;
                                                    sh:path TS28312_IntentNrm:startTime ],
                                                [ a sh:PropertyShape ;
                                                    sh:datatype xsd:dateTime ;
                                                    sh:maxCount 1 ;
                                                    sh:path TS28312_IntentNrm:endTime ] ] ] [ sh:node [ a sh:NodeShape ;
                                            sh:property [ a sh:PropertyShape ;
                                                    sh:datatype xsd:dateTime ;
                                                    sh:maxCount 1 ;
                                                    sh:path TS28312_IntentNrm:startTime ] ] ] [ sh:node [ a sh:NodeShape ;
                                            sh:property [ a sh:PropertyShape ;
                                                    sh:datatype xsd:dateTime ;
                                                    sh:maxCount 1 ;
                                                    sh:path TS28312_IntentNrm:endTime ] ] ] ),
                            ( [ a sh:NodeShape ;
                                    sh:datatype xsd:double ] [ a sh:NodeShape ;
                                    sh:datatype xsd:string ] [ a sh:NodeShape ;
                                    sh:datatype xsd:boolean ] [ a sh:NodeShape ;
                                    sh:datatype xsd:integer ] [ a sh:NodeShape ;
                                    sh:datatype xsd:dateTime ] ) ] [ sh:node [ a sh:NodeShape ;
                                sh:property [ a sh:PropertyShape ;
                                        sh:datatype xsd:dateTime ;
                                        sh:maxCount 1 ;
                                        sh:path TS28312_IntentNrm:endTime ],
                                    [ a sh:PropertyShape ;
                                        sh:datatype xsd:dateTime ;
                                        sh:maxCount 1 ;
                                        sh:path TS28312_IntentNrm:startTime ] ] ] [ sh:node [ a sh:NodeShape ;
                                sh:property [ a sh:PropertyShape ;
                                        sh:datatype xsd:dateTime ;
                                        sh:maxCount 1 ;
                                        sh:path TS28312_IntentNrm:startTime ] ] ] [ sh:node [ a sh:NodeShape ;
                                sh:property [ a sh:PropertyShape ;
                                        sh:datatype xsd:dateTime ;
                                        sh:maxCount 1 ;
                                        sh:path TS28312_IntentNrm:endTime ] ] ] ) ;
            sh:path TS28312_IntentNrm_Context:contextValueRange ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "IS_EQUAL_TO"^^xsd:string "IS_LESS_THAN"^^xsd:string "IS_GREATER_THAN"^^xsd:string "IS_WITHIN_RANGE"^^xsd:string "IS_OUTSIDE_RANGE"^^xsd:string "IS_ONE_OF"^^xsd:string "IS_NOT_ONE_OF"^^xsd:string "IS_EQUAL_TO_OR_LESS_THAN"^^xsd:string "IS_EQUAL_TO_OR_GREATER_THAN"^^xsd:string "IS_ALL_OF"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_Context:contextCondition ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_Context:contextAttribute ] ;
    sh:targetClass TS28312_IntentNrm:Context .

[] a sh:NodeShape ;
    sh:class TS28312_IntentNrm:IntentHandlingFunction-Single ;
    sh:targetClass TS28312_IntentNrm:IntentHandlingFunction-Multiple .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:or ( [ a sh:NodeShape ;
                        sh:class TS28623_ComDefs:GeoArea ] [ a sh:NodeShape ;
                        sh:class TS28623_ComDefs:PlmnId ] [ a sh:NodeShape ;
