            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentHandlingCapability:intentHandlingCapabilityId ],
        [ a sh:PropertyShape ;
            rdfs:comment "It describes the supported expectation targets for the supported expectation object type." ;
            sh:datatype xsd:string ;
            sh:path TS28312_IntentNrm_IntentHandlingCapability:supportedExpectationTargetNames ] ;
    sh:targetClass TS28312_IntentNrm:IntentHandlingCapability .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28312_IntentNrm:IntentHandlingCapability ;
            sh:path TS28312_IntentNrm_IntentHandlingFunction_Single:intentHandlingCapabilityList ],
        [ a sh:PropertyShape ;
            sh:class TS28312_IntentNrm:Intent_Single ;
            sh:path TS28312_IntentNrm_IntentHandlingFunction_Single:Intent ],
        [ a sh:PropertyShape ;
            sh:class TS28312_IntentNrm:IntentReport_Single ;
            sh:path TS28312_IntentNrm_IntentHandlingFunction_Single:IntentReport ] ;
    sh:targetClass TS28312_IntentNrm:IntentHandlingFunction_Single .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:double ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] [ a sh:NodeShape ;
                sh:datatype xsd:boolean ] [ a sh:NodeShape ;
                sh:datatype xsd:integer ] [ a sh:NodeShape ;
                sh:datatype xsd:dateTime ] ),
        ( [ a sh:NodeShape ;
                sh:class TS28623_ComDefs:TimeWindow ] [ a sh:NodeShape ;
                sh:class TS28623_ComDefs:GeoArea ] [ a sh:NodeShape ;
                sh:class TS28623_ComDefs:PlmnId ] [ a sh:NodeShape ;
                sh:class TS28623_ComDefs:GeoCoordinate ] [ a sh:NodeShape ;
                sh:class TS28312_IntentNrm:UEGroup ] [ a sh:NodeShape ;
                sh:class TS28312_IntentNrm:Frequency ] ) ;
    sh:targetClass TS28312_IntentNrm:ValueRangeType .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28312_IntentNrm:FulfilmentInfo ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_ExpectationFulfilmentResult:expectationFulfilmentInfo ],
        [ a sh:PropertyShape ;
