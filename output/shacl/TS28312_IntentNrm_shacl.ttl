[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28541_NrNrm:Snssai ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_UEGroup:sNssai ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 255 ;
            sh:minInclusive 0 ;
            sh:path TS28312_IntentNrm_UEGroup:fiveQI ] ;
    sh:targetClass TS28312_IntentNrm:UEGroup .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "ACKNOWLEDGED"^^xsd:string "COMPLIANT"^^xsd:string "DEGRADED"^^xsd:string "SUSPENDED"^^xsd:string "TERMINATED"^^xsd:string "FULFILMENTFAILED"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_FulfilmentInfo:notFullfilledState ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "FULFILLED"^^xsd:string "NOT_FULFILLED"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_FulfilmentInfo:fulfilmentStatus ],
        [ a sh:PropertyShape ;
            rdfs:comment "An attribute which is used when FulfilmentInfo is implemented for IntentFulfilmentInfo" ;
            sh:datatype xsd:string ;
            sh:path TS28312_IntentNrm_FulfilmentInfo:notFulfilledReasons ] ;
    sh:targetClass TS28312_IntentNrm:FulfilmentInfo .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentHandlingCapability:intentHandlingCapabilityId ],
        [ a sh:PropertyShape ;
            rdfs:comment "It describes the supported expectation targets for the supported expectation object type." ;
            sh:datatype xsd:string ;
            sh:path TS28312_IntentNrm_IntentHandlingCapability:supportedExpectationTargetNames ],
        [ a sh:PropertyShape ;
            rdfs:comment "It describes the expectation object type which can be supported by a specific intent handling function of MnS producer." ;
            sh:datatype xsd:string ;
            sh:in ( "RAN_SUBNETWORK"^^xsd:string "EDGE_SERVICE_SUPPORT"^^xsd:string "5GC_SUBNETWORK"^^xsd:string "Radio_Service"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentHandlingCapability:supportedExpectationObjectType ] ;
    sh:targetClass TS28312_IntentNrm:IntentHandlingCapability .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
