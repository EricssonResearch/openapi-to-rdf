    sh:targetClass TS28312_IntentNrm:IntentFeasibilityCheckReport .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:datatype xsd:dateTime ;
                    sh:maxCount 1 ;
                    sh:path TS28312_IntentNrm:lastUpdatedTime ],
                [ a sh:PropertyShape ;
                    sh:class TS28312_IntentNrm:IntentFulfilmentReport ;
                    sh:maxCount 1 ;
