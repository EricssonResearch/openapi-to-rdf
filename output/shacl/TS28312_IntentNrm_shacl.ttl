[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_Intent_Single:intentReportReference ],
        [ a sh:PropertyShape ;
            rdfs:comment "It describes the list of Context(s) which represents the constraints and conditions that should apply  for the entire intent even if there may be specific contexts defined for specific parts of the intent  " ;
            sh:class TS28312_IntentNrm:Context ;
            sh:path TS28312_IntentNrm_Intent_Single:intentContexts ],
        [ a sh:PropertyShape ;
            rdfs:comment "It expresses the priority of the stated intent within a MnS consumer." ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minInclusive 1 ;
            sh:path TS28312_IntentNrm_Intent_Single:intentPriority ],
        [ a sh:PropertyShape ;
            rdfs:comment "It represents the observation period of the fulfilmentInfo for corresponding  ExpectationTargets, IntentExpectations and Intent." ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_Intent_Single:observationPeriod ],
        [ a sh:PropertyShape ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS28312_IntentNrm_Intent_Single:intentExpectations ],
        [ a sh:PropertyShape ;
            rdfs:comment "It describes the intent administrative state.  This attribute is used when MnS consumer-suspension mechanism is supported" ;
            sh:datatype xsd:string ;
            sh:in ( "ACTIVATED"^^xsd:string "DEACTIVATED"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_Intent_Single:intentAdminState ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "ALL_OF"^^xsd:string "ONE_OF"^^xsd:string "ANY_OF"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_Intent_Single:contextSelectivity ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_Intent_Single:intentPreemptionCapability ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_Intent_Single:userLabel ] ;
    sh:targetClass TS28312_IntentNrm:Intent_Single .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "ALL_OF"^^xsd:string "ONE_OF"^^xsd:string "ANY_OF"^^xsd:string ) ;
    sh:targetClass TS28312_IntentNrm:Selectivity .

