            sh:path TS28312_IntentNrm_ExpectationFulfilmentResult:targetFulfilmentResult ] ;
    sh:targetClass TS28312_IntentNrm:ExpectationFulfilmentResult .

[] a sh:NodeShape ;
    sh:class TS28312_IntentNrm:IntentHandlingFunction_Single ;
    sh:targetClass TS28312_IntentNrm:IntentHandlingFunction_Multiple .

