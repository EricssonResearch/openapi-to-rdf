    sh:in ( "IS_EQUAL_TO"^^xsd:string "IS_LESS_THAN"^^xsd:string "IS_GREATER_THAN"^^xsd:string "IS_WITHIN_RANGE"^^xsd:string "IS_OUTSIDE_RANGE"^^xsd:string "IS_ONE_OF"^^xsd:string "IS_NOT_ONE_OF"^^xsd:string "IS_EQUAL_TO_OR_LESS_THAN"^^xsd:string "IS_EQUAL_TO_OR_GREATER_THAN"^^xsd:string "IS_ALL_OF"^^xsd:string ) ;
