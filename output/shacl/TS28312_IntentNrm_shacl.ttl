    sh:targetClass TS28312_IntentNrm:IntentReport_Single .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:targetClass TS28312_IntentNrm:Intent_Single .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_ExpectationObject:objectInstance ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "RAN_SUBNETWORK"^^xsd:string "EDGE_SERVICE_SUPPORT"^^xsd:string "5GC_SUBNETWORK"^^xsd:string "Radio_Service"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_ExpectationObject:objectType ],
        [ a sh:PropertyShape ;
            rdfs:comment "It describes the list of Context(s) which represents the constraints and conditions to be  used as filter information to identify the object(s) to which a given intentExpectation should apply." ;
            sh:class TS28312_IntentNrm:Context ;
            sh:path TS28312_IntentNrm_ExpectationObject:objectContexts ] ;
    sh:targetClass TS28312_IntentNrm:ExpectationObject .

[] a sh:NodeShape ;
    sh:class TS28312_IntentNrm:IntentReport_Single ;
    sh:targetClass TS28312_IntentNrm:IntentReport_Multiple .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "ACKNOWLEDGED"^^xsd:string "COMPLIANT"^^xsd:string "DEGRADED"^^xsd:string "SUSPENDED"^^xsd:string "TERMINATED"^^xsd:string "FULFILMENTFAILED"^^xsd:string ) ;
    sh:targetClass TS28312_IntentNrm:NotFulfilledState .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "IS_EQUAL_TO"^^xsd:string "IS_LESS_THAN"^^xsd:string "IS_GREATER_THAN"^^xsd:string "IS_WITHIN_RANGE"^^xsd:string "IS_OUTSIDE_RANGE"^^xsd:string "IS_ONE_OF"^^xsd:string "IS_NOT_ONE_OF"^^xsd:string "IS_EQUAL_TO_OR_LESS_THAN"^^xsd:string "IS_EQUAL_TO_OR_GREATER_THAN"^^xsd:string "IS_ALL_OF"^^xsd:string ) ;
    sh:targetClass TS28312_IntentNrm:Condition .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "It describes the expectation object type which can be supported by a specific intent handling function of MnS producer." ;
            sh:datatype xsd:string ;
            sh:in ( "RAN_SUBNETWORK"^^xsd:string "EDGE_SERVICE_SUPPORT"^^xsd:string "5GC_SUBNETWORK"^^xsd:string "Radio_Service"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentHandlingCapability:supportedExpectationObjectType ],
        [ a sh:PropertyShape ;
