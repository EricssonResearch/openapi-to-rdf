[] a sh:NodeShape ;
    sh:class TS28312_IntentNrm:Intent_Single ;
    sh:targetClass TS28312_IntentNrm:Intent_Multiple .

[] a sh:NodeShape ;
    sh:targetClass TS28312_IntentNrm:resources_intentNrm ;
    sh:xone ( [ a sh:NodeShape ;
                sh:class TS28312_IntentNrm:IntentHandlingFunction_Single ] [ a sh:NodeShape ;
                sh:class TS28312_IntentNrm:Intent_Single ] [ a sh:NodeShape ;
                sh:class TS28312_IntentNrm:IntentReport_Single ] ) .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "This will be present if the value of conflictType is EXPECTATION_CONFLICT. It describes the expectationId of the conflicting IntentExpectation with an Intent       " ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentConflictReport:conflictingExpectation ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentConflictReport:conflictingIntent ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "MODIFY"^^xsd:string "DELETE"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentConflictReport:recommendedSolutions ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "INTENT_CONFLICT"^^xsd:string "EXPECTATION_CONFLICT"^^xsd:string "TARGET_CONFLICT"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentConflictReport:conflictType ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentConflictReport:conflictId ],
        [ a sh:PropertyShape ;
            rdfs:comment "This will be present if the value of conflictType is TARGET_CONFLICT. It describes the targetName of the conflicting ExpectationTarget with an IntentExpectation           " ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentConflictReport:conflictingTarget ] ;
    sh:targetClass TS28312_IntentNrm:IntentConflictReport .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "IS_EQUAL_TO"^^xsd:string "IS_LESS_THAN"^^xsd:string "IS_GREATER_THAN"^^xsd:string "IS_WITHIN_RANGE"^^xsd:string "IS_OUTSIDE_RANGE"^^xsd:string "IS_ONE_OF"^^xsd:string "IS_NOT_ONE_OF"^^xsd:string "IS_EQUAL_TO_OR_LESS_THAN"^^xsd:string "IS_EQUAL_TO_OR_GREATER_THAN"^^xsd:string "IS_ALL_OF"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_ExpectationTarget:targetCondition ],
        [ a sh:PropertyShape ;
            rdfs:comment "It describes the list of constraints and conditions that should apply for a specific expectationTarget." ;
            sh:class TS28312_IntentNrm:Context ;
            sh:path TS28312_IntentNrm_ExpectationTarget:targetContexts ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "ALL_OF"^^xsd:string "ONE_OF"^^xsd:string "ANY_OF"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_ExpectationTarget:contextSelectivity ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_ExpectationTarget:targetName ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_ExpectationTarget:targetValueRange ;
            sh:xone ( [ a sh:NodeShape ;
                        sh:class TS28312_IntentNrm:ValueRangeType ] [ a sh:NodeShape ;
                        sh:class TS28312_IntentNrm:ValueRangeType ] ) ] ;
    sh:targetClass TS28312_IntentNrm:ExpectationTarget .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "FEASIBLE"^^xsd:string "INFEASIBLE"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentFeasibilityCheckReport:feasibilityCheckResult ],
        [ a sh:PropertyShape ;
            rdfs:comment "An attribute which is used when feasibilityCheckResult is INFEASIBLE" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentFeasibilityCheckReport:infeasibilityReason ] ;
    sh:targetClass TS28312_IntentNrm:IntentFeasibilityCheckReport .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentReport_Single:intentReference ],
