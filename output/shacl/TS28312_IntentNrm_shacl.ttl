[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "It indicates the address of report recipient for MnS consumer.  It shall be supported when the implicit intent report subscription mechanism is supported." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentReportControl:reportRecipientAddress ],
        [ a sh:PropertyShape ;
            rdfs:comment "It indicates the specified targets needed to be reported." ;
            sh:datatype xsd:string ;
            sh:path TS28312_IntentNrm_IntentReportControl:reportingTargets ],
        [ a sh:PropertyShape ;
            rdfs:comment "It indicates the type of IntentReports." ;
            sh:datatype xsd:string ;
            sh:in ( "INTENT_FULFILMENT_REPORT"^^xsd:string "INTENT_CONFLICT_REPORT"^^xsd:string "INTENT_FEASIBILITY_CHECK_REPORT"^^xsd:string "INTENT_EXPLORATION_REPORT"^^xsd:string "INTENT_FULFILMENT_NEGOTIATION_REPORT"^^xsd:string "INTENT_UTILITY_REPORT"^^xsd:string ) ;
            sh:path TS28312_IntentNrm_IntentReportControl:expectedReportTypes ],
        [ a sh:PropertyShape ;
            rdfs:comment "It indicates the time period for which the fulfilment process is observed and at the end of which the fulfilmentInfo for corresponding ExpectationTargets, IntentExpectations and Intent is updated." ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28312_IntentNrm_IntentReportControl:observationPeriod ],
        [ a sh:PropertyShape ;
            rdfs:comment "It indicates the specified conditions for intent reporting.",
                "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
            sh:path TS28312_IntentNrm_IntentReportControl:reportingConditions ;
            sh:xone ( [ a sh:NodeShape ;
                        sh:class TS28312_IntentNrm:TimeCondition ] [ a sh:NodeShape ;
                        sh:class TS28312_IntentNrm:TargetFulfilmentCondition ] ) ] ;
    sh:targetClass TS28312_IntentNrm:IntentReportControl .

