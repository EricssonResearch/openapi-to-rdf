    sh:targetClass TS28312_IntentNrm:SubNetwork_ncO_IntentNrm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "It describes the value that has been achieved for the expectation target at the time at which  the report is generated." ;
            sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_TargetFulfilmentResult:targetAchievedValue ],
        [ a sh:PropertyShape ;
            sh:class TS28312_IntentNrm:FulfilmentInfo ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_TargetFulfilmentResult:targetFulfilmentInfo ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_TargetFulfilmentResult:targetName ] ;
    sh:targetClass TS28312_IntentNrm:TargetFulfilmentResult .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28312_IntentNrm:ExpectationFulfilmentResult ;
            sh:path TS28312_IntentNrm_IntentFulfilmentReport:expectationFulfilmentResult ],
        [ a sh:PropertyShape ;
            sh:class TS28312_IntentNrm:FulfilmentInfo ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentFulfilmentReport:intentFulfilmentInfo ] ;
    sh:targetClass TS28312_IntentNrm:IntentFulfilmentReport .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 255 ;
            sh:minInclusive 0 ;
            sh:path TS28312_IntentNrm_UEGroup:fiveQI ],
        [ a sh:PropertyShape ;
            sh:class TS28541_NrNrm:Snssai ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_UEGroup:sNssai ] ;
    sh:targetClass TS28312_IntentNrm:UEGroup .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "DELIVER"^^xsd:string "ENSURE"^^xsd:string ) ;
    sh:targetClass TS28312_IntentNrm:ExpectationVerb .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "This attribute shall be supported, when the frequency information represent frequency operating band.  The allowed values for NR see TS 38.104 subclause 5.4.2.3; The allowed value for EUTRAN see TS 36.104 subclause 5.7.3       " ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_Frequency:freqband ],
        [ a sh:PropertyShape ;
            rdfs:comment "This attribute shall be supported, when the frequency information represent RF reference frequency. The allowed values for NR see TS 38.104 subclause 5.4.2.1; The allowed values for EUTRAN see TS 36.104 [X] subclause 5.7.3; " ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_Frequency:arfcn ] ;
    sh:targetClass TS28312_IntentNrm:Frequency .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_Context:contextAttribute ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_Context:contextValueRange ;
            sh:xone ( [ a sh:NodeShape ;
                        sh:class TS28312_IntentNrm:ValueRangeType ] [ a sh:NodeShape ;
                        sh:class TS28312_IntentNrm:ValueRangeType ] ) ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "IS_EQUAL_TO"^^xsd:string "IS_LESS_THAN"^^xsd:string "IS_GREATER_THAN"^^xsd:string "IS_WITHIN_RANGE"^^xsd:string "IS_OUTSIDE_RANGE"^^xsd:string "IS_ONE_OF"^^xsd:string "IS_NOT_ONE_OF"^^xsd:string "IS_EQUAL_TO_OR_LESS_THAN"^^xsd:string "IS_EQUAL_TO_OR_GREATER_THAN"^^xsd:string "IS_ALL_OF"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_Context:contextCondition ] ;
    sh:targetClass TS28312_IntentNrm:Context .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "A unique identifier of the intentExpectation within the intent." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28312_IntentNrm_IntentExpectation:expectationId ],
        [ a sh:PropertyShape ;
            sh:class TS28312_IntentNrm:ExpectationObject ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentExpectation:expectationObject ],
        [ a sh:PropertyShape ;
            sh:class TS28312_IntentNrm:ExpectationTarget ;
            sh:path TS28312_IntentNrm_IntentExpectation:expectationTargets ],
        [ a sh:PropertyShape ;
            sh:class TS28312_IntentNrm:Context ;
            sh:path TS28312_IntentNrm_IntentExpectation:expectationContexts ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "DELIVER"^^xsd:string "ENSURE"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentExpectation:expectationVerb ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "ALL_OF"^^xsd:string "ONE_OF"^^xsd:string "ANY_OF"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_IntentExpectation:contextSelectivity ] ;
    sh:targetClass TS28312_IntentNrm:IntentExpectation .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "FULFILLED"^^xsd:string "NOT_FULFILLED"^^xsd:string ) ;
    sh:targetClass TS28312_IntentNrm:FulfilmentStatus .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "ACKNOWLEDGED"^^xsd:string "COMPLIANT"^^xsd:string "DEGRADED"^^xsd:string "SUSPENDED"^^xsd:string "TERMINATED"^^xsd:string "FULFILMENTFAILED"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_FulfilmentInfo:notFullfilledState ],
        [ a sh:PropertyShape ;
            rdfs:comment "An attribute which is used when FulfilmentInfo is implemented for IntentFulfilmentInfo" ;
            sh:datatype xsd:string ;
            sh:path TS28312_IntentNrm_FulfilmentInfo:notFulfilledReasons ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "FULFILLED"^^xsd:string "NOT_FULFILLED"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28312_IntentNrm_FulfilmentInfo:fulfilmentStatus ] ;
