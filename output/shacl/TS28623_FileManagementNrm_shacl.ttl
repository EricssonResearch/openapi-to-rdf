[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:maxCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ a sh:PropertyShape ;
                                    sh:class TS28623_FileManagementNrm:File-Single ;
                                    sh:path TS28623_FileManagementNrm:File ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:jobId ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:jobRef ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:integer ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:numberOfFiles ] ] ;
                    sh:path TS28623_FileManagementNrm:attributes ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:integer ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:numberOfFiles ],
                        [ a sh:PropertyShape ;
                            sh:class TS28623_FileManagementNrm:File-Single ;
                            sh:path TS28623_FileManagementNrm:File ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:jobRef ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:jobId ] ] ;
            sh:path TS28623_FileManagementNrm_Files-Single:attributes ] ;
    sh:targetClass TS28623_FileManagementNrm:Files-Single .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28623_FileManagementNrm:FileDownloadJob-Single ;
            sh:path TS28623_FileManagementNrm_SubNetwork-ncO-FileManagementNrm:FileDownloadJob ],
        [ a sh:PropertyShape ;
