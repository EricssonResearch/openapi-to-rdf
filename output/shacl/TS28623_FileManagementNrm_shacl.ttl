                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:cancelJob ],
                        [ a sh:PropertyShape ;
                            sh:class TS28623_FileManagementNrm:FileDownloadJobProcessMonitor ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:jobMonitor ] ] ;
            sh:path TS28623_FileManagementNrm_FileDownloadJob-Single:attributes ] ;
    sh:targetClass TS28623_FileManagementNrm:FileDownloadJob-Single .

