                                    sh:path TS28623_FileManagementNrm:jobMonitor ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:notificationRecipientAddress ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:in ( true false ) ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:cancelJob ] ] ;
                    sh:path TS28623_FileManagementNrm:attributes ] ] ;
    sh:property [ a sh:PropertyShape ;
