@prefix TS28623_FileManagementNrm: <http://ericsson.com/models/3gpp/TS28623/FileManagementNrm#> .
@prefix TS28623_GenericNrm: <http://ericsson.com/models/3gpp/TS28623/GenericNrm#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:targetClass TS28623_FileManagementNrm:Files_Single .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:targetClass TS28623_FileManagementNrm:FileDownloadJob_Single .

[] a sh:NodeShape ;
    sh:targetClass TS28623_FileManagementNrm:resources_fileMgmtNrm ;
    sh:xone ( [ a sh:NodeShape ;
                sh:class TS28623_FileManagementNrm:FileDownloadJob_Single ] [ a sh:NodeShape ;
                sh:class TS28623_FileManagementNrm:Files_Single ] [ a sh:NodeShape ;
                sh:class TS28623_FileManagementNrm:File_Single ] ) .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileContent ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileLocation ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:dateTime ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileExpirationTime ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:integer ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileSize ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:dateTime ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileReadyTime ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:in ( "PERFORMANCE"^^xsd:string "TRACE"^^xsd:string "ANALYTICS"^^xsd:string "PROPRIETARY"^^xsd:string ) ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileDataType ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileFormat ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:jobRef ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:jobId ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileCompression ] ] ;
            sh:path TS28623_FileManagementNrm:attributes ] ;
    sh:targetClass TS28623_FileManagementNrm:File_Single .

[] a sh:NodeShape ;
    sh:class TS28623_FileManagementNrm:FileDownloadJob_Single ;
    sh:targetClass TS28623_FileManagementNrm:FileDownloadJob_Multiple .

[] a sh:NodeShape ;
    sh:class TS28623_FileManagementNrm:Files_Single ;
    sh:targetClass TS28623_FileManagementNrm:Files_Multiple .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28623_FileManagementNrm:Files_Single ;
            sh:path TS28623_FileManagementNrm:Files ],
        [ a sh:PropertyShape ;
            sh:class TS28623_FileManagementNrm:FileDownloadJob_Single ;
            sh:path TS28623_FileManagementNrm:FileDownloadJob ] ;
    sh:targetClass TS28623_FileManagementNrm:SubNetwork_ncO_FileManagementNrm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:jobId ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:integer ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:numberOfFiles ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:jobRef ],
                        [ a sh:PropertyShape ;
                            sh:class TS28623_FileManagementNrm:File_Single ;
                            sh:path TS28623_FileManagementNrm:File ] ] ;
            sh:path TS28623_FileManagementNrm:attributes ] ;
    sh:targetClass TS28623_FileManagementNrm:Files_Single .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:targetClass TS28623_FileManagementNrm:File_Single .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm:jobId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm:endTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minInclusive 0 ;
            sh:path TS28623_FileManagementNrm:progressPercentage ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm:startTime ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm:resultStateInfo ;
            sh:xone ( [ a sh:NodeShape ;
                        sh:datatype xsd:string ;
                        sh:in ( "NULL"^^xsd:string "UNKNOWN"^^xsd:string "NO_STORAGE"^^xsd:string "LOW_MEMROY"^^xsd:string "NO_CONNECTION_TO_REMOTE_SERVER"^^xsd:string "FILE_NOT_AVAILABLE"^^xsd:string "DNS_CANNOT_BE_RESOLVED"^^xsd:string "TIMER_EXPIRED"^^xsd:string "OTHER"^^xsd:string ) ] [ a sh:NodeShape ;
                        sh:datatype xsd:string ] ) ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm:timer ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "NOT_STARTED"^^xsd:string "RUNNING"^^xsd:string "FINSHED"^^xsd:string "FAILED"^^xsd:string "CANCELLING"^^xsd:string "CANCELLED"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm:status ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm:progressStateInfo ] ;
    sh:targetClass TS28623_FileManagementNrm:FileDownloadJobProcessMonitor .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28623_FileManagementNrm:FileDownloadJob_Single ;
            sh:path TS28623_FileManagementNrm:FileDownloadJob ],
        [ a sh:PropertyShape ;
            sh:class TS28623_FileManagementNrm:Files_Single ;
            sh:path TS28623_FileManagementNrm:Files ] ;
    sh:targetClass TS28623_FileManagementNrm:ManagedElement_ncO_FileManagementNrm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:in ( true false ) ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:cancelJob ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:notificationRecipientAddress ],
                        [ a sh:PropertyShape ;
                            sh:class TS28623_FileManagementNrm:FileDownloadJobProcessMonitor ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:jobMonitor ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileLocation ] ] ;
            sh:path TS28623_FileManagementNrm:attributes ] ;
    sh:targetClass TS28623_FileManagementNrm:FileDownloadJob_Single .

[] a sh:NodeShape ;
    sh:class TS28623_FileManagementNrm:File_Single ;
    sh:targetClass TS28623_FileManagementNrm:File_Multiple .

