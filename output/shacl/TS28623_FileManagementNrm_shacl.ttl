    sh:class TS28623_FileManagementNrm:Files-Single ;
    sh:targetClass TS28623_FileManagementNrm:Files-Multiple .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:maxCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:fileCompression ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:fileLocation ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:dateTime ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:fileReadyTime ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:integer ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:fileSize ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:jobRef ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:dateTime ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:fileExpirationTime ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:in ( "PERFORMANCE"^^xsd:string "TRACE"^^xsd:string "ANALYTICS"^^xsd:string "PROPRIETARY"^^xsd:string ) ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:fileDataType ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:jobId ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:fileContent ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28623_FileManagementNrm:fileFormat ] ] ;
                    sh:path TS28623_FileManagementNrm:attributes ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:dateTime ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileReadyTime ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:jobId ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileCompression ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:dateTime ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileExpirationTime ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:jobRef ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileContent ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:in ( "PERFORMANCE"^^xsd:string "TRACE"^^xsd:string "ANALYTICS"^^xsd:string "PROPRIETARY"^^xsd:string ) ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileDataType ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileFormat ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:integer ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileSize ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28623_FileManagementNrm:fileLocation ] ] ;
            sh:path TS28623_FileManagementNrm_File-Single:attributes ] ;
    sh:targetClass TS28623_FileManagementNrm:File-Single .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm_FileDownloadJobProcessMonitor:progressStateInfo ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm_FileDownloadJobProcessMonitor:resultStateInfo ;
            sh:xone ( [ a sh:NodeShape ;
                        sh:datatype xsd:string ;
                        sh:in ( "NULL"^^xsd:string "UNKNOWN"^^xsd:string "NO_STORAGE"^^xsd:string "LOW_MEMROY"^^xsd:string "NO_CONNECTION_TO_REMOTE_SERVER"^^xsd:string "FILE_NOT_AVAILABLE"^^xsd:string "DNS_CANNOT_BE_RESOLVED"^^xsd:string "TIMER_EXPIRED"^^xsd:string "OTHER"^^xsd:string ) ] [ a sh:NodeShape ;
                        sh:datatype xsd:string ] ) ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "NOT_STARTED"^^xsd:string "RUNNING"^^xsd:string "FINSHED"^^xsd:string "FAILED"^^xsd:string "CANCELLING"^^xsd:string "CANCELLED"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm_FileDownloadJobProcessMonitor:status ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm_FileDownloadJobProcessMonitor:timer ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm_FileDownloadJobProcessMonitor:jobId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minInclusive 0 ;
            sh:path TS28623_FileManagementNrm_FileDownloadJobProcessMonitor:progressPercentage ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm_FileDownloadJobProcessMonitor:startTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28623_FileManagementNrm_FileDownloadJobProcessMonitor:endTime ] ;
    sh:targetClass TS28623_FileManagementNrm:FileDownloadJobProcessMonitor .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28623_FileManagementNrm:Files-Single ;
            sh:path TS28623_FileManagementNrm_ManagedElement-ncO-FileManagementNrm:Files ],
        [ a sh:PropertyShape ;
