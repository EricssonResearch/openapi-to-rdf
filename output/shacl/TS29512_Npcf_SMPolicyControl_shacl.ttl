@prefix TS29512_Npcf_SMPolicyControl: <http://ericsson.com/models/3gpp/TS29512/Npcf_SMPolicyControl#> .
@prefix TS29512_Npcf_SMPolicyControl_PacketFilterInfo: <http://ericsson.com/models/3gpp/TS29512/Npcf_SMPolicyControl/PacketFilterInfo#> .
@prefix TS29571_CommonData: <http://ericsson.com/models/3gpp/TS29571/CommonData#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:qosFlowUsage ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29512_Npcf_SMPolicyControl:pccRules ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29512_Npcf_SMPolicyControl:praInfos ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29512_Npcf_SMPolicyControl:sessRules ],
        [ a sh:PropertyShape ;
            rdfs:comment "Defines the policy control request triggers subscribed by the PCF." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:policyCtrlReqTriggers ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29512_Npcf_SMPolicyControl:qosChars ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:RequestedUsageData ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:lastReqUsageData ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:BridgeManagementContainer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:tsnBridgeManCont ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:PortManagementContainer ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:tsnPortManContNwtts ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:ChargingInformation ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:chargingInfo ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29512_Npcf_SMPolicyControl:chgDecs ],
        [ a sh:PropertyShape ;
            rdfs:comment "Defines the last list of rule control data requested by the PCF." ;
            sh:class TS29512_Npcf_SMPolicyControl:RequestedRuleData ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:lastReqRuleData ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:PortManagementContainer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:tsnPortManContDstt ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29512_Npcf_SMPolicyControl:qosMonDecs ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29512_Npcf_SMPolicyControl:umDecs ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:redSessIndication ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29512_Npcf_SMPolicyControl:conds ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:relCause ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29512_Npcf_SMPolicyControl:traffContDecs ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29512_Npcf_SMPolicyControl:qosDecs ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:pcscfRestIndication ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:revalidationTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:reflectiveQoSTimer ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:online ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:offline ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:suppFeat ;
            sh:pattern "^[A-Fa-f0-9]*$" ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:SmPolicyDecision .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "DDN_FAILURE"^^xsd:string "DDD_STATUS"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:NotificationControlIndication .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:allUmIds ],
        [ a sh:PropertyShape ;
            rdfs:comment "An array of usage monitoring data id references to the usage monitoring data instances for which the PCF is requesting a usage report. This attribute shall only be provided when allUmIds is not set to true." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:refUmIds ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:RequestedUsageData .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:redirectAddressType ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:redirectEnabled ],
        [ a sh:PropertyShape ;
            rdfs:comment "Indicates the address of the redirect server. If \"redirectAddressType\" attribute indicates the IPV4_ADDR, the encoding is the same as the Ipv4Addr data type defined in 3GPP TS 29.571.If \"redirectAddressType\" attribute indicates the IPV6_ADDR, the encoding is the same as the Ipv6Addr data type defined in 3GPP TS 29.571.If \"redirectAddressType\" attribute indicates the URL or SIP_URI, the encoding is the same as the Uri data type defined in 3GPP TS 29.571." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:redirectServerAddress ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:RedirectInformation .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "Used to report the PCC rule failure." ;
            sh:class TS29512_Npcf_SMPolicyControl:RuleReport ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ruleReports ],
        [ a sh:PropertyShape ;
            rdfs:comment "Used to report the session rule failure." ;
            sh:class TS29512_Npcf_SMPolicyControl:SessionRuleReport ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:sessRuleReports ],
        [ a sh:PropertyShape ;
            rdfs:comment "Used to report failure of the policy decision and/or condition data." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:polDecFailureReports ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:ProblemDetails ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:error ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:altQosParamId ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:ErrorReport .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue ;
    sh:datatype xsd:string ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:MeteringMethod .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "ANR_NOT_SUPPORTED"^^xsd:string "TZR_NOT_SUPPORTED"^^xsd:string "LOC_NOT_SUPPORTED"^^xsd:string ) ] [ a sh:NodeShape ;
                rdfs:comment """This string provides forward-compatibility with future extensions to the enumeration but is not used to encode content defined in the present version of this API.
""" ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:NetLocAccessSupport .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:AccessTypeRm ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:standby ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "3GPP_ACCESS"^^xsd:string "NON_3GPP_ACCESS"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:active ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:steerModeValue ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29512_Npcf_SMPolicyControl:3gLoad ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "3GPP_ACCESS"^^xsd:string "NON_3GPP_ACCESS"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:prioAcc ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:SteeringMode .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:maxbrDl ;
            sh:pattern "^\\d+(\\.\\d+)? (bps|Kbps|Mbps|Gbps|Tbps)$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:gbrDl ;
            sh:pattern "^\\d+(\\.\\d+)? (bps|Kbps|Mbps|Gbps|Tbps)$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 4095 ;
            sh:minInclusive 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:maxDataBurstVol ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 127 ;
            sh:minInclusive 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:priorityLevel ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 4095 ;
            sh:minInclusive 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:averWindow ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:gbrUl ;
            sh:pattern "^\\d+(\\.\\d+)? (bps|Kbps|Mbps|Gbps|Tbps)$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 255 ;
            sh:minInclusive 0 ;
            sh:path TS29512_Npcf_SMPolicyControl:5qi ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 2000000 ;
            sh:minInclusive 4096 ;
            sh:path TS29512_Npcf_SMPolicyControl:extMaxDataBurstVol ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Arp ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:arp ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:maxbrUl ;
            sh:pattern "^\\d+(\\.\\d+)? (bps|Kbps|Mbps|Gbps|Tbps)$" ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:AuthorizedDefaultQos .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "Contains the identifier of the affected session rule(s)." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ruleIds ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ruleStatus ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:sessRuleFailureCode ],
        [ a sh:PropertyShape ;
            rdfs:comment "Contains the type(s) of failed policy decision and/or condition data." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:policyDecFailureReports ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:SessionRuleReport .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:AdditionalAccessInfo ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:relAccessInfo ],
        [ a sh:PropertyShape ;
            rdfs:comment "Contains the number of supported packet filter for signalled QoS rules." ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:numOfPackFilter ],
        [ a sh:PropertyShape ;
            rdfs:comment "QoS Notification Control information." ;
            sh:class TS29512_Npcf_SMPolicyControl:QosNotificationControlInfo ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:qncReports ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:maPduInd ],
        [ a sh:PropertyShape ;
            rdfs:comment "Used to report the PCC rule failure." ;
            sh:class TS29512_Npcf_SMPolicyControl:RuleReport ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ruleReports ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:addRelIpv6AddrPrefixes ],
        [ a sh:PropertyShape ;
            rdfs:comment "The policy control reqeust trigges which are met." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:repPolicyCtrlReqTriggers ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:IpMulticastAddressInfo ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:mulAddrInfos ],
        [ a sh:PropertyShape ;
            rdfs:comment "Contains the type(s) of failed policy decision and/or condition data." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:policyDecFailureReports ],
        [ a sh:PropertyShape ;
            rdfs:comment "Indicates the DN-AAA authorization profile index" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:authProfIndex ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:PlmnIdNid ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:servingNetwork ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:typesOfNotif ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:relUeMac ;
            sh:pattern "^([0-9a-fA-F]{2})((-[0-9a-fA-F]{2}){5})$" ],
        [ a sh:PropertyShape ;
            rdfs:comment "Used to report the session rule failure." ;
            sh:class TS29512_Npcf_SMPolicyControl:SessionRuleReport ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:sessRuleReports ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:ServingNfIdentity ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:servNfId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:userLocationInfoTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:addIpv6AddrPrefixes ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:UeInitiatedResourceRequest ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ueInitResReq ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ueMac ;
            sh:pattern "^([0-9a-fA-F]{2})((-[0-9a-fA-F]{2}){5})$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ipv4Address ;
            sh:pattern "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:refQosIndication ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:BridgeManagementContainer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:tsnBridgeManCont ],
        [ a sh:PropertyShape ;
            rdfs:comment "Indicates the access network charging identifier for the PCC rule(s) or whole PDU session." ;
            sh:class TS29512_Npcf_SMPolicyControl:AccNetChId ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:accNetChIds ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:3gppPsDataOffStatus ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:atsssCapab ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29512_Npcf_SMPolicyControl:repPraInfos ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:QosMonitoringReport ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:qosMonReports ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:vplmnQosNotApp ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:PortManagementContainer ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:tsnPortManContNwtts ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:SubscribedDefaultQos ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:subsDefQos ],
        [ a sh:PropertyShape ;
            rdfs:comment "Contains the identifier of the PCC rule which is used for traffic detection of event." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:pccRuleId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:relIpv6AddressPrefix ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "3GPP_ACCESS"^^xsd:string "NON_3GPP_ACCESS"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:accessType ],
        [ a sh:PropertyShape ;
            rdfs:comment "Contains the usage report" ;
            sh:class TS29512_Npcf_SMPolicyControl:AccuUsageReport ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:accuUsageReports ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:PortManagementContainer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:tsnPortManContDstt ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:UserLocation ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:userLocationInfo ],
        [ a sh:PropertyShape ;
            rdfs:comment "Indicates the IPv4 address domain" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ipDomain ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:qosFlowUsage ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ipv6AddressPrefix ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:DddTrafficDescriptor ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:trafficDescriptors ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:creditManageStatus ],
        [ a sh:PropertyShape ;
            rdfs:comment "Report the start/stop of the application traffic and detected SDF descriptions if applicable." ;
            sh:class TS29512_Npcf_SMPolicyControl:AppDetectionInfo ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:appDetectionInfos ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:relIpv4Address ;
            sh:pattern "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:TsnBridgeInfo ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:tsnBridgeInfo ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:interGrpIds ;
            sh:pattern "^[A-Fa-f0-9]{8}-[0-9]{3}-[0-9]{2,3}-([A-Fa-f0-9][A-Fa-f0-9]){1,10}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
