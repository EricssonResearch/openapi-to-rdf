        [ a sh:PropertyShape ;
            rdfs:comment "Contains the usage report" ;
            sh:class TS29512_Npcf_SMPolicyControl:AccuUsageReport ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:accuUsageReports ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:userLocationInfoTime ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:PlmnIdNid ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:servingNetwork ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:SmPolicyDeleteData .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "A reference to UsageMonitoringData policy decision type to apply for Non-3GPP access. It is the umId described in subclause 5.6.2.12." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:refUmN3gData ],
        [ a sh:PropertyShape ;
            rdfs:comment "A reference to the condition data. It is the condId described in subclause 5.6.2.9." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:refCondData ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Ambr ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:authSessAmbr ],
        [ a sh:PropertyShape ;
            rdfs:comment "A reference to UsageMonitoringData policy decision type. It is the umId described in subclause 5.6.2.12." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:refUmData ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:AuthorizedDefaultQos ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:authDefQos ],
        [ a sh:PropertyShape ;
            rdfs:comment "Univocally identifies the session rule within a PDU session." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:sessRuleId ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:SessionRule .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "ALLOWED"^^xsd:string "NOT_ALLOWED"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:MulticastAccessControl .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "An id referencing UsageMonitoringData objects associated with this usage report." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:refUmIds ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:nextTimeUsage ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:AccuUsageReport .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ruleOp ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:precedence ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:pccRuleId ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:PacketFilterInfo ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:packFiltInfo ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:RequestedQos ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:reqQos ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:UeInitiatedResourceRequest .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:inactivityTime ],
        [ a sh:PropertyShape ;
            rdfs:comment "Contains the PCC rule identifier(s) which corresponding service data flow(s) shall be excluded from PDU Session usage monitoring. It is only included in the UsageMonitoringData instance for session level usage monitoring." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:exUsagePccRuleIds ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:nextTimeThreshold ],
        [ a sh:PropertyShape ;
            rdfs:comment "Univocally identifies the usage monitoring policy data within a PDU session." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:umId ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:UsageMonitoringData .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:servNfInstId ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Guami ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:guami ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:ServingNfIdentity .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:bridgeManCont ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:BridgeManagementContainer .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "UNK_RULE_ID"^^xsd:string "RA_GR_ERR"^^xsd:string "SER_ID_ERR"^^xsd:string "NF_MAL"^^xsd:string "RES_LIM"^^xsd:string "MAX_NR_QoS_FLOW"^^xsd:string "MISS_FLOW_INFO"^^xsd:string "RES_ALLO_FAIL"^^xsd:string "UNSUCC_QOS_VAL"^^xsd:string "INCOR_FLOW_INFO"^^xsd:string "PS_TO_CS_HAN"^^xsd:string "APP_ID_ERR"^^xsd:string "NO_QOS_FLOW_BOUND"^^xsd:string "FILTER_RES"^^xsd:string "MISS_REDI_SER_ADDR"^^xsd:string "CM_END_USER_SER_DENIED"^^xsd:string "CM_CREDIT_CON_NOT_APP"^^xsd:string "CM_AUTH_REJ"^^xsd:string "CM_USER_UNK"^^xsd:string "CM_RAT_FAILED"^^xsd:string "UE_STA_SUSP"^^xsd:string ) ] [ a sh:NodeShape ;
                rdfs:comment """This string provides forward-compatibility with future extensions to the enumeration but is not used to encode content defined in the present version of this API.
""" ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:FailureCode .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:TsnPortNumber ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:portNum ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:portManCont ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:PortManagementContainer .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:PacketFilterContent .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "GENERAL"^^xsd:string "IMS_SIG"^^xsd:string ) ] [ a sh:NodeShape ;
                rdfs:comment """This string provides forward-compatibility with future extensions to the enumeration but is not used to encode content defined in the present version of this API.
""" ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:QosFlowUsage .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:anChargIpv6Addr ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:anChargIpv4Addr ;
            sh:pattern "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:AccNetChargingAddress .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "PLMN_CH"^^xsd:string "RES_MO_RE"^^xsd:string "AC_TY_CH"^^xsd:string "UE_IP_CH"^^xsd:string "UE_MAC_CH"^^xsd:string "AN_CH_COR"^^xsd:string "US_RE"^^xsd:string "APP_STA"^^xsd:string "APP_STO"^^xsd:string "AN_INFO"^^xsd:string "CM_SES_FAIL"^^xsd:string "PS_DA_OFF"^^xsd:string "DEF_QOS_CH"^^xsd:string "SE_AMBR_CH"^^xsd:string "QOS_NOTIF"^^xsd:string "NO_CREDIT"^^xsd:string "REALLO_OF_CREDIT"^^xsd:string "PRA_CH"^^xsd:string "SAREA_CH"^^xsd:string "SCNN_CH"^^xsd:string "RE_TIMEOUT"^^xsd:string "RES_RELEASE"^^xsd:string "SUCC_RES_ALLO"^^xsd:string "RAT_TY_CH"^^xsd:string "REF_QOS_IND_CH"^^xsd:string "NUM_OF_PACKET_FILTER"^^xsd:string "UE_STATUS_RESUME"^^xsd:string "UE_TZ_CH"^^xsd:string "AUTH_PROF_CH"^^xsd:string "QOS_MONITORING"^^xsd:string "SCELL_CH"^^xsd:string "EPS_FALLBACK"^^xsd:string "MA_PDU"^^xsd:string "TSN_BRIDGE_INFO"^^xsd:string "5G_RG_JOIN"^^xsd:string "5G_RG_LEAVE"^^xsd:string "DDN_FAILURE"^^xsd:string "DDN_DELIVERY_STATUS"^^xsd:string "GROUP_ID_LIST_CHG"^^xsd:string "DDN_FAILURE_CANCELLATION"^^xsd:string "DDN_DELIVERY_STATUS_CANCELLATION"^^xsd:string "VPLMN_QOS_CH"^^xsd:string ) ] [ a sh:NodeShape ;
                rdfs:comment """This string provides forward-compatibility with future extensions to the enumeration but is not used to encode content defined in the present version of this API.
""" ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:PolicyControlRequestTrigger .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "Indicates the period of time in units of miliiseconds for UL packet delay." ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:repThreshUl ],
        [ a sh:PropertyShape ;
            rdfs:comment "Indicates the period of time in units of miliiseconds for round trip packet delay." ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:repThreshRp ],
        [ a sh:PropertyShape ;
            rdfs:comment "Univocally identifies the QoS monitoring policy data within a PDU session." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:qmId ],
        [ a sh:PropertyShape ;
            rdfs:comment "Indicates the period of time in units of miliiseconds for DL packet delay." ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:repThreshDl ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:notifyUri ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:notifyCorreId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:waitTime ],
        [ a sh:PropertyShape ;
            rdfs:comment "indicates the UL packet delay, DL packet delay and/or round trip packet delay between the UE and the UPF is to be monitored when the QoS Monitoring for URLLC is enabled for the service data flow." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:reqQosMonParams ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:repPeriod ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:repFreqs ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:QosMonitoringData .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "Contains the identifier of the PCC rule(s) associated to the provided Access Network Charging Identifier." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:refPccRuleIds ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:sessionChScope ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:accNetChaIdValue ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:AccNetChId .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "NF_MAL"^^xsd:string "RES_LIM"^^xsd:string "UNSUCC_QOS_VAL"^^xsd:string "UE_STA_SUSP"^^xsd:string ) ] [ a sh:NodeShape ;
                rdfs:comment """This string provides forward-compatibility with future extensions to the enumeration but is not used to encode content defined in the present version of this API.
""" ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:SessionRuleFailureCode .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "It is used to set the value of Notification Correlation ID in the notification sent by the SMF." ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:notifCorreId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:notificationUri ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:dnaiChgType ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:afAckInd ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:UpPathChgEvent .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:gbrDl ;
            sh:pattern "^\\d+(\\.\\d+)? (bps|Kbps|Mbps|Gbps|Tbps)$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 255 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29512_Npcf_SMPolicyControl:5qi ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:gbrUl ;
            sh:pattern "^\\d+(\\.\\d+)? (bps|Kbps|Mbps|Gbps|Tbps)$" ] ;
    sh:targetClass TS29512_Npcf_SMPolicyControl:RequestedQos .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:notificationUri ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:offline ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:3gppPsDataOffStatus ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:AccNetChId ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:accNetChId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:pei ;
            sh:pattern "^(imei-[0-9]{15}|imeisv-[0-9]{16}|mac((-[0-9a-fA-F]{2}){6})(-untrusted)?|eui((-[0-9a-fA-F]{2}){8})|.+)$" ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:AdditionalAccessInfo ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:addAccessInfo ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:smfId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ipv6AddressPrefix ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:refQosIndication ],
        [ a sh:PropertyShape ;
            rdfs:comment "Indicates the IPv4 address domain" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ipDomain ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:atsssCapab ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Ambr ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:subsSessAmbr ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:pduSessionType ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:recoveryTime ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:UserLocation ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:userLocationInfo ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:suppFeat ;
            sh:pattern "^[A-Fa-f0-9]*$" ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:PlmnIdNid ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:servingNetwork ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ipv4Address ;
            sh:pattern "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:invalidSupi ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:ServingNfIdentity ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:servNfId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ipv6FrameRouteList ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ratType ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:SubscribedDefaultQos ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:subsDefQos ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:TraceData ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:traceReq ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:qosFlowUsage ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "3GPP_ACCESS"^^xsd:string "NON_3GPP_ACCESS"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:accessType ],
        [ a sh:PropertyShape ;
            rdfs:comment "Indicates the DN-AAA authorization profile index" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:authProfIndex ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:maPduInd ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ueTimeZone ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 255 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29512_Npcf_SMPolicyControl:pduSessionId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:online ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:dnn ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:supi ;
            sh:pattern "^(imsi-[0-9]{5,15}|nai-.+|gci-.+|gli-.+|.+)$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:gpsi ;
            sh:pattern "^(msisdn-[0-9]{5,15}|extid-[^@]+@[^@]+|.+)$" ],
        [ a sh:PropertyShape ;
            rdfs:comment "Contains the number of supported packet filter for signalled QoS rules." ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:numOfPackFilter ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:chargingcharacteristics ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:AccNetChargingAddress ;
            sh:maxCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:chargEntityAddr ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29512_Npcf_SMPolicyControl:ipv4FrameRouteList ;
