            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData_N3gaLocation:portNumber ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:TnapId ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_N3gaLocation:tnapId ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:TwapId ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_N3gaLocation:twapId ],
        [ a sh:PropertyShape ;
