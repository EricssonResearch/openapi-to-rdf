            sh:maxCount 1 ;
            sh:path TS29571_CommonData_N3gaLocation:protocol ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_N3gaLocation:gli ],
        [ a sh:PropertyShape ;
