            sh:maxCount 1 ;
            sh:path TS29571_CommonData_ProblemDetails:supportedFeatures ;
            sh:pattern "^[A-Fa-f0-9]*$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_ProblemDetails:type ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_ProblemDetails:status ],
        [ a sh:PropertyShape ;
