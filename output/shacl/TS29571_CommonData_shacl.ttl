[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^(imsi-[0-9]{5,15}|nai-.+|msisdn-[0-9]{5,15}|extid-[^@]+@[^@]+|gci-.+|gli-.+|.+)$" ;
    sh:targetClass TS29571_CommonData:VarUeId .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(\\/([0-9]|[1-2][0-9]|3[0-2]))$" ;
