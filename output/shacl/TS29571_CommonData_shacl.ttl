            sh:maxInclusive 127 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path TS29571_CommonData_Dynamic5Qi:priorityLevel ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:path TS29571_CommonData_Dynamic5Qi:extPacketDelBudget ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_Dynamic5Qi:resourceType ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 4095 ;
            sh:minInclusive 1 ;
            sh:path TS29571_CommonData_Dynamic5Qi:averWindow ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path TS29571_CommonData_Dynamic5Qi:packetDelayBudget ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 2000000 ;
            sh:minInclusive 4096 ;
            sh:path TS29571_CommonData_Dynamic5Qi:extMaxDataBurstVol ] ;
    sh:targetClass TS29571_CommonData:Dynamic5Qi .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^[A-Fa-f0-9]{2}$" ;
    sh:targetClass TS29571_CommonData:AmfRegionId .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29571_CommonData_AreaScope:cagInfoPerPlmn ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29571_CommonData_AreaScope:tacNidInfoPerPlmn ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_AreaScope:cagList ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_AreaScope:tacList ;
            sh:pattern "(^[A-Fa-f0-9]{4}$)|(^[A-Fa-f0-9]{6}$)" ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29571_CommonData_AreaScope:tacInfoPerPlmn ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_AreaScope:nrCellIdList ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_AreaScope:eutraCellIdList ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29571_CommonData_AreaScope:cellIdNidInfoPerPlmn ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29571_CommonData_AreaScope:nidInfoPerPlmn ] ;
    sh:targetClass TS29571_CommonData:AreaScope .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-9]{3}-[0-9]{2,3}-[A-Fa-f0-9]{6}$" ;
    sh:targetClass TS29571_CommonData:QoeReference .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment """Represent the "tz" property which provides the time zone of the object the jCard represents as defined in IETF RFC 6350, section 6.5.1.
""" ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_GeographicalProperties:tzs ],
        [ a sh:PropertyShape ;
            rdfs:comment """Represent the "geo" property which provides the global positioning of the object the jCard represents as defined in IETF RFC 6350, section 6.5.2.
""" ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_GeographicalProperties:geos ] ;
    sh:targetClass TS29571_CommonData:GeographicalProperties .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" ;
    sh:targetClass TS29571_CommonData:Ipv4AddrRm .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "NEW_UES_TERMINATION"^^xsd:string "ALL_UES_TERMINATION"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:TerminationIndication .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_MbsSessionEvent:eventType ] ;
    sh:targetClass transport:MbsSessionEvent .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^\\d+(\\.\\d+)? (B|kB|MB|GB|TB)$" ;
    sh:targetClass TS29571_CommonData:TrafficVolumeRm .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^[A-Fa-f0-9]{7}$" ;
    sh:targetClass TS29571_CommonData:EutraCellId .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:CnfUnit ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_Cnf:cnfUnits ] ;
    sh:targetClass TS29571_CommonData:Cnf .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:targetClass TS29571_CommonData:NsagIdRm .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:DnaiRm .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 127 ;
    sh:minInclusive 1 ;
    sh:targetClass TS29571_CommonData:5QiPriorityLevelRm .

