[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^(msisdn-[0-9]{5,15}|extid-[^@]+@[^@]+|.+)$" ;
    sh:targetClass TS29571_CommonData:Gpsi .

