            sh:maxCount 1 ;
            sh:path TS29571_CommonData_ProblemDetails:instance ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 253 ;
            sh:minLength 4 ;
            sh:path TS29571_CommonData_ProblemDetails:nrfId ;
            sh:pattern "^([0-9A-Za-z]([-0-9A-Za-z]{0,61}[0-9A-Za-z])?\\.)+[A-Za-z]{2,63}\\.?$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_ProblemDetails:supportedApiVersions ],
        [ a sh:PropertyShape ;
            rdfs:comment """A machine-readable application error cause specific to this occurrence of the problem.  This IE should be present and provide application-related error information, if available.
""" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_ProblemDetails:cause ],
        [ a sh:PropertyShape ;
