                sh:in ( "M1"^^xsd:string "M2"^^xsd:string "M3"^^xsd:string "M4_DL"^^xsd:string "M4_UL"^^xsd:string "M5_DL"^^xsd:string "M5_UL"^^xsd:string "M6_DL"^^xsd:string "M6_UL"^^xsd:string "M7_DL"^^xsd:string "M7_UL"^^xsd:string "M8"^^xsd:string "M9"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:MeasurementLteForMdt .

[] a sh:NodeShape ;
