            sh:path TS29571_CommonData_PresenceInfo:additionalPraId ],
        [ a sh:PropertyShape ;
            rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_PresenceInfo:globalRanNodeIdList ] ;
    sh:targetClass TS29571_CommonData:PresenceInfo .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_LinkRm:href ] ;
    sh:targetClass TS29571_CommonData:LinkRm .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:Ipv6PrefixRm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_DddTrafficDescriptor:ipv6Addr ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_DddTrafficDescriptor:ipv4Addr ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_DddTrafficDescriptor:portNumber ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_DddTrafficDescriptor:macAddr ] ;
    sh:targetClass TS29571_CommonData:DddTrafficDescriptor .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "add"^^xsd:string "copy"^^xsd:string "move"^^xsd:string "remove"^^xsd:string "replace"^^xsd:string "test"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:PatchOperation .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 255 ;
    sh:minInclusive 0 ;
    sh:targetClass TS29571_CommonData:PduSessionId .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^([A-Za-z0-9]+([-A-Za-z0-9]+)\\.)+[a-z]{2,}$" ;
    sh:targetClass TS29571_CommonData:DiameterIdentity .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:AccessTypeRm .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^[A-Fa-f0-9]+$" ;
    sh:targetClass TS29571_CommonData:TngfId .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:StnSr .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 256 ;
    sh:minInclusive 1 ;
    sh:targetClass TS29571_CommonData:RfspIndexRm .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^\\d+(\\.\\d+)? (bps|Kbps|Mbps|Gbps|Tbps)$" ;
    sh:targetClass TS29571_CommonData:BitRate .

