[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_ProblemDetails:title ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:InvalidParam ;
