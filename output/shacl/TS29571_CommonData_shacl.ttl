    sh:targetClass TS29571_CommonData:Date .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path TS29571_CommonData:value ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
