    sh:targetClass TS29571_CommonData:ArpRm .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "STATIONARY"^^xsd:string "MOBILE"^^xsd:string ) ] [ a sh:NodeShape ;
