                sh:in ( 1024 1280 2048 2560 5120 10240 60000 ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:MeasurementPeriodLteMdt .

[] a sh:NodeShape ;
