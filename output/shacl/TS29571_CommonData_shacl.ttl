    sh:targetClass TS29571_CommonData:NcgiTai .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^(imei-[0-9]{15}|imeisv-[0-9]{16}|mac((-[0-9a-fA-F]{2}){6})(-untrusted)?|eui((-[0-9a-fA-F]{2}){8})|.+)$" ;
    sh:targetClass TS29571_CommonData:PeiRm .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "IMMEDIATE_MDT_ONLY"^^xsd:string "LOGGED_MDT_ONLY"^^xsd:string "TRACE_ONLY"^^xsd:string "IMMEDIATE_MDT_AND_TRACE"^^xsd:string "LOGGED_MBSFN_MDT"^^xsd:string "5GC_UE_LEVEL_MEASUREMENTS_ONLY"^^xsd:string "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS_ONLY"^^xsd:string "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS"^^xsd:string "TRACE_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
