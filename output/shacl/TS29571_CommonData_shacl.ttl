            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:downlinkVolume ] ;
    sh:targetClass TS29571_CommonData:VolumeTimedReport .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
    sh:targetClass TS29571_CommonData:ExtPacketDelBudgetRm .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:Ipv6Prefix .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
