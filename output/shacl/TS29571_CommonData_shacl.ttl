@prefix TS29571_CommonData: <http://ericsson.com/models/3gpp/TS29571/CommonData#> .
@prefix TS29571_CommonData_CellGlobalId: <http://ericsson.com/models/3gpp/TS29571/CommonData/CellGlobalId#> .
@prefix TS29571_CommonData_Ecgi: <http://ericsson.com/models/3gpp/TS29571/CommonData/Ecgi#> .
@prefix TS29571_CommonData_GlobalRanNodeId: <http://ericsson.com/models/3gpp/TS29571/CommonData/GlobalRanNodeId#> .
@prefix TS29571_CommonData_LocationAreaId: <http://ericsson.com/models/3gpp/TS29571/CommonData/LocationAreaId#> .
@prefix TS29571_CommonData_MdtConfiguration: <http://ericsson.com/models/3gpp/TS29571/CommonData/MdtConfiguration#> .
@prefix TS29571_CommonData_Ncgi: <http://ericsson.com/models/3gpp/TS29571/CommonData/Ncgi#> .
@prefix TS29571_CommonData_NgApCause: <http://ericsson.com/models/3gpp/TS29571/CommonData/NgApCause#> .
@prefix TS29571_CommonData_NssaaStatus: <http://ericsson.com/models/3gpp/TS29571/CommonData/NssaaStatus#> .
@prefix TS29571_CommonData_RoutingAreaId: <http://ericsson.com/models/3gpp/TS29571/CommonData/RoutingAreaId#> .
@prefix TS29571_CommonData_ServiceAreaId: <http://ericsson.com/models/3gpp/TS29571/CommonData/ServiceAreaId#> .
@prefix TS29571_CommonData_Tai: <http://ericsson.com/models/3gpp/TS29571/CommonData/Tai#> .
@prefix TS29571_CommonData_WirelineServiceAreaRestriction: <http://ericsson.com/models/3gpp/TS29571/CommonData/WirelineServiceAreaRestriction#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^((([^:]+:){7}([^:]+))|((([^:]+:)*[^:]+)?::(([^:]+:)*[^:]+)?))$",
        "^((:|(0?|([1-9a-f][0-9a-f]{0,3}))):)((0?|([1-9a-f][0-9a-f]{0,3})):){0,6}(:|(0?|([1-9a-f][0-9a-f]{0,3})))$" ;
    sh:targetClass TS29571_CommonData:Ipv6Addr .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "UDP"^^xsd:string "TCP"^^xsd:string ) ] [ a sh:NodeShape ;
                rdfs:comment """This string provides forward-compatibility with future extensions to the enumeration but is not used to encode content defined in the present version of this API.
""" ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:TransportProtocol .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData:portNumber ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:ipv4Addr ;
            sh:pattern "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:ipv6Addr ] ;
    sh:targetClass TS29571_CommonData:RouteInformation .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:GlobalRanNodeId ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:globalGnbId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:geographicalInformation ;
            sh:pattern "^[0-9A-F]{16}$" ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Tai ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:tai ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 32767 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData:ageOfLocationInformation ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Ncgi ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:ncgi ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:geodeticInformation ;
            sh:pattern "^[0-9A-F]{20}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:ueLocationTimestamp ] ;
    sh:targetClass TS29571_CommonData:NrLocation .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:VolumeTimedReport ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:pduSessionUsageData ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:secondaryRatType ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:QosFlowUsageReport ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:qosFlowsUsageData ] ;
    sh:targetClass TS29571_CommonData:SecondaryRatUsageInfo .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_NssaaStatus:status ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Snssai ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:snssai ] ;
    sh:targetClass TS29571_CommonData:NssaaStatus .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^(MacroNGeNB-[A-Fa-f0-9]{5}|LMacroNGeNB-[A-Fa-f0-9]{6}|SMacroNGeNB-[A-Fa-f0-9]{5})$" ;
    sh:targetClass TS29571_CommonData:NgeNbId .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:PlmnId ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_Ncgi:plmnId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:nrCellId ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:nid ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ] ;
    sh:targetClass TS29571_CommonData:Ncgi .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 97 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData:eventThresholdRsrp ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 34 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData:eventThresholdRsrq ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:addPositioningMethodList ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:collectionPeriodRmmLte ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:loggingInterval ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:reportInterval ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:loggingIntervalNr ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_MdtConfiguration:eventList ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:positioningMethod ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:jobType ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:path TS29571_CommonData:measurementLteList ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 127 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData:eventThresholdRsrqNr ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:reportAmount ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:sensorMeasurementList ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:loggingDurationNr ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:InterFreqTargetInfo ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:interFreqTargetList ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:MbsfnArea ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:mbsfnAreaList ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:reportType ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:loggingDuration ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:measurementNrList ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:PlmnId ;
            sh:maxCount 16 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:mdtAllowedPlmnIdList ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:collectionPeriodRmmNr ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 127 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData:eventThresholdRsrpNr ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:reportIntervalNr ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:reportingTriggerList ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:measurementPeriodLte ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:AreaScope ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:areaScope ] ;
    sh:targetClass TS29571_CommonData:MdtConfiguration .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:ignoreEcgi ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:geodeticInformation ;
            sh:pattern "^[0-9A-F]{20}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:ignoreTai ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Tai ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:tai ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Ecgi ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:ecgi ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:ueLocationTimestamp ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:GlobalRanNodeId ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:globalENbId ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:GlobalRanNodeId ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:globalNgenbId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:geographicalInformation ;
            sh:pattern "^[0-9A-F]{16}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 32767 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData:ageOfLocationInformation ] ;
    sh:targetClass TS29571_CommonData:EutraLocation .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:class TS29571_CommonData:ScheduledCommunicationTime ] [ a sh:NodeShape ;
                sh:class TS29571_CommonData:NullValue ] ) ;
    sh:targetClass TS29571_CommonData:ScheduledCommunicationTimeRm .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:AreaCode .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^(imsi-[0-9]{5,15}|nai-.+|gci-.+|gli-.+|.+)$" ;
    sh:targetClass TS29571_CommonData:Supi .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-3][A-Fa-f0-9]{2}$" ;
    sh:targetClass TS29571_CommonData:AmfSetId .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:DnaiRm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:geodeticInformation ;
            sh:pattern "^[0-9A-F]{20}$" ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:RoutingAreaId ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:rai ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:ueLocationTimestamp ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:geographicalInformation ;
            sh:pattern "^[0-9A-F]{16}$" ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:LocationAreaId ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:lai ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:ServiceAreaId ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:sai ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 32767 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData:ageOfLocationInformation ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:CellGlobalId ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData:cgi ] ;
    sh:targetClass TS29571_CommonData:UtraLocation .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( 1024 1280 2048 2560 5120 10240 60000 ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:CollectionPeriodRmmLteMdt .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 100 ;
    sh:minInclusive 1 ;
    sh:targetClass TS29571_CommonData:SamplingRatioRm .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:targetClass TS29571_CommonData:Int64 .

[] a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^((([^:]+:){7}([^:]+))|((([^:]+:)*[^:]+)?::(([^:]+:)*[^:]+)?))(\\/.+)$",
        "^((:|(0?|([1-9a-f][0-9a-f]{0,3}))):)((0?|([1-9a-f][0-9a-f]{0,3})):){0,6}(:|(0?|([1-9a-f][0-9a-f]{0,3})))(\\/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))$" ;
    sh:targetClass TS29571_CommonData:Ipv6PrefixRm .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "AUTHORIZED"^^xsd:string "NOT_AUTHORIZED"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:UeAuth .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "BUFFERED"^^xsd:string "TRANSMITTED"^^xsd:string "DISCARDED"^^xsd:string ) ] [ a sh:NodeShape ;
                rdfs:comment """This string provides forward-compatibility with future extensions to the enumeration but is not used to encode content defined in the present version of this API.
""" ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:DlDataDeliveryStatus .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "NR"^^xsd:string "EUTRA"^^xsd:string "WLAN"^^xsd:string "VIRTUAL"^^xsd:string "NBIOT"^^xsd:string "WIRELINE"^^xsd:string "WIRELINE_CABLE"^^xsd:string "WIRELINE_BBF"^^xsd:string "LTE-M"^^xsd:string "NR_U"^^xsd:string "EUTRA_U"^^xsd:string "TRUSTED_N3GA"^^xsd:string "TRUSTED_WLAN"^^xsd:string "UTRA"^^xsd:string "GERA"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:RatType .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "OUT_OF_COVERAG"^^xsd:string "A2_EVENT"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:EventForMdt .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData:endTimeStamp ],
        [ a sh:PropertyShape ;
