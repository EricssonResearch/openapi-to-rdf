[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:maxLength 253 ;
    sh:minLength 4 ;
    sh:pattern "^([0-9A-Za-z]([-0-9A-Za-z]{0,61}[0-9A-Za-z])?\\.)+[A-Za-z]{2,63}\\.?$" ;
    sh:targetClass TS29571_CommonData:Fqdn .

