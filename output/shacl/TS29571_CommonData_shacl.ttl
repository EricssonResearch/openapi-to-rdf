[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment """Represent the "lang" property which provides the language(s) that may be used for communicating with the object the jCard represents as defined in IETF RFC 6350, section 6.4.4.
""" ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
