    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "DSL"^^xsd:string "PON"^^xsd:string ) ] [ a sh:NodeShape ;
                rdfs:comment """This string provides forward-compatibility with future extensions to the enumeration but is not used to encode content defined in the present version of this API.
""" ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:LineType .

