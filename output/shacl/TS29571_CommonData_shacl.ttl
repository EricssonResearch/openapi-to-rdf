@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^(imei-[0-9]{15}|imeisv-[0-9]{16}|mac((-[0-9a-fA-F]{2}){6})(-untrusted)?|eui((-[0-9a-fA-F]{2}){8})|.+)$" ;
    sh:targetClass TS29571_CommonData:Pei .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_HalTemplate:title ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_HalTemplate:method ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Property ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_HalTemplate:properties ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_HalTemplate:contentType ] ;
    sh:targetClass TS29571_CommonData:HalTemplate .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:PreemptionVulnerabilityRm .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:Dnn .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^(MacroeNB-[A-Fa-f0-9]{5}|LMacroeNB-[A-Fa-f0-9]{6}|SMacroeNB-[A-Fa-f0-9]{5}|HomeeNB-[A-Fa-f0-9]{7})$" ;
    sh:targetClass TS29571_CommonData:ENbId .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:AreaCodeRm .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( 600 1200 2400 3600 5400 7200 ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:LoggingDurationMdt .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:DnaiChangeTypeRm .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:QosResourceTypeRm .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 127 ;
    sh:minInclusive 1 ;
    sh:targetClass TS29571_CommonData:5QiPriorityLevelRm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 255 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData_MbsfnArea:mbsfnAreaId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 262143 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData_MbsfnArea:carrierFrequency ] ;
    sh:targetClass TS29571_CommonData:MbsfnArea .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( 128 256 512 1024 2048 3072 4096 6144 ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:LoggingIntervalMdt .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:class TS29571_CommonData:PlmnId ] [ a sh:NodeShape ;
                sh:class TS29571_CommonData:NullValue ] ) ;
    sh:targetClass TS29571_CommonData:PlmnIdRm .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "GNSS"^^xsd:string "E_CELL_ID"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:PositioningMethodMdt .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "PERIODICAL"^^xsd:string "EVENT_TRIGGED"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:ReportTypeMdt .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_RouteToLocation:routeProfId ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:RouteInformation ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_RouteToLocation:routeInfo ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_RouteToLocation:dnai ] ;
    sh:targetClass TS29571_CommonData:RouteToLocation .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( 600 1200 2400 3600 5400 7200 ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:LoggingDurationNrMdt .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_TwapId:civicAddress ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_TwapId:ssId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_TwapId:bssId ] ;
    sh:targetClass TS29571_CommonData:TwapId .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 255 ;
    sh:minInclusive 0 ;
    sh:targetClass TS29571_CommonData:5QiRm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_NotifyItem:resourceId ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:ChangeItem ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_NotifyItem:changes ] ;
    sh:targetClass TS29571_CommonData:NotifyItem .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:class TS29571_CommonData:Ecgi ] [ a sh:NodeShape ;
                sh:class TS29571_CommonData:NullValue ] ) ;
    sh:targetClass TS29571_CommonData:EcgiRm .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:RatTypeRm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_NrV2xAuth:pedestrianUeAuth ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_NrV2xAuth:vehicleUeAuth ] ;
    sh:targetClass TS29571_CommonData:NrV2xAuth .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "BAROMETRIC_PRESSURE"^^xsd:string "UE_SPEED"^^xsd:string "UE_ORIENTATION"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:SensorMeasurement .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:class TS29571_CommonData:Ambr ] [ a sh:NodeShape ;
                sh:class TS29571_CommonData:NullValue ] ) ;
    sh:targetClass TS29571_CommonData:AmbrRm .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "GET"^^xsd:string "POST"^^xsd:string "PUT"^^xsd:string "DELETE"^^xsd:string "PATCH"^^xsd:string "OPTIONS"^^xsd:string "HEAD"^^xsd:string "CONNECT"^^xsd:string "TRACE"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:HttpMethod .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^[0-3][A-Fa-f0-9]{2}$" ;
    sh:targetClass TS29571_CommonData:AmfSetId .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 1000 ;
    sh:minInclusive 0 ;
    sh:targetClass TS29571_CommonData:PacketLossRate .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:PlmnId ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_Ecgi:plmnId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_Ecgi:eutraCellId ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_Ecgi:nid ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ] ;
    sh:targetClass TS29571_CommonData:Ecgi .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 4294967295 ;
    sh:minInclusive 0 ;
    sh:targetClass TS29571_CommonData:Uint32 .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ] ;
            sh:path TS29571_CommonData_AreaScope:tacInfoPerPlmn ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_AreaScope:nrCellIdList ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_AreaScope:tacList ;
            sh:pattern "(^[A-Fa-f0-9]{4}$)|(^[A-Fa-f0-9]{6}$)" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_AreaScope:eutraCellIdList ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ] ;
    sh:targetClass TS29571_CommonData:AreaScope .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^\\d{2,3}$" ;
    sh:targetClass TS29571_CommonData:MncRm .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 127 ;
    sh:minInclusive 1 ;
    sh:targetClass TS29571_CommonData:5QiPriorityLevel .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:TimeZoneRm .

[] a sh:NodeShape ;
    sh:datatype xsd:dateTime ;
    sh:targetClass TS29571_CommonData:DateTimeRm .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 3279165 ;
    sh:minInclusive 0 ;
    sh:targetClass TS29571_CommonData:ArfcnValueNR .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:EutraLocation ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_UserLocation:eutraLocation ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:NrLocation ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_UserLocation:nrLocation ],
        [ a sh:PropertyShape ;
            rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_UserLocation:utraLocation ],
        [ a sh:PropertyShape ;
            rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_UserLocation:geraLocation ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:N3gaLocation ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_UserLocation:n3gaLocation ] ;
    sh:targetClass TS29571_CommonData:UserLocation .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:path TS29571_CommonData_NonDynamic5Qi:cnPacketDelayBudgetDl ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 4095 ;
            sh:minInclusive 1 ;
            sh:path TS29571_CommonData_NonDynamic5Qi:maxDataBurstVol ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 2000000 ;
            sh:minInclusive 4096 ;
            sh:path TS29571_CommonData_NonDynamic5Qi:extMaxDataBurstVol ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 4095 ;
            sh:minInclusive 1 ;
            sh:path TS29571_CommonData_NonDynamic5Qi:averWindow ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:path TS29571_CommonData_NonDynamic5Qi:cnPacketDelayBudgetUl ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 127 ;
            sh:minInclusive 1 ;
            sh:path TS29571_CommonData_NonDynamic5Qi:priorityLevel ] ;
    sh:targetClass TS29571_CommonData:NonDynamic5Qi .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^(imsi-[0-9]{5,15}|nai-.+|gci-.+|gli-.+|.+)$" ;
    sh:targetClass TS29571_CommonData:SupiRm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_NetworkId:mcc ;
            sh:pattern "^\\d{3}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_NetworkId:mnc ;
            sh:pattern "^\\d{2,3}$" ] ;
    sh:targetClass TS29571_CommonData:NetworkId .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_NrLocation:geodeticInformation ;
            sh:pattern "^[0-9A-F]{20}$" ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Ncgi ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_NrLocation:ncgi ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Tai ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_NrLocation:tai ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_NrLocation:ueLocationTimestamp ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_NrLocation:geographicalInformation ;
            sh:pattern "^[0-9A-F]{16}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
