        [ a sh:PropertyShape ;
            rdfs:comment "Routing Area Code" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_RoutingAreaId:rac ;
            sh:pattern "^[A-Fa-f0-9]{2}$" ],
        [ a sh:PropertyShape ;
            rdfs:comment "Location Area Code" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_RoutingAreaId:lac ;
            sh:pattern "^[A-Fa-f0-9]{4}$" ] ;
    sh:targetClass TS29571_CommonData:RoutingAreaId .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_AppDcInfo:streamId ],
        [ a sh:PropertyShape ;
