@prefix TS29571_CommonData_UserLocation: <https://semantics.ericsson.com/openapi/TS29571_CommonData/UserLocation/> .
@prefix TS29571_CommonData_VarRepPeriod: <https://semantics.ericsson.com/openapi/TS29571_CommonData/VarRepPeriod/> .
@prefix TS29571_CommonData_VolumeTimedReport: <https://semantics.ericsson.com/openapi/TS29571_CommonData/VolumeTimedReport/> .
@prefix TS29571_CommonData_VplmnDlAmbr: <https://semantics.ericsson.com/openapi/TS29571_CommonData/VplmnDlAmbr/> .
@prefix TS29571_CommonData_VplmnOffloadingInfo: <https://semantics.ericsson.com/openapi/TS29571_CommonData/VplmnOffloadingInfo/> .
@prefix TS29571_CommonData_WirelineArea: <https://semantics.ericsson.com/openapi/TS29571_CommonData/WirelineArea/> .
@prefix TS29571_CommonData_WirelineServiceAreaRestriction: <https://semantics.ericsson.com/openapi/TS29571_CommonData/WirelineServiceAreaRestriction/> .
@prefix TS29571_CommonData_WlanMeasurement: <https://semantics.ericsson.com/openapi/TS29571_CommonData/WlanMeasurement/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix transport: <https://semantics.ericsson.com/vocab/transport/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_ImsEventFilter:callingId ;
            sh:pattern "^(sip\\:([a-zA-Z0-9_\\-.!~*()&=+$,;?\\/]+)\\@([A-Za-z0-9]+([-A-Za-z0-9]+)\\.)+[a-z]{2,}|tel\\:\\+[0-9]{5,15})$" ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:ImsTranspInfo ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_ImsEventFilter:imsTranspFilter ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_ImsEventFilter:calledId ;
            sh:pattern "^(sip\\:([a-zA-Z0-9_\\-.!~*()&=+$,;?\\/]+)\\@([A-Za-z0-9]+([-A-Za-z0-9]+)\\.)+[a-z]{2,}|tel\\:\\+[0-9]{5,15})$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_ImsEventFilter:sessionId ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:AppBindingInfo ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_ImsEventFilter:appBindingInfo ] ;
    sh:targetClass TS29571_CommonData:ImsEventFilter .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "AUTHORIZED"^^xsd:string "NOT_AUTHORIZED"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:UeAuth .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:UpIntegrityRm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "priority of data channel relative to other data channels" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_DcStream:priority ],
        [ a sh:PropertyShape ;
            rdfs:comment "Subprotocol of the SCTP stream" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_DcStream:subprotocol ;
            sh:pattern "^[A-Fa-f0-9]{20}$" ],
        [ a sh:PropertyShape ;
            rdfs:comment """maximal lifetime in milliseconds after which a message will no longer be transmitted or retransmitted
""" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_DcStream:maxTime ],
        [ a sh:PropertyShape ;
            rdfs:comment "Stream identifier for Data Channel" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 65535 ;
            sh:path TS29571_CommonData_DcStream:streamId ],
        [ a sh:PropertyShape ;
            rdfs:comment "maximal number of the times a message will be retransmitted" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_DcStream:maxRetry ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_DcStream:order ] ;
    sh:targetClass TS29571_CommonData:DcStream .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_Link:href ] ;
    sh:targetClass TS29571_CommonData:Link .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 3279165 ;
    sh:minInclusive 0 ;
    sh:targetClass TS29571_CommonData:ArfcnValueNR .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^[A-Fa-f0-9]+$" ;
    sh:targetClass TS29571_CommonData:TngfId .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:class TS29571_CommonData:Ambr ] [ a sh:NodeShape ;
                sh:class TS29571_CommonData:NullValue ] ) ;
    sh:targetClass TS29571_CommonData:AmbrRm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:PlmnId ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_CellGlobalId:plmnId ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_CellGlobalId:cellId ;
            sh:pattern "^[A-Fa-f0-9]{4}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_CellGlobalId:lac ;
            sh:pattern "^[A-Fa-f0-9]{4}$" ] ;
    sh:targetClass TS29571_CommonData:CellGlobalId .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "TAC"^^xsd:string "SUBPLMN"^^xsd:string "GEOAREA"^^xsd:string "SNSSAI"^^xsd:string "DNN"^^xsd:string ) ] [ a sh:NodeShape ;
                rdfs:comment """This string provides forward-compatibility with future extensions to the enumeration but is not used to encode content defined in the present version of this API.
""" ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:PartitioningCriteria .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 4095 ;
    sh:minInclusive 1 ;
    sh:targetClass TS29571_CommonData:MaxDataBurstVol .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:NsacSai .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment """Refer to geographical Information. See 3GPP TS 23.032 clause 7.3.2. Only the description of an ellipsoid point with uncertainty circle is allowed to be used.
""" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_EutraLocation:geographicalInformation ;
            sh:pattern "^[0-9A-F]{16}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_EutraLocation:ignoreEcgi ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_EutraLocation:ignoreTai ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Ecgi ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_EutraLocation:ecgi ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Tai ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_EutraLocation:tai ],
        [ a sh:PropertyShape ;
            rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_EutraLocation:globalNgenbId ],
        [ a sh:PropertyShape ;
            rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_EutraLocation:globalENbId ],
        [ a sh:PropertyShape ;
            rdfs:comment """The value represents the elapsed time in minutes since the last network contact of the mobile station.  Value "0" indicates that the location information was obtained after a successful paging procedure for Active Location Retrieval when the UE is in idle mode or after a successful NG-RAN location reporting procedure with the eNB when the UE is in connected mode.  Any other value than "0" indicates that the location information is the last known one.  See 3GPP TS 29.002 clause 17.7.8.
""" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 32767 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData_EutraLocation:ageOfLocationInformation ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_EutraLocation:ueLocationTimestamp ],
        [ a sh:PropertyShape ;
            rdfs:comment """Refers to Calling Geodetic Location. See ITU-T Recommendation Q.763 (1999) [24] clause 3.88.2. Only the description of an ellipsoid point with uncertainty circle is allowed to be used.
""" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_EutraLocation:geodeticInformation ;
            sh:pattern "^[0-9A-F]{20}$" ] ;
    sh:targetClass TS29571_CommonData:EutraLocation .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:class TS29571_CommonData:SpatialValidityCond ] [ a sh:NodeShape ;
                sh:class TS29571_CommonData:NullValue ] ) ;
    sh:targetClass TS29571_CommonData:SpatialValidityCondRm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:CellIdNid ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_CellIdNidInfo:cellIdNidList ] ;
    sh:targetClass TS29571_CommonData:CellIdNidInfo .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:NsSrg .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "Local or remote port for Data Channel" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 65535 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData_DcEndpoint:sctpPort ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_DcEndpoint:fingerprint ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_DcEndpoint:fingerprints ;
            sh:pattern "^(SHA-1|SHA-224|SHA-256|SHA-384|SHA-512|MD5|MD2)\\s[0-9A-F]{2}(:[0-9A-F]{2})+$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_DcEndpoint:tlsId ;
            sh:pattern "^[A-Za-z0-9+/_-]{20,255}$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_DcEndpoint:securitySetup ] ;
    sh:targetClass TS29571_CommonData:DcEndpoint .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 256 ;
    sh:minInclusive 1 ;
    sh:targetClass TS29571_CommonData:RfspIndex .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "NOT_PREEMPTABLE"^^xsd:string "PREEMPTABLE"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:PreemptionVulnerability .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:UpConfidentialityRm .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 15 ;
    sh:minInclusive 1 ;
    sh:targetClass TS29571_CommonData:ArpPriorityLevelRm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment """When present it shall contain the number of packets the AF is allowed to send downlink in the given time unit for the given PDU session (see clause 5.31.14.3 of 3GPP TS 23.501.
""" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData_SmallDataRateStatus:remainPacketsDl ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_SmallDataRateStatus:validityTime ],
        [ a sh:PropertyShape ;
            rdfs:comment """When present, it shall indicate number of additional exception reports the UE is allowed to send uplink in the given time  unit for  the given PDU session (see clause 5.31.14.3 of 3GPP TS 23.501.
""" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData_SmallDataRateStatus:remainExReportsUl ],
        [ a sh:PropertyShape ;
            rdfs:comment """When present, it shall indicate number of additional exception reports the AF is allowed to send downlink  in the given time unit for the given PDU session (see clause 5.31.14.3 in 3GPP TS 23.501
""" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData_SmallDataRateStatus:remainExReportsDl ],
        [ a sh:PropertyShape ;
            rdfs:comment """When present, it shall contain the number of packets the UE is allowed to send uplink in the given time unit for the given PDU session (see clause 5.31.14.3 of 3GPP TS 23.501.
""" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData_SmallDataRateStatus:remainPacketsUl ] ;
    sh:targetClass TS29571_CommonData:SmallDataRateStatus .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_WirelineServiceAreaRestriction:restrictionType ],
        [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:WirelineArea ;
            sh:path TS29571_CommonData_WirelineServiceAreaRestriction:areas ] ;
    sh:targetClass TS29571_CommonData:WirelineServiceAreaRestriction .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_RouteInformation:ipv6Addr ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData_RouteInformation:portNumber ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_RouteInformation:ipv4Addr ;
            sh:pattern "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" ] ;
    sh:targetClass TS29571_CommonData:RouteInformation .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:or ( [ a sh:NodeShape ;
                            sh:datatype xsd:string ;
                            sh:in ( "ALL_PACKET_SERVICES"^^xsd:string "ROAMER_ACCESS_HPLMN_AP"^^xsd:string "ROAMER_ACCESS_VPLMN_AP"^^xsd:string ) ] [ a sh:NodeShape ;
                            sh:datatype xsd:string ] ) ] [ a sh:NodeShape ;
                sh:class TS29571_CommonData:NullValue ] ) ;
    sh:targetClass TS29571_CommonData:OdbPacketServices .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^\\d+(\\.\\d+)? (pps|kpps|Mpps|Gpps|Tpps)$" ;
    sh:targetClass TS29571_CommonData:PacketRate .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^(msisdn-[0-9]{5,15}|extid-[^@]+@[^@]+|.+)$" ;
    sh:targetClass TS29571_CommonData:GpsiRm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment """Unsigned integer, within the range 0 to 255, representing the Slice/Service Type.  It indicates the expected Network Slice behaviour in terms of features and services. Values 0 to 127 correspond to the standardized SST range. Values 128 to 255 correspond  to the Operator-specific range. See clause 28.4.2 of 3GPP TS 23.003. Standardized values are defined in clause 5.15.2.2 of 3GPP TS 23.501. 
""" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 255 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29571_CommonData_Snssai:sst ],
        [ a sh:PropertyShape ;
            rdfs:comment """3-octet string, representing the Slice Differentiator, in hexadecimal representation. Each character in the string shall take a value of "0" to "9", "a" to "f" or "A" to "F" and shall represent 4 bits. The most significant character representing the 4 most significant bits of the SD shall appear first in the string, and the character representing the 4 least significant bit of the SD shall appear last in the string. This is an optional parameter that complements the Slice/Service type(s) to allow to  differentiate amongst multiple Network Slices of the same Slice/Service type. This IE shall be absent if no SD value is associated with the SST.
""" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_Snssai:sd ;
            sh:pattern "^[A-Fa-f0-9]{6}$" ] ;
    sh:targetClass TS29571_CommonData:Snssai .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:StringMatchingCondition ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_StringMatchingRule:stringMatchingConditions ] ;
    sh:targetClass TS29571_CommonData:StringMatchingRule .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "GET"^^xsd:string "POST"^^xsd:string "PUT"^^xsd:string "DELETE"^^xsd:string "PATCH"^^xsd:string "OPTIONS"^^xsd:string "HEAD"^^xsd:string "CONNECT"^^xsd:string "TRACE"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:HttpMethod .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:path TS29571_CommonData_PduSetQosPara:pduSetDelayBudget ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_PduSetQosPara:pduSetErrRate ;
            sh:pattern "^([0-9]E-[0-9])$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_PduSetQosPara:pduSetHandlingInfo ] ;
    sh:targetClass TS29571_CommonData:PduSetQosPara .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29571_CommonData:Link ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_SelfLink:self ] ;
    sh:targetClass TS29571_CommonData:SelfLink .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( true ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:WlanRtt .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 1007 ;
    sh:minInclusive 0 ;
    sh:targetClass TS29571_CommonData:PhysCellId .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 4095 ;
    sh:minInclusive 1 ;
    sh:targetClass TS29571_CommonData:AverWindowRm .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "M1"^^xsd:string "M2"^^xsd:string "M3"^^xsd:string "M4_DL"^^xsd:string "M4_UL"^^xsd:string "M5_DL"^^xsd:string "M5_UL"^^xsd:string "M6_DL"^^xsd:string "M6_UL"^^xsd:string "M7_DL"^^xsd:string "M7_UL"^^xsd:string "M8"^^xsd:string "M9"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29571_CommonData:MeasurementNrForMdt .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue ;
    sh:datatype xsd:string ;
    sh:targetClass TS29571_CommonData:PartitioningCriteriaRm .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:pattern "^[*]$" ;
    sh:targetClass TS29571_CommonData:WildcardDnnRm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL",
                """Represents the list of NG RAN node identifiers that constitutes the area. This IE shall be present if the Area of Interest subscribed is a list of NG RAN node identifiers. 
""" ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_PresenceInfo:globalRanNodeIdList ],
        [ a sh:PropertyShape ;
            rdfs:comment """This IE may be present if the praId IE is present and if it contains a PRA identifier referring to a set of Core Network predefined Presence Reporting Areas. When present, this IE shall contain a PRA Identifier of an individual PRA within the Set of Core Network predefined Presence Reporting Areas indicated by the praId IE. 
""" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_PresenceInfo:additionalPraId ],
        [ a sh:PropertyShape ;
            rdfs:comment """Represents an identifier of the Presence Reporting Area (see clause 28.10 of 3GPP  TS 23.003.  This IE shall be present  if the Area of Interest subscribed or reported is a Presence Reporting Area or a Set of Core Network predefined Presence Reporting Areas. When present, it shall be encoded as a string representing an integer in the following ranges: 0 to 8 388 607 for UE-dedicated PRA 8 388 608 to 16 777 215 for Core Network predefined PRA Examples: PRA ID 123 is encoded as "123" PRA ID 11 238 660 is encoded as "11238660"
""" ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_PresenceInfo:praId ],
        [ a sh:PropertyShape ;
            rdfs:comment """Represents the list of tracking areas that constitutes the area. This IE shall be present if the subscription or  the event report is for tracking UE presence in the tracking areas. For non 3GPP access the TAI shall be the N3GPP TAI. 
""" ;
            sh:class TS29571_CommonData:Tai ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_PresenceInfo:trackingAreaList ],
        [ a sh:PropertyShape ;
            rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL",
                """Represents the list of eNodeB identifiers that constitutes the area. This IE shall be  present if the Area of Interest subscribed is a list of eNodeB identifiers.
""" ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_PresenceInfo:globaleNbIdList ],
        [ a sh:PropertyShape ;
            rdfs:comment """Represents the list of NR cell Ids that constitutes the area. This IE shall be present if the Area of Interest subscribed is a list of NR cell Ids. 
""" ;
            sh:class TS29571_CommonData:Ncgi ;
            sh:minCount 1 ;
            sh:path TS29571_CommonData_PresenceInfo:ncgiList ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29571_CommonData_PresenceInfo:presenceState ],
        [ a sh:PropertyShape ;
            rdfs:comment """Represents the list of EUTRAN cell Ids that constitutes the area. This IE shall be present if the Area of Interest subscribed is a list of EUTRAN cell Ids. 
""" ;
