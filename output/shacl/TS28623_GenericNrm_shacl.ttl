[] a sh:NodeShape ;
    sh:targetClass TS28623_GenericNrm:SchedulingTime ;
    sh:xone ( [ a sh:NodeShape ;
                sh:class TS28623_ComDefs:TimeWindow ] [ a sh:NodeShape ;
                sh:property [ a sh:PropertyShape ;
                        sh:class TS28623_ComDefs:TimeInterval ;
                        sh:path TS28623_GenericNrm:timeIntervals ] ] [ a sh:NodeShape ;
                sh:property [ a sh:PropertyShape ;
                        sh:datatype xsd:string ;
                        sh:in ( "MONDAY"^^xsd:string "TUESDAY"^^xsd:string "WEDNESDAY"^^xsd:string "THURSDAY"^^xsd:string "FRIDAY"^^xsd:string "SATURDAY"^^xsd:string "SUNDAY"^^xsd:string ) ;
                        sh:path TS28623_GenericNrm:daysOfWeek ],
                    [ a sh:PropertyShape ;
                        sh:class TS28623_ComDefs:TimeInterval ;
                        sh:path TS28623_GenericNrm:timeIntervals ] ] [ a sh:NodeShape ;
                sh:property [ a sh:PropertyShape ;
                        sh:class TS28623_ComDefs:TimeInterval ;
                        sh:path TS28623_GenericNrm:timeIntervals ],
                    [ a sh:PropertyShape ;
                        sh:datatype xsd:integer ;
                        sh:maxInclusive 31 ;
                        sh:minInclusive 0 ;
                        sh:path TS28623_GenericNrm:daysOfMonth ] ] ) .

