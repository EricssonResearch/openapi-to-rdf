            sh:path TS29520_Nnwdaf_AnalyticsInfo:mediumLevel ;
            sh:pattern "^(imsi-[0-9]{5,15}|nai-.+|gci-.+|gli-.+|.+)$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_AnalyticsInfo:lowLevel ;
            sh:pattern "^(imsi-[0-9]{5,15}|nai-.+|gci-.+|gli-.+|.+)$" ] ;
    sh:targetClass TS29520_Nnwdaf_AnalyticsInfo:SmcceUeList .

[] a sh:NodeShape ;
