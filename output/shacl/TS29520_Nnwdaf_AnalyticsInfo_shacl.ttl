@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:class TS29520_Nnwdaf_AnalyticsInfo:AdditionInfoAnalyticsInfoRequest,
        TS29571_CommonData:ProblemDetails ;
    sh:targetClass TS29520_Nnwdaf_AnalyticsInfo:ProblemDetailsAnalyticsInfoRequest .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "LOAD_LEVEL_INFORMATION"^^xsd:string "NETWORK_PERFORMANCE"^^xsd:string "NF_LOAD"^^xsd:string "SERVICE_EXPERIENCE"^^xsd:string "UE_MOBILITY"^^xsd:string "UE_COMMUNICATION"^^xsd:string "QOS_SUSTAINABILITY"^^xsd:string "ABNORMAL_BEHAVIOUR"^^xsd:string "USER_DATA_CONGESTION"^^xsd:string "NSI_LOAD_LEVEL"^^xsd:string "SM_CONGESTION"^^xsd:string "DISPERSION"^^xsd:string "RED_TRANS_EXP"^^xsd:string "WLAN_PERFORMANCE"^^xsd:string "DN_PERFORMANCE"^^xsd:string ) ] [ a sh:NodeShape ;
                rdfs:comment """This string provides forward-compatibility with future extensions to the enumeration but is not used to encode content defined in the present version of this API.
""" ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29520_Nnwdaf_AnalyticsInfo:EventId .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29520_Nnwdaf_EventsSubscription:AnalyticsContextIdentifier ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_AnalyticsInfo:contextIds ] ;
    sh:targetClass TS29520_Nnwdaf_AnalyticsInfo:ContextIdList .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "PENDING_ANALYTICS"^^xsd:string "HISTORICAL_ANALYTICS"^^xsd:string "AGGR_SUBS"^^xsd:string "DATA"^^xsd:string "AGGR_INFO"^^xsd:string "ML_MODELS"^^xsd:string ) ] [ a sh:NodeShape ;
                rdfs:comment """This string provides forward-compatibility with future extensions to the enumeration but is not used to encode content defined in the present version of this API.
""" ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29520_Nnwdaf_AnalyticsInfo:ContextType .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_AnalyticsInfo:rvWaitTime ] ;
    sh:targetClass TS29520_Nnwdaf_AnalyticsInfo:AdditionInfoAnalyticsInfoRequest .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment """Contains information identifying the ML model(s) that the consumer NWDAF is currently subscribing for the analytics.
""" ;
            sh:class TS29520_Nnwdaf_EventsSubscription:ModelInfo ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_AnalyticsInfo:modelInfo ],
        [ a sh:PropertyShape ;
            rdfs:comment """Output analytics for the analytics subscription which have not yet been sent to the  analytics consumer.
""" ;
            sh:class TS29520_Nnwdaf_EventsSubscription:EventNotification ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_AnalyticsInfo:pendAnalytics ],
        [ a sh:PropertyShape ;
            rdfs:comment "Type(s) of data stored in the ADRF by the NWDAF." ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_AnalyticsInfo:adrfDataTypes ],
        [ a sh:PropertyShape ;
            rdfs:comment "Historical output analytics." ;
            sh:class TS29520_Nnwdaf_EventsSubscription:EventNotification ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_AnalyticsInfo:histAnalytics ],
        [ a sh:PropertyShape ;
            rdfs:comment "Historical data related to the analytics subscription." ;
            sh:class TS29520_Nnwdaf_AnalyticsInfo:HistoricalData ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_AnalyticsInfo:histData ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_AnalyticsInfo:adrfId ],
        [ a sh:PropertyShape ;
            rdfs:comment """NWDAF identifiers of NWDAF instances used by the NWDAF service consumer when aggregating  multiple analytics subscriptions.
""" ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_AnalyticsInfo:aggrNwdafIds ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_AnalyticsInfo:lastOutputTime ],
        [ a sh:PropertyShape ;
            sh:class TS29520_Nnwdaf_EventsSubscription:AnalyticsContextIdentifier ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_AnalyticsInfo:contextId ],
        [ a sh:PropertyShape ;
            rdfs:comment """Information about analytics subscriptions that the NWDAF has with other NWDAFs to perform  aggregation.
""" ;
            sh:class TS29520_Nnwdaf_AnalyticsInfo:SpecificAnalyticsSubscription ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_AnalyticsInfo:aggrSubs ] ;
    sh:targetClass TS29520_Nnwdaf_AnalyticsInfo:ContextElement .

