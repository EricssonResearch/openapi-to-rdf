@prefix TS28317_RanScNrm: <http://ericsson.com/models/3gpp/TS28317/RanScNrm#> .
@prefix TS28317_RanScNrm_ScMgmtProfile_Single: <http://ericsson.com/models/3gpp/TS28317/RanScNrm/ScMgmtProfile_Single#> .
@prefix TS28317_RanScNrm_ScProcessMonitor: <http://ericsson.com/models/3gpp/TS28317/RanScNrm/ScProcessMonitor#> .
@prefix TS28317_RanScNrm_Sc_Process_Single: <http://ericsson.com/models/3gpp/TS28317/RanScNrm/Sc_Process_Single#> .
@prefix TS28317_RanScNrm_SubNetwork_ncO_RanScNrm: <http://ericsson.com/models/3gpp/TS28317/RanScNrm/SubNetwork_ncO_RanScNrm#> .
@prefix TS28623_GenericNrm: <http://ericsson.com/models/3gpp/TS28623/GenericNrm#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment "This attribute defines the NE Type(s) or the NE instance(s) for which this  ScMgmtProfile instance is valid." ;
            sh:class TS28317_RanScNrm:NEInfomration ;
            sh:path TS28317_RanScNrm_ScMgmtProfile_Single:nEInformation ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28317_RanScNrm_ScMgmtProfile_Single:configDataFileLocation ] ;
    sh:targetClass TS28317_RanScNrm:ScMgmtProfile_Single .

[] a sh:NodeShape ;
    sh:targetClass TS28317_RanScNrm:NEIdentification ;
    sh:xone ( [ a sh:NodeShape ;
                sh:datatype xsd:string ] [ a sh:NodeShape ;
                sh:datatype xsd:integer ;
                sh:maxInclusive 4294967295 ;
                sh:minInclusive 0 ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) .

[] a sh:NodeShape ;
    sh:targetClass TS28317_RanScNrm:resources_RanScNrm ;
    sh:xone ( [ a sh:NodeShape ;
                sh:class TS28317_RanScNrm:ScMgmtProfile_Single ] [ a sh:NodeShape ;
                sh:class TS28317_RanScNrm:Sc_Process_Single ] ) .

[] a sh:NodeShape ;
    sh:class TS28317_RanScNrm:Sc_Process_Single ;
    sh:targetClass TS28317_RanScNrm:Sc_Process_Multiple .

[] a sh:NodeShape ;
    sh:class TS28317_RanScNrm:NEIdentification ;
    sh:datatype xsd:string ;
    sh:targetClass TS28317_RanScNrm:NEInfomration .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 4294967295 ;
    sh:minInclusive 0 ;
    sh:targetClass TS28317_RanScNrm:GnbId .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "NOT_STARTED"^^xsd:string "RUNNING"^^xsd:string "FINSHED"^^xsd:string "FAILED"^^xsd:string "CANCELLING"^^xsd:string "CANCELLED"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28317_RanScNrm_ScProcessMonitor:status ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28317_RanScNrm_ScProcessMonitor:jobId ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:path TS28317_RanScNrm_ScProcessMonitor:resultStateInfo ;
            sh:xone ( [ a sh:NodeShape ;
                        sh:datatype xsd:string ;
                        sh:in ( "UNKNOWN"^^xsd:string "INCORRECT_CONFIGURATION"^^xsd:string "NE_HARDWARE_ERROR_DELECTED"^^xsd:string "DISCONNECTION_BETWEEN_NE_AND_OAM"^^xsd:string "OTHER"^^xsd:string ) ] [ a sh:NodeShape ;
                        sh:datatype xsd:string ] ) ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28317_RanScNrm_ScProcessMonitor:startTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minInclusive 0 ;
            sh:path TS28317_RanScNrm_ScProcessMonitor:progressPercentage ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "NE_HEALTH_CHECK"^^xsd:string "SW_DOWNLOAD"^^xsd:string "SW_INSTALLATION"^^xsd:string "SW_ACTIVATION"^^xsd:string "PREPARE_BASIC_CONFIGURATION_AND_OAMLINK"^^xsd:string "RETRIEVE_CONFIGURATION_DATA"^^xsd:string "SETUP_PRECONFIGURED_SIGNALLING_LINKS"^^xsd:string "SET_FINAL_STATE_OF_NE"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28317_RanScNrm_ScProcessMonitor:progressStateInfo ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28317_RanScNrm_ScProcessMonitor:endTime ] ;
    sh:targetClass TS28317_RanScNrm:ScProcessMonitor .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28317_RanScNrm:NEIdentification ;
            sh:maxCount 1 ;
            sh:path TS28317_RanScNrm_Sc_Process_Single:nEIdentification ],
        [ a sh:PropertyShape ;
            rdfs:comment "Setting this attribute to \"TRUE\" cancels the self configuration process. " ;
            sh:datatype xsd:string ;
            sh:in ( true false ) ;
            sh:maxCount 1 ;
            sh:path TS28317_RanScNrm_Sc_Process_Single:cancelScProcess ],
        [ a sh:PropertyShape ;
            sh:class TS28317_RanScNrm:ScProcessMonitor ;
            sh:maxCount 1 ;
            sh:path TS28317_RanScNrm_Sc_Process_Single:scProcessMonitor ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28317_RanScNrm_Sc_Process_Single:scMgmtProfileRef ] ;
    sh:targetClass TS28317_RanScNrm:Sc_Process_Single .

[] a sh:NodeShape ;
    sh:class TS28317_RanScNrm:NEIdentification .

[] a sh:NodeShape ;
    sh:class TS28317_RanScNrm:ScMgmtProfile_Single ;
    sh:targetClass TS28317_RanScNrm:ScMgmtProfile_Multiple .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:targetClass TS28317_RanScNrm:ScMgmtProfile_Single .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28317_RanScNrm:ScMgmtProfile_Single ;
            sh:path TS28317_RanScNrm_SubNetwork_ncO_RanScNrm:ScMgmtProfile ],
        [ a sh:PropertyShape ;
            sh:class TS28317_RanScNrm:Sc_Process_Single ;
            sh:path TS28317_RanScNrm_SubNetwork_ncO_RanScNrm:Sc_Process ] ;
    sh:targetClass TS28317_RanScNrm:SubNetwork_ncO_RanScNrm .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS28317_RanScNrm:NEType .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:targetClass TS28317_RanScNrm:Sc_Process_Single .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS28317_RanScNrm:EnbId .

