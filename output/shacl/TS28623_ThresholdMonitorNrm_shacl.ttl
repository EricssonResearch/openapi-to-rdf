@prefix TS28623_GenericNrm: <http://ericsson.com/models/3gpp/TS28623/GenericNrm#> .
@prefix TS28623_ThresholdMonitorNrm: <http://ericsson.com/models/3gpp/TS28623/ThresholdMonitorNrm#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28623_ThresholdMonitorNrm:ThresholdMonitor_Single ;
            sh:path TS28623_ThresholdMonitorNrm:ThresholdMonitor ] ;
    sh:targetClass TS28623_ThresholdMonitorNrm:ManagedElement_ncO_ThresholdMonitorNrm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28623_ThresholdMonitorNrm:ThresholdMonitor_Single ;
            sh:path TS28623_ThresholdMonitorNrm:ThresholdMonitor ] ;
    sh:targetClass TS28623_ThresholdMonitorNrm:SubNetwork_ncO_ThresholdMonitorNrm .

[] a sh:NodeShape ;
    sh:class TS28623_ThresholdMonitorNrm:ThresholdMonitor_Single ;
    sh:targetClass TS28623_ThresholdMonitorNrm:resources_thresholdMonitorNrm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:integer ;
                            sh:maxCount 1 ;
                            sh:minInclusive 1 ;
                            sh:path TS28623_ThresholdMonitorNrm:monitorGranularityPeriod ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:in ( "LOCKED"^^xsd:string "UNLOCKED"^^xsd:string ) ;
                            sh:maxCount 1 ;
                            sh:path TS28623_ThresholdMonitorNrm:administrativeState ],
                        [ a sh:PropertyShape ;
                            rdfs:comment "This datatype is used for writable attribute" ;
                            sh:class TS28623_ThresholdMonitorNrm:Dn ;
                            sh:maxCount 1 ;
                            sh:path TS28623_ThresholdMonitorNrm:objectInstances ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:in ( "ENABLED"^^xsd:string "DISABLED"^^xsd:string ) ;
                            sh:maxCount 1 ;
                            sh:path TS28623_ThresholdMonitorNrm:operationalState ],
                        [ a sh:PropertyShape ;
                            rdfs:comment "This datatype is used for writable attribute" ;
                            sh:class TS28623_ThresholdMonitorNrm:Dn ;
                            sh:maxCount 1 ;
                            sh:path TS28623_ThresholdMonitorNrm:rootObjectInstances ],
                        [ a sh:PropertyShape ;
                            sh:class TS28623_ThresholdMonitorNrm:ThresholdInfo ;
                            sh:path TS28623_ThresholdMonitorNrm:thresholdInfoList ] ] ;
            sh:path TS28623_ThresholdMonitorNrm:attributes ] ;
    sh:targetClass TS28623_ThresholdMonitorNrm:ThresholdMonitor_Single .

[] a sh:NodeShape ;
    sh:class TS28623_ThresholdMonitorNrm:ThresholdMonitor_Single ;
    sh:targetClass TS28623_ThresholdMonitorNrm:ThresholdMonitor_Multiple .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:path TS28623_ThresholdMonitorNrm:hysteresis ;
            sh:xone ( [ a sh:NodeShape ;
                        sh:datatype xsd:integer ;
                        sh:minInclusive 0 ] [ a sh:NodeShape ;
                        sh:datatype xsd:float ] ) ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:path TS28623_ThresholdMonitorNrm:thresholdValue ;
            sh:xone ( [ a sh:NodeShape ;
                        sh:datatype xsd:integer ] [ a sh:NodeShape ;
                        sh:datatype xsd:float ] ) ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "UP"^^xsd:string "DOWN"^^xsd:string "UP_AND_DOWN"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28623_ThresholdMonitorNrm:thresholdDirection ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:path TS28623_ThresholdMonitorNrm:performanceMetrics ] ;
    sh:targetClass TS28623_ThresholdMonitorNrm:ThresholdInfo .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:targetClass TS28623_ThresholdMonitorNrm:ThresholdMonitor_Single .

