            sh:path TS29514_Npcf_PolicyAuthorization_EthFlowDescription:destMacAddr ;
            sh:pattern "^([0-9a-fA-F]{2})((-[0-9a-fA-F]{2}){5})$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization_EthFlowDescription:fDesc ] ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:EthFlowDescription .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization_AppSessionContextRespData:servAuthInfo ],
        [ a sh:PropertyShape ;
            sh:class TS29514_Npcf_PolicyAuthorization:UeIdentityInfo ;
            sh:minCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization_AppSessionContextRespData:ueIds ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization_AppSessionContextRespData:suppFeat ;
            sh:pattern "^[A-Fa-f0-9]*$" ] ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:AppSessionContextRespData .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization_TemporalValidity:stopTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization_TemporalValidity:startTime ] ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:TemporalValidity .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "FINAL"^^xsd:string "PRELIMINARY"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:ServiceInfoStatus .

[] a sh:NodeShape ;
    sh:class TS29571_CommonData:NullValue ;
    sh:datatype xsd:string ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:PreemptionControlInformationRm .

[] a sh:NodeShape ;
    sh:datatype xsd:integer ;
    sh:maxInclusive 8 ;
    sh:minInclusive 1 ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:TscPriorityLevel .

