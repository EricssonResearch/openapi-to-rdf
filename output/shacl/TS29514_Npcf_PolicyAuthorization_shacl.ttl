[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "TP_NOT_KNOWN"^^xsd:string "TP_EXPIRED"^^xsd:string "TP_NOT_YET_OCURRED"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:ServAuthInfo .

[] a sh:NodeShape ;
