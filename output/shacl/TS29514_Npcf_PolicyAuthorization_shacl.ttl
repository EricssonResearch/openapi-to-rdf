    sh:targetClass TS29514_Npcf_PolicyAuthorization:ServiceUrn .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization:ipDomain ],
