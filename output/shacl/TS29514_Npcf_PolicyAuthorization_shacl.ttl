@prefix TS29512_Npcf_SMPolicyControl: <http://ericsson.com/models/3gpp/TS29512/Npcf_SMPolicyControl#> .
@prefix TS29514_Npcf_PolicyAuthorization: <http://ericsson.com/models/3gpp/TS29514/Npcf_PolicyAuthorization#> .
@prefix TS29514_Npcf_PolicyAuthorization_AfRoutingRequirementRm: <http://ericsson.com/models/3gpp/TS29514/Npcf_PolicyAuthorization/AfRoutingRequirementRm#> .
@prefix TS29514_Npcf_PolicyAuthorization_AppSessionContextUpdateData: <http://ericsson.com/models/3gpp/TS29514/Npcf_PolicyAuthorization/AppSessionContextUpdateData#> .
@prefix TS29514_Npcf_PolicyAuthorization_AppSessionContextUpdateDataPatch: <http://ericsson.com/models/3gpp/TS29514/Npcf_PolicyAuthorization/AppSessionContextUpdateDataPatch#> .
@prefix TS29514_Npcf_PolicyAuthorization_EventsSubscReqDataRm: <http://ericsson.com/models/3gpp/TS29514/Npcf_PolicyAuthorization/EventsSubscReqDataRm#> .
