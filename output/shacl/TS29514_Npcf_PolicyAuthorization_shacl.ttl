            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization:flowUsage ] ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:MediaSubComponent .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "ACCESS_TYPE_CHANGE"^^xsd:string "ANI_REPORT"^^xsd:string "CHARGING_CORRELATION"^^xsd:string "EPS_FALLBACK"^^xsd:string "FAILED_RESOURCES_ALLOCATION"^^xsd:string "OUT_OF_CREDIT"^^xsd:string "PLMN_CHG"^^xsd:string "QOS_MONITORING"^^xsd:string "QOS_NOTIF"^^xsd:string "RAN_NAS_CAUSE"^^xsd:string "REALLOCATION_OF_CREDIT"^^xsd:string "SUCCESSFUL_RESOURCES_ALLOCATION"^^xsd:string "TSN_BRIDGE_INFO"^^xsd:string "USAGE_REPORT"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:AfEvent .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:TosTrafficClassRm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
