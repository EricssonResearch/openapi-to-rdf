    sh:maxInclusive 8 ;
    sh:minInclusive 1 ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:TscPriorityLevelRm .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "ALL_SDF_DEACTIVATION"^^xsd:string "PDU_SESSION_TERMINATION"^^xsd:string "PS_TO_CS_HO"^^xsd:string ) ] [ a sh:NodeShape ;
