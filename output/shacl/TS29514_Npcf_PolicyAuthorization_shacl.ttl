@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "MOST_RECENT"^^xsd:string "LEAST_RECENT"^^xsd:string "HIGHEST_BW"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:PreemptionControlInformation .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29514_Npcf_PolicyAuthorization:EventsNotification ;
            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization:evsNotif ],
        [ a sh:PropertyShape ;
            sh:class TS29514_Npcf_PolicyAuthorization:AppSessionContextReqData ;
            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization:ascReqData ],
        [ a sh:PropertyShape ;
            sh:class TS29514_Npcf_PolicyAuthorization:AppSessionContextRespData ;
            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization:ascRespData ] ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:AppSessionContext .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "PRIO_1"^^xsd:string "PRIO_2"^^xsd:string "PRIO_3"^^xsd:string "PRIO_4"^^xsd:string "PRIO_5"^^xsd:string "PRIO_6"^^xsd:string "PRIO_7"^^xsd:string "PRIO_8"^^xsd:string "PRIO_9"^^xsd:string "PRIO_10"^^xsd:string "PRIO_11"^^xsd:string "PRIO_12"^^xsd:string "PRIO_13"^^xsd:string "PRIO_14"^^xsd:string "PRIO_15"^^xsd:string "PRIO_16"^^xsd:string ) ] [ a sh:NodeShape ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29514_Npcf_PolicyAuthorization:ReservPriority .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29514_Npcf_PolicyAuthorization:EthFlowDescription ;
            sh:maxCount 2 ;
            sh:minCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization:ethfDescs ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization:marBwDl ;
            sh:pattern "^\\d+(\\.\\d+)? (bps|Kbps|Mbps|Gbps|Tbps)$" ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization:tosTrCl ],
        [ a sh:PropertyShape ;
            sh:class TS29512_Npcf_SMPolicyControl:AfSigProtocol ;
            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization:afSigProtocol ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29514_Npcf_PolicyAuthorization:marBwUl ;
            sh:pattern "^\\d+(\\.\\d+)? (bps|Kbps|Mbps|Gbps|Tbps)$" ],
        [ a sh:PropertyShape ;
