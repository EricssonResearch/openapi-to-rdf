[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28623_MnSRegistryNrm:MnsRegistry_Single ;
            sh:maxCount 1 ;
            sh:path TS28623_MnSRegistryNrm_SubNetwork_ncO_MnSRegistryNrm:MnsRegistry ] ;
    sh:targetClass TS28623_MnSRegistryNrm:SubNetwork_ncO_MnSRegistryNrm .

[] a sh:NodeShape ;
    sh:targetClass TS28623_MnSRegistryNrm:resources_mnSRegistryNrm ;
    sh:xone ( [ a sh:NodeShape ;
                sh:class TS28623_MnSRegistryNrm:MnsInfo_Single ] [ a sh:NodeShape ;
                sh:class TS28623_MnSRegistryNrm:MnsRegistry_Single ] ) .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28623_MnSRegistryNrm:MnsInfo_Single ;
            sh:path TS28623_MnSRegistryNrm_MnsRegistry_Single:MnsInfo ] ;
    sh:targetClass TS28623_MnSRegistryNrm:MnsRegistry_Single .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:targetClass TS28623_MnSRegistryNrm:MnsRegistry_Single .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_MnSRegistryNrm_MnsInfo_Single:mnsVersion ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_MnSRegistryNrm_MnsInfo_Single:mnsLabel ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28623_MnSRegistryNrm_MnsInfo_Single:mnsAddress ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "PROV_MNS"^^xsd:string "FAULT_SUPERVISION_MNS"^^xsd:string "STREAMING_DATA_REPORTING_MNS"^^xsd:string "FILE_DATA_REPORTING_MNS"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28623_MnSRegistryNrm_MnsInfo_Single:mnsType ],
        [ a sh:PropertyShape ;
            rdfs:comment "List of the managed object instances that can be accessed using the MnS. If a complete SubNetwork can be accessed using the MnS, this attribute may  contain the DN of the SubNetwork instead of the DNs of the individual managed  entities within the SubNetwork." ;
            sh:datatype xsd:string ;
            sh:path TS28623_MnSRegistryNrm_MnsInfo_Single:mnsScope ] ;
