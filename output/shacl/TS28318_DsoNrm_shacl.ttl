            sh:maxCount 1 ;
            sh:path TS28318_DsoNrm_OutageAndRecoveryInfo_Single:affectedArea ] ;
    sh:targetClass TS28318_DsoNrm:OutageAndRecoveryInfo_Single .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28623_ComDefs:AreaOfInterest ;
            sh:maxCount 1 ;
            sh:path TS28318_DsoNrm_DsoThresholdMonitor_Single:targetThresholdLocation ] ;
    sh:targetClass TS28318_DsoNrm:DsoThresholdMonitor_Single .

