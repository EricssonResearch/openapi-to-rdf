[] a sh:NodeShape ;
    sh:targetClass TS28318_DsoNrm:resources_DSORecovery ;
    sh:xone ( [ a sh:NodeShape ;
                sh:class TS28318_DsoNrm:OutageAndRecoveryInfo_Single ] [ a sh:NodeShape ;
                sh:class TS28318_DsoNrm:DsoThresholdMonitor_Single ] ) .

[] a sh:NodeShape ;
    sh:class TS28318_DsoNrm:OutageAndRecoveryInfo_Single ;
    sh:targetClass TS28318_DsoNrm:OutageAndRecoveryInfo_Multiple .

[] a sh:NodeShape ;
    sh:class TS28623_ThresholdMonitorNrm:ThresholdMonitor_Single ;
    sh:targetClass TS28318_DsoNrm:DsoThresholdMonitor_Single .

[] a sh:NodeShape ;
    sh:class TS28318_DsoNrm:DsoThresholdMonitor_Single ;
    sh:targetClass TS28318_DsoNrm:DsoThresholdMonitor_Multiple .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS28318_DsoNrm:DsoThresholdMonitor_Single ;
            sh:path TS28318_DsoNrm_SubNetwork_ncO_DsoNrm:DsoThresholdMonitor ],
        [ a sh:PropertyShape ;
            sh:class TS28318_DsoNrm:OutageAndRecoveryInfo_Single ;
            sh:path TS28318_DsoNrm_SubNetwork_ncO_DsoNrm:OutageAndRecoveryInfo ] ;
    sh:targetClass TS28318_DsoNrm:SubNetwork_ncO_DsoNrm .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28318_DsoNrm_EnergyServiceLocation:CGI ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28318_DsoNrm_EnergyServiceLocation:energySupplyId ] ;
    sh:targetClass TS28318_DsoNrm:EnergyServiceLocation .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:targetClass TS28318_DsoNrm:OutageAndRecoveryInfo_Single .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS28318_DsoNrm_OutageAndRecoveryInfo_Single:dsoRapidInterventionDuration ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28318_DsoNrm_OutageAndRecoveryInfo_Single:outageStartTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS28318_DsoNrm_OutageAndRecoveryInfo_Single:mnoInterventionDuration ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28318_DsoNrm_OutageAndRecoveryInfo_Single:dsoRapidInterventionTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS28318_DsoNrm_OutageAndRecoveryInfo_Single:isAffectedAreaPriority ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28318_DsoNrm_OutageAndRecoveryInfo_Single:expectedOutageEndTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28318_DsoNrm_OutageAndRecoveryInfo_Single:actualOutageEndTime ],
        [ a sh:PropertyShape ;
