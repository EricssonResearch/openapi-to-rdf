            sh:maxCount 1 ;
            sh:path TS28318_DsoNrm_OutageAndRecoveryInfo_Single:mnoMaxServiceDuration ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28318_DsoNrm_OutageAndRecoveryInfo_Single:mnoInterventionTime ],
        [ a sh:PropertyShape ;
