[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "DL"^^xsd:string "UL"^^xsd:string "SUL"^^xsd:string ) ;
    sh:targetClass TS28541_NrNrm:BwpContext .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:maxCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ a sh:PropertyShape ;
                                    sh:datatype xsd:boolean ;
                                    sh:maxCount 1 ;
                                    sh:path TS28541_NrNrm:dlboControl ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:integer ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 20 ;
                                    sh:minInclusive -20 ;
                                    sh:path TS28541_NrNrm:maximumDeviationHoTrigger ],
                                [ a sh:PropertyShape ;
                                    rdfs:comment "This datatype is used for readOnly attribute" ;
                                    sh:maxCount 1 ;
                                    sh:path TS28541_NrNrm:aIMLInferenceFunctionRefList ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:integer ;
                                    sh:maxCount 1 ;
                                    sh:maxInclusive 604800 ;
                                    sh:minInclusive 0 ;
                                    sh:path TS28541_NrNrm:minimumTimeBetweenHoTriggerChange ],
                                [ a sh:PropertyShape ;
                                    rdfs:comment "This datatype is used for readOnly attribute" ;
                                    sh:maxCount 1 ;
                                    sh:path TS28541_NrNrm:mLModelRefList ] ] ;
                    sh:path TS28541_NrNrm:attributes ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:path TS28541_NrNrm:dlboControl ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:integer ;
                            sh:maxCount 1 ;
                            sh:maxInclusive 604800 ;
                            sh:minInclusive 0 ;
                            sh:path TS28541_NrNrm:minimumTimeBetweenHoTriggerChange ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:integer ;
                            sh:maxCount 1 ;
                            sh:maxInclusive 20 ;
                            sh:minInclusive -20 ;
                            sh:path TS28541_NrNrm:maximumDeviationHoTrigger ],
                        [ a sh:PropertyShape ;
                            rdfs:comment "This datatype is used for readOnly attribute" ;
                            sh:maxCount 1 ;
                            sh:path TS28541_NrNrm:aIMLInferenceFunctionRefList ],
                        [ a sh:PropertyShape ;
                            rdfs:comment "This datatype is used for readOnly attribute" ;
                            sh:maxCount 1 ;
                            sh:path TS28541_NrNrm:mLModelRefList ] ] ;
            sh:path TS28541_NrNrm_DLBOFunction-Single:attributes ] ;
    sh:targetClass TS28541_NrNrm:DLBOFunction-Single .

