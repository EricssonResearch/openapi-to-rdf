@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spec: <https://example.com/ontology/x/rdf/spec#> .
@prefix spec_A: <https://example.com/ontology/x/rdf/spec/A#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spec_A:id ] ;
    sh:targetClass spec:A .

