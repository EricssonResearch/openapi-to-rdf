@prefix TS28104_MdaReport: <http://ericsson.com/models/3gpp/TS28104/MdaReport#> .
@prefix TS28104_MdaReport_MDAOutputEntry: <http://ericsson.com/models/3gpp/TS28104/MdaReport/MDAOutputEntry#> .
@prefix TS28104_MdaReport_MDAOutputs: <http://ericsson.com/models/3gpp/TS28104/MdaReport/MDAOutputs#> .
@prefix TS28104_MdaReport_MDAReport: <http://ericsson.com/models/3gpp/TS28104/MdaReport/MDAReport#> .
@prefix TS28104_MdaReport_TimeWindow: <http://ericsson.com/models/3gpp/TS28104/MdaReport/TimeWindow#> .
@prefix TS28623_GenericNrm: <http://ericsson.com/models/3gpp/TS28623/GenericNrm#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28104_MdaReport:mDARequestRef ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28104_MdaReport:mDAReportID ],
                        [ a sh:PropertyShape ;
                            sh:class TS28104_MdaReport:MDAOutputs ;
                            sh:maxCount 1 ;
                            sh:path TS28104_MdaReport:mDAOutputs ] ] ;
            sh:path TS28104_MdaReport_MDAReport:attributes ] ;
    sh:targetClass TS28104_MdaReport:MDAReport .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28104_MdaReport_TimeWindow:mDAOutputEndTime ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28104_MdaReport_TimeWindow:mDAOutputStartTime ] ;
    sh:targetClass TS28104_MdaReport:TimeWindow .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28104_MdaReport_MDAOutputs:mDAType ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:path TS28104_MdaReport_MDAOutputs:confidenceDegree ],
        [ a sh:PropertyShape ;
            sh:class TS28104_MdaReport:TimeWindow ;
            sh:maxCount 1 ;
            sh:path TS28104_MdaReport_MDAOutputs:analyticsWindow ],
        [ a sh:PropertyShape ;
            sh:class TS28104_MdaReport:MDAOutputEntry ;
            sh:path TS28104_MdaReport_MDAOutputs:mDAOutputList ] ;
    sh:targetClass TS28104_MdaReport:MDAOutputs .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:targetClass TS28104_MdaReport:MDAReport .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path TS28104_MdaReport_MDAOutputEntry:mDAOutputIEValue ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28104_MdaReport_MDAOutputEntry:mDAOutputIEName ] ;
    sh:targetClass TS28104_MdaReport:MDAOutputEntry .

