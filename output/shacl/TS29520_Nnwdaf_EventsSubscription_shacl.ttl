""" ;
                sh:datatype xsd:string ] ) ;
    sh:targetClass TS29520_Nnwdaf_EventsSubscription:NotificationMethod .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:ipv6Addrs ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
