        [ a sh:PropertyShape ;
            sh:class TS29520_Nnwdaf_EventsSubscription:TargetUeInformation ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:tgtUe ],
        [ a sh:PropertyShape ;
            rdfs:comment """Identification(s) of network slice to which the subscription applies. It corresponds to  snssais in the data model definition of 3GPP TS 29.520. 
""" ;
            sh:class TS29571_CommonData:Snssai ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:snssaia ],
        [ a sh:PropertyShape ;
            sh:class TS29520_Nnwdaf_EventsSubscription:NetworkPerfRequirement ;
