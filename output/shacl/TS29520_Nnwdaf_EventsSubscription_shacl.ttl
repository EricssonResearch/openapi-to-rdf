            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:ladnDnns ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
