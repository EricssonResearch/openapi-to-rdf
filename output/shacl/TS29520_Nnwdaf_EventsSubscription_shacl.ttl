            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:dnns ],
        [ a sh:PropertyShape ;
            sh:class TS29520_Nnwdaf_EventsSubscription:RedundantTransmissionExpReq ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:redTransReqs ],
        [ a sh:PropertyShape ;
            rdfs:comment """Indicates that the NWDAF shall report the corresponding network slice load level to the NF  service consumer where the load level of the network slice identified by snssais is  reached.
""" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:loadLevelThreshold ],
        [ a sh:PropertyShape ;
