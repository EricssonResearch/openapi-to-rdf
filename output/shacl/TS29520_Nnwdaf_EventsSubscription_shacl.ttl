            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:excepLevel ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:excepTrend ] ;
    sh:targetClass TS29520_Nnwdaf_EventsSubscription:Exception .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:producerId ],
