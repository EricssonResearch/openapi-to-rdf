    sh:targetClass TS29520_Nnwdaf_EventsSubscription:ExceptionTrend .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:perioTimeVariance ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:tsVariance ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:commDurVariance ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:confidence ],
        [ a sh:PropertyShape ;
            sh:class TS29520_Nnwdaf_EventsSubscription:AppListForUeComm ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:anaOfAppList ],
        [ a sh:PropertyShape ;
            sh:class TS29520_Nnwdaf_EventsSubscription:SessInactTimerForUeComm ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:sessInactTimer ],
        [ a sh:PropertyShape ;
