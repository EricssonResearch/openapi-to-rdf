            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:maxTopAppDlNbr ],
        [ a sh:PropertyShape ;
            sh:class TS29520_Nnwdaf_EventsSubscription:RatFreqInformation ;
