    sh:targetClass TS29520_Nnwdaf_EventsSubscription:AnalyticsContextIdentifier .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:endTs ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:startTs ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:maxObjectNbr ],
        [ a sh:PropertyShape ;
            rdfs:comment """Offset period in units of seconds to the reporting time, if the value is negative means  statistics in the past offset period, otherwise a positive value means prediction in the  future offset period. May be present if the "repPeriod" attribute is included within the  "evtReq" attribute.
""" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:offsetPeriod ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minInclusive 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:sampRatio ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:accuracy ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:anaMeta ],
        [ a sh:PropertyShape ;
            rdfs:comment """Each element indicates the preferred accuracy level per analytics subset. It may be present if the "listOfAnaSubsets" attribute is present in the subscription request when the subscription event is NF_LOAD, UE_COMM, DISPERSION, NETWORK_PERFORMANCE, WLAN_PERFORMANCE, DN_PERFORMANCE or SERVICE_EXPERIENCE.
