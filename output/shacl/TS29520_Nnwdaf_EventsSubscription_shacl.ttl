[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:comment """Subscription ID which was allocated by the source NWDAF. This parameter shall be present if the notification is for informing the assignment of a new Subscription Id by the target NWDAF.
