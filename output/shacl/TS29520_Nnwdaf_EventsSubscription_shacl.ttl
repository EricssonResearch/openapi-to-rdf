    sh:targetClass TS29520_Nnwdaf_EventsSubscription:EventSubscription .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class TS29514_Npcf_PolicyAuthorization:EthFlowDescription ;
