        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:maxSupiNbr ] ;
    sh:targetClass TS29520_Nnwdaf_EventsSubscription:EventReportingRequirement .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "PREPARE"^^xsd:string "TRANSFER"^^xsd:string ) ] [ a sh:NodeShape ;
