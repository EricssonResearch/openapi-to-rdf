            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:dnais ],
        [ a sh:PropertyShape ;
            sh:class TS29520_Nnwdaf_EventsSubscription:DnPerformanceReq ;
            sh:minCount 1 ;
