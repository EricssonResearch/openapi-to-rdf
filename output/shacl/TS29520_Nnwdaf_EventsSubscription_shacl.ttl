        [ a sh:PropertyShape ;
            sh:class TS29520_Nnwdaf_EventsSubscription:UeAnalyticsContextDescriptor ;
            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:ueAnaEvents ] ;
    sh:targetClass TS29520_Nnwdaf_EventsSubscription:PrevSubInfo .

[] a sh:NodeShape ;
    sh:or ( [ a sh:NodeShape ;
                sh:datatype xsd:string ;
                sh:in ( "UP"^^xsd:string "DOWN"^^xsd:string "UNKNOW"^^xsd:string "STABLE"^^xsd:string ) ] [ a sh:NodeShape ;
                rdfs:comment """This string provides forward-compatibility with future extensions to the enumeration but is not used to encode content defined in the present version of this API.
