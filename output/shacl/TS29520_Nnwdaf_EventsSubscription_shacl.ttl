            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:ts ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:perioCommInd ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minInclusive 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:ratio ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:perioTime ],
        [ a sh:PropertyShape ;
