            sh:minCount 1 ;
            sh:path TS29520_Nnwdaf_EventsSubscription:eventNotifications ],
        [ a sh:PropertyShape ;
            rdfs:comment "String identifying a subscription to the Nnwdaf_EventsSubscription Service" ;
            sh:datatype xsd:string ;
