@prefix IdentityProbe: <http://ericsson.com/models/3gpp/rdf/IdentityProbe#> .
@prefix IdentityProbe_Base: <http://ericsson.com/models/3gpp/rdf/IdentityProbe/Base#> .
@prefix IdentityProbe_Dashes: <http://ericsson.com/models/3gpp/rdf/IdentityProbe/Dashes#> .
@prefix IdentityProbe_Files-Single: <http://ericsson.com/models/3gpp/rdf/IdentityProbe/Files-Single#> .
@prefix IdentityProbe_Files_Single: <http://ericsson.com/models/3gpp/rdf/IdentityProbe/Files_Single#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path IdentityProbe_Base:href ] ;
    sh:targetClass IdentityProbe:Base .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path IdentityProbe_Dashes:my-prop ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path IdentityProbe_Dashes:my_prop ] ;
    sh:targetClass IdentityProbe:Dashes .

[] a sh:NodeShape ;
    sh:class IdentityProbe:Base ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:path IdentityProbe:href ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path IdentityProbe_Base:href ] ;
    sh:targetClass IdentityProbe:Child .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path IdentityProbe_Files-Single:a ] ;
    sh:targetClass IdentityProbe:Files-Single .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path IdentityProbe_Files_Single:b ] ;
    sh:targetClass IdentityProbe:Files_Single .

