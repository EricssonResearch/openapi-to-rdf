@prefix TS28532_PerfMnS: <http://ericsson.com/models/3gpp/TS28532/PerfMnS#> .
@prefix TS28532_PerfMnS_NotifyThresholdCrossing: <http://ericsson.com/models/3gpp/TS28532/PerfMnS/NotifyThresholdCrossing#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:NodeShape ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:datatype xsd:string ;
                    sh:in ( "UP"^^xsd:string "DOWN"^^xsd:string ) ;
                    sh:maxCount 1 ;
                    sh:path TS28532_PerfMnS:observedPerfMetricDirection ],
                [ a sh:PropertyShape ;
                    rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
                    sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:path TS28532_PerfMnS:thresholdValue ],
                [ a sh:PropertyShape ;
                    rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
                    sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:path TS28532_PerfMnS:hysteresis ],
                [ a sh:PropertyShape ;
                    rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
                    sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:path TS28532_PerfMnS:observedPerfMetricValue ],
                [ a sh:PropertyShape ;
                    sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:path TS28532_PerfMnS:additionalText ],
                [ a sh:PropertyShape ;
                    sh:datatype xsd:integer ;
                    sh:maxCount 1 ;
                    sh:path TS28532_PerfMnS:monitorGranularityPeriod ],
                [ a sh:PropertyShape ;
                    sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:path TS28532_PerfMnS:observedPerfMetricName ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_PerfMnS_NotifyThresholdCrossing:observedPerfMetricName ],
        [ a sh:PropertyShape ;
            rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS28532_PerfMnS_NotifyThresholdCrossing:observedPerfMetricValue ],
        [ a sh:PropertyShape ;
            rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS28532_PerfMnS_NotifyThresholdCrossing:thresholdValue ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS28532_PerfMnS_NotifyThresholdCrossing:monitorGranularityPeriod ],
        [ a sh:PropertyShape ;
            rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path TS28532_PerfMnS_NotifyThresholdCrossing:hysteresis ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28532_PerfMnS_NotifyThresholdCrossing:additionalText ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "UP"^^xsd:string "DOWN"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28532_PerfMnS_NotifyThresholdCrossing:observedPerfMetricDirection ] ;
    sh:targetClass TS28532_PerfMnS:NotifyThresholdCrossing .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "notifyThresholdCrossing"^^xsd:string ) ;
    sh:targetClass TS28532_PerfMnS:PerfNotificationTypes .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "UP"^^xsd:string "DOWN"^^xsd:string ) ;
    sh:targetClass TS28532_PerfMnS:PerfMetricDirection .

