                    sh:maxCount 1 ;
                    sh:path TS28111_FaultNrm:trendIndication ],
                [ a sh:PropertyShape ;
                    sh:class TS28623_ComDefs:AttributeNameValuePairSet ;
                    sh:maxCount 1 ;
                    sh:path TS28111_FaultNrm:changedAlarmAttributes ],
                [ a sh:PropertyShape ;
                    sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:path TS28111_FaultNrm:backUpObject ],
                [ a sh:PropertyShape ;
                    sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path TS28111_FaultNrm:alarmId ],
                [ a sh:PropertyShape ;
                    sh:class TS28623_ComDefs:AttributeNameValuePairSet ;
                    sh:maxCount 1 ;
                    sh:path TS28111_FaultNrm:monitoredAttributes ],
                [ a sh:PropertyShape ;
                    sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:path TS28111_FaultNrm:rootCauseIndicator ],
                [ a sh:PropertyShape ;
                    sh:datatype xsd:string ;
                    sh:in ( "COMMUNICATIONS_ALARM"^^xsd:string "QUALITY_OF_SERVICE_ALARM"^^xsd:string "PROCESSING_ERROR_ALARM"^^xsd:string "EQUIPMENT_ALARM"^^xsd:string "ENVIRONMENTAL_ALARM"^^xsd:string "INTEGRITY_VIOLATION"^^xsd:string "OPERATIONAL_VIOLATION"^^xsd:string "PHYSICAL_VIOLATION"^^xsd:string "SECURITY_SERVICE_OR_MECHANISM_VIOLATION"^^xsd:string "TIME_DOMAIN_VIOLATION"^^xsd:string ) ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path TS28111_FaultNrm:alarmType ],
                [ a sh:PropertyShape ;
                    sh:datatype xsd:boolean ;
                    sh:maxCount 1 ;
                    sh:path TS28111_FaultNrm:backedUpStatus ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path TS28111_FaultNrm_NotifyChangedAlarmGeneral:proposedRepairActions ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
