[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "ALIGNMENT_REQUIRED"^^xsd:string "ALIGNMENT_NOT_REQUIRED"^^xsd:string ) ;
    sh:targetClass TS28111_FaultNrm:AlarmListAlignmentRequirement .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "COMMUNICATIONS_ALARM"^^xsd:string "QUALITY_OF_SERVICE_ALARM"^^xsd:string "PROCESSING_ERROR_ALARM"^^xsd:string "EQUIPMENT_ALARM"^^xsd:string "ENVIRONMENTAL_ALARM"^^xsd:string "INTEGRITY_VIOLATION"^^xsd:string "OPERATIONAL_VIOLATION"^^xsd:string "PHYSICAL_VIOLATION"^^xsd:string "SECURITY_SERVICE_OR_MECHANISM_VIOLATION"^^xsd:string "TIME_DOMAIN_VIOLATION"^^xsd:string ) ;
    sh:targetClass TS28111_FaultNrm:AlarmType .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28111_FaultNrm_ThresholdInfo:observedMeasurement ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28111_FaultNrm_ThresholdInfo:observedValue ],
        [ a sh:PropertyShape ;
            rdfs:comment "Note: Uses OpenAPI oneOf - complex logical constraints partially supported in SHACL" ;
            sh:maxCount 1 ;
            sh:path TS28111_FaultNrm_ThresholdInfo:thresholdLevel ;
            sh:xone ( [ a sh:NodeShape ;
                        sh:property [ a sh:PropertyShape ;
                                sh:class TS28111_FaultNrm:ThresholdHysteresis ;
                                sh:path TS28111_FaultNrm:up ] ] [ a sh:NodeShape ;
                        sh:property [ a sh:PropertyShape ;
                                sh:class TS28111_FaultNrm:ThresholdHysteresis ;
                                sh:path TS28111_FaultNrm:down ] ] ) ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path TS28111_FaultNrm_ThresholdInfo:armTime ] ;
    sh:targetClass TS28111_FaultNrm:ThresholdInfo .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "ACKNOWLEDGED"^^xsd:string "UNACKNOWLEDGED"^^xsd:string ) ;
    sh:targetClass TS28111_FaultNrm:AckState .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28111_FaultNrm_CorrelatedNotification:sourceObjectInstance ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:minCount 1 ;
            sh:path TS28111_FaultNrm_CorrelatedNotification:notificationIds ] ;
    sh:targetClass TS28111_FaultNrm:CorrelatedNotification .

[] a sh:NodeShape ;
    sh:class TS28623_ComDefs:NotificationHeader ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:minCount 1 ;
                    sh:path TS28111_FaultNrm:reason ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28111_FaultNrm_NotifyPotentialFaultyAlarmList:reason ] ;
    sh:targetClass TS28111_FaultNrm:NotifyPotentialFaultyAlarmList .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "INDETERMINATE"^^xsd:string "CRITICAL"^^xsd:string "MAJOR"^^xsd:string "MINOR"^^xsd:string "WARNING"^^xsd:string "CLEARED"^^xsd:string ) ;
    sh:targetClass TS28111_FaultNrm:PerceivedSeverity .

[] a sh:NodeShape ;
    sh:class TS28623_GenericNrm:Top ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:maxCount 1 ;
                    sh:node [ a sh:NodeShape ;
                            sh:property [ a sh:PropertyShape ;
                                    sh:maxCount 1 ;
                                    sh:node [ a sh:NodeShape ] ;
                                    sh:path TS28111_FaultNrm:alarmRecords ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:integer ;
                                    sh:maxCount 1 ;
                                    sh:path TS28111_FaultNrm:numOfAlarmRecords ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:maxCount 1 ;
                                    sh:path TS28111_FaultNrm:unreliableAlarmScope ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:in ( "LOCKED"^^xsd:string "UNLOCKED"^^xsd:string ) ;
                                    sh:maxCount 1 ;
                                    sh:path TS28111_FaultNrm:administrativeState ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:dateTime ;
                                    sh:maxCount 1 ;
                                    sh:path TS28111_FaultNrm:lastModification ],
                                [ a sh:PropertyShape ;
                                    sh:datatype xsd:string ;
                                    sh:in ( "ENABLED"^^xsd:string "DISABLED"^^xsd:string ) ;
                                    sh:maxCount 1 ;
                                    sh:path TS28111_FaultNrm:operationalState ] ] ;
                    sh:path TS28111_FaultNrm:attributes ] ] ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:node [ a sh:NodeShape ;
                    sh:property [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:in ( "LOCKED"^^xsd:string "UNLOCKED"^^xsd:string ) ;
                            sh:maxCount 1 ;
                            sh:path TS28111_FaultNrm:administrativeState ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:dateTime ;
                            sh:maxCount 1 ;
                            sh:path TS28111_FaultNrm:lastModification ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:integer ;
                            sh:maxCount 1 ;
                            sh:path TS28111_FaultNrm:numOfAlarmRecords ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:in ( "ENABLED"^^xsd:string "DISABLED"^^xsd:string ) ;
                            sh:maxCount 1 ;
                            sh:path TS28111_FaultNrm:operationalState ],
                        [ a sh:PropertyShape ;
                            sh:maxCount 1 ;
                            sh:node [ a sh:NodeShape ] ;
                            sh:path TS28111_FaultNrm:alarmRecords ],
                        [ a sh:PropertyShape ;
                            sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:path TS28111_FaultNrm:unreliableAlarmScope ] ] ;
            sh:path TS28111_FaultNrm_AlarmList-Single:attributes ] ;
    sh:targetClass TS28111_FaultNrm:AlarmList-Single .

[] a sh:NodeShape ;
    sh:targetClass TS28111_FaultNrm:Comments .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path TS28111_FaultNrm_ThresholdHysteresis:high ;
            sh:xone ( [ a sh:NodeShape ;
                        sh:datatype xsd:integer ] [ a sh:NodeShape ;
                        sh:datatype xsd:float ] ) ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:path TS28111_FaultNrm_ThresholdHysteresis:low ] ;
    sh:targetClass TS28111_FaultNrm:ThresholdHysteresis .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:targetClass TS28111_FaultNrm:AlarmId .

[] a sh:NodeShape ;
    sh:datatype xsd:string ;
    sh:in ( "MORE_SEVERE"^^xsd:string "NO_CHANGE"^^xsd:string "LESS_SEVERE"^^xsd:string ) ;
    sh:targetClass TS28111_FaultNrm:TrendIndication .

[] a sh:NodeShape ;
    sh:class TS28623_ComDefs:NotificationHeader ;
    sh:node [ a sh:NodeShape ;
            sh:property [ a sh:PropertyShape ;
                    sh:datatype xsd:string ;
                    sh:maxCount 1 ;
                    sh:path TS28111_FaultNrm:additionalText ],
                [ a sh:PropertyShape ;
                    sh:class TS28111_FaultNrm:CorrelatedNotification ;
                    sh:path TS28111_FaultNrm:correlatedNotifications ],
                [ a sh:PropertyShape ;
                    rdfs:comment "The first array item contains the attribute name value pairs with the new values, and the second array item the attribute name value pairs with the optional old values." ;
                    sh:maxCount 1,
