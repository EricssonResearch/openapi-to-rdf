                                    sh:datatype xsd:string ] ) ] ) ;
            sh:path TS28111_FaultNrm_NotifyChangedAlarmGeneral:probableCause ],
        [ a sh:PropertyShape ;
            sh:class TS28111_FaultNrm:CorrelatedNotification ;
            sh:path TS28111_FaultNrm_NotifyChangedAlarmGeneral:correlatedNotifications ] ;
    sh:targetClass TS28111_FaultNrm:NotifyChangedAlarmGeneral .

