            sh:maxCount 1 ;
            sh:path TS28111_FaultNrm_NotifyChangedAlarmGeneral:additionalText ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "MORE_SEVERE"^^xsd:string "NO_CHANGE"^^xsd:string "LESS_SEVERE"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:path TS28111_FaultNrm_NotifyChangedAlarmGeneral:trendIndication ],
        [ a sh:PropertyShape ;
            sh:class TS28623_ComDefs:AttributeNameValuePairSet ;
            sh:maxCount 1 ;
            sh:path TS28111_FaultNrm_NotifyChangedAlarmGeneral:additionalInformation ],
        [ a sh:PropertyShape ;
            sh:class TS28623_ComDefs:AttributeNameValuePairSet ;
            sh:maxCount 1 ;
            sh:path TS28111_FaultNrm_NotifyChangedAlarmGeneral:monitoredAttributes ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "COMMUNICATIONS_ALARM"^^xsd:string "QUALITY_OF_SERVICE_ALARM"^^xsd:string "PROCESSING_ERROR_ALARM"^^xsd:string "EQUIPMENT_ALARM"^^xsd:string "ENVIRONMENTAL_ALARM"^^xsd:string "INTEGRITY_VIOLATION"^^xsd:string "OPERATIONAL_VIOLATION"^^xsd:string "PHYSICAL_VIOLATION"^^xsd:string "SECURITY_SERVICE_OR_MECHANISM_VIOLATION"^^xsd:string "TIME_DOMAIN_VIOLATION"^^xsd:string ) ;
            sh:maxCount 1 ;
