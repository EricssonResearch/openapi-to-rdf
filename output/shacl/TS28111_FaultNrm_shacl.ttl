                                            sh:in ( "PROBABLE_CAUSE_001"^^xsd:string "PROBABLE_CAUSE_002"^^xsd:string "PROBABLE_CAUSE_003"^^xsd:string "PROBABLE_CAUSE_004"^^xsd:string "PROBABLE_CAUSE_005"^^xsd:string ) ] [ a sh:NodeShape ;
                                            sh:datatype xsd:string ] ) ] ) ;
                    sh:path TS28111_FaultNrm:probableCause ],
