    sh:in ( "Upgrade"^^xsd:string ) ;
    sh:targetClass TS28532_StreamingDataMnS:websocketHeaderConnection_Type .

[] a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:in ( "TRACE"^^xsd:string "PERFORMANCE"^^xsd:string "ANALYTICS"^^xsd:string "PROPRIETARY"^^xsd:string ) ;
