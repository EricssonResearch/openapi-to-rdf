@prefix TS28541_SliceNrm: <https://example.org/TS28541_SliceNrm/> .
@prefix ns1: <https://example.org/TS28541_SliceNrm/DeterministicComm#> .
@prefix ns2: <https://example.org/TS28541_SliceNrm/ServAttrCom#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28541_SliceNrm:test_instance a TS28541_SliceNrm:DeterministicComm ;
    ns1:availability "NOT_SUPPORTED"^^xsd:string ;
    ns1:periodicityList 50 ;
    ns1:servAttrCom [ a TS28541_SliceNrm:ServAttrCom ;
            ns2:category "CHARACTER"^^xsd:string ;
            ns2:exposure "API"^^xsd:string ;
            ns2:tagging "PERFORMANCE"^^xsd:string ] .

