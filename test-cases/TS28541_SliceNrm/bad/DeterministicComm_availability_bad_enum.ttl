@prefix TS28541_SliceNrm: <https://example.org/TS28541_SliceNrm/> .
@prefix ns1: <https://example.org/TS28541_SliceNrm/ServAttrCom#> .
@prefix ns2: <https://example.org/TS28541_SliceNrm/DeterministicComm#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28541_SliceNrm:test_instance a TS28541_SliceNrm:DeterministicComm ;
    ns2:availability "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    ns2:periodicityList 50 ;
    ns2:servAttrCom [ a TS28541_SliceNrm:ServAttrCom ;
            ns1:category "CHARACTER"^^xsd:string ;
            ns1:exposure "API"^^xsd:string ;
            ns1:tagging "PERFORMANCE"^^xsd:string ] .

