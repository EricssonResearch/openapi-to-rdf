@prefix TS28312_IntentExpectations: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations/LowSINRRatioTarget#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations/LowSINRContext#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:LowSINRRatioTarget ;
    TS28312_IntentExpectations:targetCondition "IS_LESS_THAN"^^xsd:string ;
    TS28312_IntentExpectations:targetName "LowSINRRatio"^^xsd:string ;
    TS28312_IntentExpectations:targetValueRange 101 ;
    ns1:targetContexts [ a TS28312_IntentExpectations:LowSINRContext ;
            TS28312_IntentExpectations:contextAttribute "LowSINRThreshold"^^xsd:string ;
            TS28312_IntentExpectations:contextCondition "IS_LESS_THAN"^^xsd:string ;
            ns2:contextValueRange 50 ] .

