@prefix TS28312_IntentExpectations: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations/LowDLRANUEThptRatioTarget#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:LowDLRANUEThptRatioTarget ;
    TS28312_IntentExpectations:targetCondition "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    TS28312_IntentExpectations:targetName "LowDLRANUEThptRatio"^^xsd:string ;
    TS28312_IntentExpectations:targetValueRange 50 ;
    ns1:targetContexts [ a TS28312_IntentExpectations:LowDLRANUEThptContext ;
            TS28312_IntentExpectations:contextAttribute "LowDLRANUEThptThreshold"^^xsd:string ;
            TS28312_IntentExpectations:contextCondition "IS_LESS_THAN"^^xsd:string ;
            TS28312_IntentExpectations:contextValueRange 5e+01 ] .

