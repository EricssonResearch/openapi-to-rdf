@prefix TS28312_IntentExpectations: <https://example.org/TS28312_IntentExpectations/> .
@prefix ns1: <https://example.org/TS28312_IntentExpectations/LowULRANUEThptContext/> .
@prefix ns2: <https://example.org/TS28312_IntentExpectations/LowULRANUEThptRatioTarget/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:LowULRANUEThptRatioTarget ;
    ns2:targetCondition "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    ns2:targetContexts [ a TS28312_IntentExpectations:LowULRANUEThptContext ;
            ns1:contextAttribute "LowULRANUEThptThreshold"^^xsd:string ;
            ns1:contextCondition "Is_less_than"^^xsd:string ;
            ns1:contextValueRange 5e+01 ] ;
    ns2:targetName "LowULRANUEThptRatio"^^xsd:string ;
    ns2:targetValueRange 50 .

