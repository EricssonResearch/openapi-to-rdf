@prefix TS28312_IntentExpectations: <https://example.org/TS28312_IntentExpectations/> .
@prefix ns1: <https://example.org/TS28312_IntentExpectations/HighDLPrbLoadRatioTarget/> .
@prefix ns2: <https://example.org/TS28312_IntentExpectations/HighDLPrbLoadContext/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:HighDLPrbLoadRatioTarget ;
    ns1:targetCondition "IS_LESS_THAN"^^xsd:string ;
    ns1:targetContexts [ a TS28312_IntentExpectations:HighDLPrbLoadContext ;
            ns2:contextAttribute "HighDLPrbLoadThreshold"^^xsd:string ;
            ns2:contextCondition "IS_LESS_THAN"^^xsd:string ;
            ns2:contextValueRange 50 ] ;
    ns1:targetName "HighDLPrbLoadRatio"^^xsd:string ;
    ns1:targetValueRange 101 .

