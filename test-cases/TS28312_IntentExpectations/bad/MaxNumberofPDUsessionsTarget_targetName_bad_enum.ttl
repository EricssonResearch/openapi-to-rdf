@prefix TS28312_IntentExpectations: <https://example.org/TS28312_IntentExpectations/> .
@prefix ns1: <https://example.org/TS28312_IntentExpectations/MaxNumberofPDUsessionsTarget/> .
@prefix ns2: <https://example.org/TS28312_IntentExpectations/5GSessionContext/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:MaxNumberofPDUsessionsTarget ;
    ns1:targetCondition "IS_LESS_THAN"^^xsd:string ;
    ns1:targetContexts [ a TS28312_IntentExpectations:5GSessionContext ;
            ns2:contextAttribute "5GSession"^^xsd:string ;
            ns2:contextCondition "IS_less_THAN"^^xsd:string ;
            ns2:contextValueRange 50 ] ;
    ns1:targetName "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    ns1:targetValueRange 50 .

