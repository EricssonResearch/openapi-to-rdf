@prefix TS28312_IntentExpectations: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations/LowSINRContext#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:LowSINRContext ;
    TS28312_IntentExpectations:contextAttribute "LowSINRThreshold"^^xsd:string ;
    TS28312_IntentExpectations:contextCondition "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    ns1:contextValueRange 50 .

