@prefix TS28312_IntentExpectations: <https://example.org/TS28312_IntentExpectations/> .
@prefix ns1: <https://example.org/TS28312_IntentExpectations/ServingScopeContext/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:ServingScopeContext ;
    ns1:contextAttribute "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    ns1:contextCondition "IS_ALL_OF"^^xsd:string ;
    ns1:contextValueRange "test-value"^^xsd:string .

