@prefix TS28312_IntentExpectations: <https://example.org/TS28312_IntentExpectations/> .
@prefix ns1: <https://example.org/TS28312_IntentExpectations/LowULRANUEThptRatioTarget#> .
@prefix ns2: <https://example.org/TS28312_IntentExpectations/LowULRANUEThptContext#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:LowULRANUEThptRatioTarget ;
    ns1:targetCondition "IS_LESS_THAN"^^xsd:string ;
    ns1:targetContexts [ a TS28312_IntentExpectations:LowULRANUEThptContext ;
            ns2:contextAttribute "LowULRANUEThptThreshold"^^xsd:string ;
            ns2:contextCondition "Is_less_than"^^xsd:string ;
            ns2:contextValueRange 5e+01 ] ;
    ns1:targetName "LowULRANUEThptRatio"^^xsd:string ;
    ns1:targetValueRange 101 .

