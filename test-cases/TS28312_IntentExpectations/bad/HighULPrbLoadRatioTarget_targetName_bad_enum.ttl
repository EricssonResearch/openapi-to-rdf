@prefix TS28312_IntentExpectations: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations/HighULPrbLoadContext#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations/HighULPrbLoadRatioTarget#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:HighULPrbLoadRatioTarget ;
    ns2:targetCondition "IS_LESS_THAN"^^xsd:string ;
    ns2:targetContexts [ a TS28312_IntentExpectations:HighULPrbLoadContext ;
            ns1:contextAttribute "HighULPrbLoadThreshold"^^xsd:string ;
            ns1:contextCondition "IS_LESS_THAN"^^xsd:string ;
            ns1:contextValueRange 50 ] ;
    ns2:targetName "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    ns2:targetValueRange 50 .

