@prefix TS28312_IntentExpectations: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations/HighDLPrbLoadContext#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:HighDLPrbLoadContext ;
    ns1:contextAttribute "HighDLPrbLoadThreshold"^^xsd:string ;
    ns1:contextCondition "IS_LESS_THAN"^^xsd:string ;
    ns1:contextValueRange -1 .

