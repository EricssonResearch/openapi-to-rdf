@prefix TS28312_IntentExpectations: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:DLLatencyTarget ;
    TS28312_IntentExpectations:targetCondition "IS_LESS_THAN"^^xsd:string ;
    TS28312_IntentExpectations:targetName "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    TS28312_IntentExpectations:targetValueRange 50 .

