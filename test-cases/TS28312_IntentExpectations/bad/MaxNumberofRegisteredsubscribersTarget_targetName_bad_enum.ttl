@prefix TS28312_IntentExpectations: <https://example.org/TS28312_IntentExpectations/> .
@prefix ns1: <https://example.org/TS28312_IntentExpectations/MaxNumberofRegisteredsubscribersTarget#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:MaxNumberofRegisteredsubscribersTarget ;
    ns1:targetCondition "IS_LESS_THAN"^^xsd:string ;
    ns1:targetName "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    ns1:targetValueRange 50 .

