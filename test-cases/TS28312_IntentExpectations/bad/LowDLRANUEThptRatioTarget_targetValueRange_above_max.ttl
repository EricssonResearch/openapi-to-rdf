@prefix TS28312_IntentExpectations: <https://example.org/TS28312_IntentExpectations/> .
@prefix ns1: <https://example.org/TS28312_IntentExpectations/LowDLRANUEThptRatioTarget/> .
@prefix ns2: <https://example.org/TS28312_IntentExpectations/LowDLRANUEThptContext/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:LowDLRANUEThptRatioTarget ;
    ns1:targetCondition "IS_LESS_THAN"^^xsd:string ;
    ns1:targetContexts [ a TS28312_IntentExpectations:LowDLRANUEThptContext ;
            ns2:contextAttribute "LowDLRANUEThptThreshold"^^xsd:string ;
            ns2:contextCondition "IS_LESS_THAN"^^xsd:string ;
            ns2:contextValueRange 5e+01 ] ;
    ns1:targetName "LowDLRANUEThptRatio"^^xsd:string ;
    ns1:targetValueRange 101 .

