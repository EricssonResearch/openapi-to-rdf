@prefix TS28312_IntentExpectations: <https://example.org/TS28312_IntentExpectations/> .
@prefix ns1: <https://example.org/TS28312_IntentExpectations/WeakRSRPRatioTarget#> .
@prefix ns2: <https://example.org/TS28312_IntentExpectations/WeakRSRPContext#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:WeakRSRPRatioTarget ;
    ns1:targetCondition "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    ns1:targetContexts [ a TS28312_IntentExpectations:WeakRSRPContext ;
            ns2:contextAttribute "WeakRSRPThreshold"^^xsd:string ;
            ns2:contextCondition "IS_LESS_THAN"^^xsd:string ;
            ns2:contextValueRange 5e+01 ] ;
    ns1:targetName "WeakRSRPRatio"^^xsd:string ;
    ns1:targetValueRange 50 .

