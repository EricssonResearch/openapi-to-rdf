@prefix TS28312_IntentExpectations: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:WeakRSRPRatioTarget ;
    TS28312_IntentExpectations:targetCondition "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    TS28312_IntentExpectations:targetContexts [ a TS28312_IntentExpectations:WeakRSRPContext ;
            TS28312_IntentExpectations:contextAttribute "WeakRSRPThreshold"^^xsd:string ;
            TS28312_IntentExpectations:contextCondition "IS_LESS_THAN"^^xsd:string ;
            TS28312_IntentExpectations:contextValueRange 5e+01 ] ;
    TS28312_IntentExpectations:targetName "WeakRSRPRatio"^^xsd:string ;
    TS28312_IntentExpectations:targetValueRange 50 .

