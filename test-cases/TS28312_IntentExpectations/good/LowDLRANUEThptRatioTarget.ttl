@prefix TS28312_IntentExpectations: <https://example.org/TS28312_IntentExpectations/> .
@prefix ns1: <https://example.org/TS28312_IntentExpectations/LowDLRANUEThptContext#> .
@prefix ns2: <https://example.org/TS28312_IntentExpectations/LowDLRANUEThptRatioTarget#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:LowDLRANUEThptRatioTarget ;
    ns2:targetCondition "IS_LESS_THAN"^^xsd:string ;
    ns2:targetContexts [ a TS28312_IntentExpectations:LowDLRANUEThptContext ;
            ns1:contextAttribute "LowDLRANUEThptThreshold"^^xsd:string ;
            ns1:contextCondition "IS_LESS_THAN"^^xsd:string ;
            ns1:contextValueRange 5e+01 ] ;
    ns2:targetName "LowDLRANUEThptRatio"^^xsd:string ;
    ns2:targetValueRange 50 .

