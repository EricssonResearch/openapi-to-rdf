@prefix TS28312_IntentExpectations: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations/HighULPrbLoadRatioTarget#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations/HighULPrbLoadContext#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:HighULPrbLoadRatioTarget ;
    ns1:targetCondition "IS_LESS_THAN"^^xsd:string ;
    ns1:targetContexts [ a TS28312_IntentExpectations:HighULPrbLoadContext ;
            ns2:contextAttribute "HighULPrbLoadThreshold"^^xsd:string ;
            ns2:contextCondition "IS_LESS_THAN"^^xsd:string ;
            ns2:contextValueRange 50 ] ;
    ns1:targetName "HighULPrbLoadRatio"^^xsd:string ;
    ns1:targetValueRange 50 .

