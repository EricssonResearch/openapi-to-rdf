@prefix TS28312_IntentExpectations: <https://example.org/TS28312_IntentExpectations/> .
@prefix ns1: <https://example.org/TS28312_IntentExpectations/HighULPrbLoadContext#> .
@prefix ns2: <https://example.org/TS28312_IntentExpectations/HighULPrbLoadRatioTarget#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:HighULPrbLoadRatioTarget ;
    ns2:targetCondition "IS_LESS_THAN"^^xsd:string ;
    ns2:targetContexts [ a TS28312_IntentExpectations:HighULPrbLoadContext ;
            ns1:contextAttribute "HighULPrbLoadThreshold"^^xsd:string ;
            ns1:contextCondition "IS_LESS_THAN"^^xsd:string ;
            ns1:contextValueRange 50 ] ;
    ns2:targetName "HighULPrbLoadRatio"^^xsd:string ;
    ns2:targetValueRange 50 .

