@prefix TS28312_IntentExpectations: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28312/IntentExpectations/EdgeIdentificationIdContext#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:EdgeIdentificationIdContext ;
    ns1:contextAttribute "edgeIdentificationId"^^xsd:string ;
    ns1:contextCondition "IS_EQUAL_TO"^^xsd:string ;
    ns1:contextValueRange "test-value"^^xsd:string .

