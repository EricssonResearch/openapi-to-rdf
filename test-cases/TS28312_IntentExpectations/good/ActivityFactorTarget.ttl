@prefix TS28312_IntentExpectations: <https://example.org/TS28312_IntentExpectations/> .
@prefix ns1: <https://example.org/TS28312_IntentExpectations/ActivityFactorTarget/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentExpectations:test_instance a TS28312_IntentExpectations:ActivityFactorTarget ;
    ns1:targetCondition "IS_EQUAL_TO"^^xsd:string ;
    ns1:targetName "activityFactor"^^xsd:string ;
    ns1:targetValueRange 50 .

