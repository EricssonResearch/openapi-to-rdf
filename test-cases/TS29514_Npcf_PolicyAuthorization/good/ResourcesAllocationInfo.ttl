TS29514_Npcf_PolicyAuthorization:test_instance a TS29514_Npcf_PolicyAuthorization:ResourcesAllocationInfo ;
    ns2:altSerReq "test-value"^^xsd:string ;
    ns2:flows [ a TS29514_Npcf_PolicyAuthorization:Flows ;
            ns1:contVers 50 ;
            ns1:fNums 50 ;
            ns1:medCompN 50 ] ;
    ns2:mcResourcStatus "ACTIVE"^^xsd:string .

