    TS28550_PerfMeasJobCtrlMnS:iOCName "test-value"^^xsd:string ;
    TS28550_PerfMeasJobCtrlMnS:measurementCategoryList "test-value"^^xsd:string ;
    TS28550_PerfMeasJobCtrlMnS:priority "low"^^xsd:string ;
    TS28550_PerfMeasJobCtrlMnS:reliability "test-value"^^xsd:string ;
    TS28550_PerfMeasJobCtrlMnS:reportingMethod "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    TS28550_PerfMeasJobCtrlMnS:reportingPeriod 50 ;
    TS28550_PerfMeasJobCtrlMnS:schedule [ a TS28550_PerfMeasJobCtrlMnS:schedule_Type ;
            TS28550_PerfMeasJobCtrlMnS:dailySchedule [ a TS28550_PerfMeasJobCtrlMnS:timeInterval_Type ;
