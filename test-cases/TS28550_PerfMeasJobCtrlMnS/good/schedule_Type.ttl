@prefix TS28550_PerfMeasJobCtrlMnS: <http://ericsson.com/models/3gpp/TS28550/PerfMeasJobCtrlMnS#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28550_PerfMeasJobCtrlMnS:test_instance a TS28550_PerfMeasJobCtrlMnS:schedule_Type ;
    TS28550_PerfMeasJobCtrlMnS:dailySchedule [ a TS28550_PerfMeasJobCtrlMnS:timeInterval_Type ;
            TS28550_PerfMeasJobCtrlMnS:intervalEnd "test-value"^^xsd:string ;
            TS28550_PerfMeasJobCtrlMnS:intervalStart "test-value"^^xsd:string ] ;
    TS28550_PerfMeasJobCtrlMnS:scheduleOption "daily"^^xsd:string ;
    TS28550_PerfMeasJobCtrlMnS:weeklySchedule [ a TS28550_PerfMeasJobCtrlMnS:scheduleOfDay_Type ;
            TS28550_PerfMeasJobCtrlMnS:dayOfWeek "Monday"^^xsd:string ;
            TS28550_PerfMeasJobCtrlMnS:intervalsOfDay [ a TS28550_PerfMeasJobCtrlMnS:timeInterval_Type ;
                    TS28550_PerfMeasJobCtrlMnS:intervalEnd "test-value"^^xsd:string ;
                    TS28550_PerfMeasJobCtrlMnS:intervalStart "test-value"^^xsd:string ] ] .

