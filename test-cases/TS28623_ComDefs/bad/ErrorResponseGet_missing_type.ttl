@prefix TS28623_ComDefs: <https://example.org/TS28623_ComDefs/> .
@prefix ns1: <https://example.org/TS28623_ComDefs/ErrorResponseGet/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28623_ComDefs:test_instance a TS28623_ComDefs:ErrorResponseGet ;
    ns1:badQueryParams "test-value"^^xsd:string ;
    ns1:otherProblems [ a TS28623_ComDefs:otherProblems ;
            TS28623_ComDefs:badQueryParams "test-value"^^xsd:string ;
            TS28623_ComDefs:reason "test-value"^^xsd:string ;
            TS28623_ComDefs:status "test-value"^^xsd:string ;
            TS28623_ComDefs:title "test-value"^^xsd:string ;
            TS28623_ComDefs:type "test-value"^^xsd:string ] ;
    ns1:reason "test-value"^^xsd:string ;
    ns1:status "test-value"^^xsd:string ;
    ns1:title "test-value"^^xsd:string .

