@prefix TS28623_ComDefs: <https://example.org/TS28623_ComDefs/> .
@prefix ns1: <https://example.org/TS28623_ComDefs/GeoCoordinate#> .
@prefix ns2: <https://example.org/TS28623_ComDefs/GeoAreaToCellMapping#> .
@prefix ns3: <https://example.org/TS28623_ComDefs/GeoArea#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28623_ComDefs:test_instance a TS28623_ComDefs:GeoAreaToCellMapping ;
    ns2:associationThreshold 50 ;
    ns2:geoArea [ a TS28623_ComDefs:GeoArea ;
            ns3:convexGeoPolygon [ a TS28623_ComDefs:GeoCoordinate ;
                    ns1:altitude "50.0"^^xsd:float ;
                    ns1:latitude "0.0"^^xsd:float ;
                    ns1:longitude "0.0"^^xsd:float ],
                [ a TS28623_ComDefs:GeoCoordinate ;
                    ns1:altitude "50.0"^^xsd:float ;
                    ns1:latitude "0.0"^^xsd:float ;
                    ns1:longitude "0.0"^^xsd:float ],
                [ a TS28623_ComDefs:GeoCoordinate ;
                    ns1:altitude "50.0"^^xsd:float ;
                    ns1:latitude "0.0"^^xsd:float ;
                    ns1:longitude "0.0"^^xsd:float ] ] .

