                    TS28623_ComDefs:longitude "0.0"^^xsd:float ],
                [ a TS28623_ComDefs:GeoCoordinate ;
                    TS28623_ComDefs:altitude "50.0"^^xsd:float ;
                    TS28623_ComDefs:latitude "0.0"^^xsd:float ;
                    TS28623_ComDefs:longitude "0.0"^^xsd:float ],
                [ a TS28623_ComDefs:GeoCoordinate ;
                    TS28623_ComDefs:altitude "50.0"^^xsd:float ;
                    TS28623_ComDefs:latitude "0.0"^^xsd:float ;
                    TS28623_ComDefs:longitude "0.0"^^xsd:float ] ] .

