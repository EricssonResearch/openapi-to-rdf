@prefix TS28623_ComDefs: <http://ericsson.com/models/3gpp/TS28623/ComDefs#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28623/ComDefs/GeoAreaToCellMapping#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS28623/ComDefs/GeoCoordinate#> .
@prefix ns3: <http://ericsson.com/models/3gpp/TS28623/ComDefs/GeoArea#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28623_ComDefs:test_instance a TS28623_ComDefs:GeoAreaToCellMapping ;
    ns1:associationThreshold 50 ;
    ns1:geoArea [ a TS28623_ComDefs:GeoArea ;
            ns3:convexGeoPolygon [ a TS28623_ComDefs:GeoCoordinate ;
                    ns2:altitude "50.0"^^xsd:float ;
                    ns2:latitude "0.0"^^xsd:float ;
                    ns2:longitude "0.0"^^xsd:float ],
                [ a TS28623_ComDefs:GeoCoordinate ;
                    ns2:altitude "50.0"^^xsd:float ;
                    ns2:latitude "0.0"^^xsd:float ;
                    ns2:longitude "0.0"^^xsd:float ],
                [ a TS28623_ComDefs:GeoCoordinate ;
                    ns2:altitude "50.0"^^xsd:float ;
                    ns2:latitude "0.0"^^xsd:float ;
                    ns2:longitude "0.0"^^xsd:float ] ] .

