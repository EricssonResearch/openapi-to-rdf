@prefix TS29571_CommonData: <https://example.org/TS29571_CommonData/> .
@prefix ns1: <https://example.org/TS29571_CommonData/Property#> .
@prefix ns2: <https://example.org/TS29571_CommonData/HalTemplate#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:HalTemplate ;
    ns2:contentType "test-value"^^xsd:string ;
    ns2:method "GET"^^xsd:string ;
    ns2:properties [ a TS29571_CommonData:Property ;
            ns1:name "test-value"^^xsd:string ;
            ns1:regex "test-value"^^xsd:string ;
            ns1:required true ;
            ns1:value "test-value"^^xsd:string ] ;
    ns2:title "test-value"^^xsd:string .

