@prefix TS29571_CommonData: <https://example.org/TS29571_CommonData/> .
@prefix ns1: <https://example.org/TS29571_CommonData/ChangeItem/> .
@prefix ns2: <https://example.org/TS29571_CommonData/NotifyItem/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:NotifyItem ;
    ns2:changes [ a TS29571_CommonData:ChangeItem ;
            ns1:from "test-value"^^xsd:string ;
            ns1:op "ADD"^^xsd:string ;
            ns1:path "test-value"^^xsd:string ] ;
    ns2:resourceId "test-value"^^xsd:string .

