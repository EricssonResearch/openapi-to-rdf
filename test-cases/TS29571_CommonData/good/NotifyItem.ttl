@prefix TS29571_CommonData: <http://ericsson.com/models/3gpp/TS29571/CommonData#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS29571/CommonData/NotifyItem#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS29571/CommonData/ChangeItem#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:NotifyItem ;
    ns1:changes [ a TS29571_CommonData:ChangeItem ;
            ns2:from "test-value"^^xsd:string ;
            ns2:op "ADD"^^xsd:string ;
            ns2:path "test-value"^^xsd:string ] ;
    ns1:resourceId "test-value"^^xsd:string .

