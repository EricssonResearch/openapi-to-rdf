@prefix TS29571_CommonData: <http://ericsson.com/models/3gpp/TS29571/CommonData#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS29571/CommonData/ServiceAreaRestriction#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:ServiceAreaRestriction ;
    ns1:areas [ a TS29571_CommonData:Area ;
            TS29571_CommonData:areaCode "test-value"^^xsd:string ;
            TS29571_CommonData:tacs "aaaa"^^xsd:string ] ;
    ns1:maxNumOfTAs 50 ;
    ns1:maxNumOfTAsForNotAllowedAreas -1 ;
    ns1:restrictionType "ALLOWED_AREAS"^^xsd:string .

