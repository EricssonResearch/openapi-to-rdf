@prefix TS29571_CommonData: <https://example.org/TS29571_CommonData/> .
@prefix ns1: <https://example.org/TS29571_CommonData/Arp/> .
@prefix ns2: <https://example.org/TS29571_CommonData/SubscribedDefaultQos/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:SubscribedDefaultQos ;
    ns2:5qi 127 ;
    ns2:arp [ a TS29571_CommonData:Arp ;
            ns1:preemptCap "NOT_PREEMPT"^^xsd:string ;
            ns1:preemptVuln "NOT_PREEMPTABLE"^^xsd:string ;
            ns1:priorityLevel 8 ] ;
    ns2:priorityLevel 0 .

