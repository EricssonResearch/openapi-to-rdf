@prefix ns2: <https://example.org/TS29571_CommonData/Pc5FlowBitRates/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:Pc5QosFlowItem ;
    ns1:pc5FlowBitRates [ a TS29571_CommonData:Pc5FlowBitRates ;
            ns2:guaFbr "aaaa"^^xsd:string ;
            ns2:maxFbr "aaaa"^^xsd:string ] ;
    ns1:pqi 127 ;
    ns1:range -1 .

