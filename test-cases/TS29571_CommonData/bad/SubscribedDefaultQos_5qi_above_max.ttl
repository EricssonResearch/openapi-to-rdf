@prefix TS29571_CommonData: <https://example.org/TS29571_CommonData/> .
@prefix ns1: <https://example.org/TS29571_CommonData/SubscribedDefaultQos#> .
@prefix ns2: <https://example.org/TS29571_CommonData/Arp#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:SubscribedDefaultQos ;
    ns1:5qi 256 ;
    ns1:arp [ a TS29571_CommonData:Arp ;
            ns2:preemptCap "NOT_PREEMPT"^^xsd:string ;
            ns2:preemptVuln "NOT_PREEMPTABLE"^^xsd:string ;
            ns2:priorityLevel 8 ] ;
    ns1:priorityLevel 64 .

