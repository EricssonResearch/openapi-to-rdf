@prefix TS29571_CommonData: <http://ericsson.com/models/3gpp/TS29571/CommonData#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS29571/CommonData/SubscribedDefaultQos#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS29571/CommonData/Arp#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:SubscribedDefaultQos ;
    ns1:5qi 256 ;
    ns1:arp [ a TS29571_CommonData:Arp ;
            ns2:preemptCap "NOT_PREEMPT"^^xsd:string ;
            ns2:preemptVuln "NOT_PREEMPTABLE"^^xsd:string ;
            ns2:priorityLevel 8 ] ;
    ns1:priorityLevel 64 .

