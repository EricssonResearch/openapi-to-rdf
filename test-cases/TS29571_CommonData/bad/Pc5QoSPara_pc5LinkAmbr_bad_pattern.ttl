TS29571_CommonData:test_instance a TS29571_CommonData:Pc5QoSPara ;
    ns1:pc5LinkAmbr "!!!INVALID!!!"^^xsd:string ;
    ns1:pc5QosFlowList [ a TS29571_CommonData:Pc5QosFlowItem ;
            ns2:pc5FlowBitRates [ a TS29571_CommonData:Pc5FlowBitRates ;
                    ns3:guaFbr "aaaa"^^xsd:string ;
                    ns3:maxFbr "aaaa"^^xsd:string ] ;
            ns2:pqi 127 ;
            ns2:range 50 ] .

