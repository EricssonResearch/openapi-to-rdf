@prefix TS29571_CommonData: <http://ericsson.com/models/3gpp/TS29571/CommonData#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS29571/CommonData/ChangeItem#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS29571/CommonData/NotifyItem#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:NotifyItem ;
    ns2:changes [ a TS29571_CommonData:ChangeItem ;
            ns1:from "test-value"^^xsd:string ;
            ns1:op "ADD"^^xsd:string ;
            ns1:path "test-value"^^xsd:string ] .

