@prefix TS29571_CommonData: <https://example.org/TS29571_CommonData/> .
@prefix ns1: <https://example.org/TS29571_CommonData/NotifyItem/> .
@prefix ns2: <https://example.org/TS29571_CommonData/ChangeItem/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:NotifyItem ;
    ns1:changes [ a TS29571_CommonData:ChangeItem ;
            ns2:from "test-value"^^xsd:string ;
            ns2:op "ADD"^^xsd:string ;
            ns2:path "test-value"^^xsd:string ] .

