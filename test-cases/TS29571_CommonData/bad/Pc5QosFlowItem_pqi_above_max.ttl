@prefix TS29571_CommonData: <https://example.org/TS29571_CommonData/> .
@prefix ns1: <https://example.org/TS29571_CommonData/Pc5FlowBitRates#> .
@prefix ns2: <https://example.org/TS29571_CommonData/Pc5QosFlowItem#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:Pc5QosFlowItem ;
    ns2:pc5FlowBitRates [ a TS29571_CommonData:Pc5FlowBitRates ;
            ns1:guaFbr "aaaa"^^xsd:string ;
            ns1:maxFbr "aaaa"^^xsd:string ] ;
    ns2:pqi 256 ;
    ns2:range 50 .

