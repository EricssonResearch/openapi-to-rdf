@prefix TS29571_CommonData: <http://ericsson.com/models/3gpp/TS29571/CommonData#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS29571/CommonData/Arp#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS29571/CommonData/SubscribedDefaultQos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:SubscribedDefaultQos ;
    ns2:5qi -1 ;
    ns2:arp [ a TS29571_CommonData:Arp ;
            ns1:preemptCap "NOT_PREEMPT"^^xsd:string ;
            ns1:preemptVuln "NOT_PREEMPTABLE"^^xsd:string ;
            ns1:priorityLevel 8 ] ;
    ns2:priorityLevel 64 .

