@prefix TS29571_CommonData: <http://ericsson.com/models/3gpp/TS29571/CommonData#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS29571/CommonData/ProblemDetails#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS29571/CommonData/InvalidParam#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:ProblemDetails ;
    ns1:cause "test-value"^^xsd:string ;
    ns1:detail "test-value"^^xsd:string ;
    ns1:instance "test-value"^^xsd:string ;
    ns1:invalidParams [ a TS29571_CommonData:InvalidParam ;
            ns2:param "test-value"^^xsd:string ;
            ns2:reason "test-value"^^xsd:string ] ;
    ns1:nrfId "test-value"^^xsd:string ;
    ns1:status 50 ;
    ns1:supportedFeatures "!!!INVALID!!!"^^xsd:string ;
    ns1:title "test-value"^^xsd:string ;
    ns1:type "test-value"^^xsd:string .

