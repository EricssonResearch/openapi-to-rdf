@prefix TS29571_CommonData: <http://ericsson.com/models/3gpp/TS29571/CommonData#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS29571/CommonData/InvalidParam#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS29571/CommonData/ProblemDetails#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29571_CommonData:test_instance a TS29571_CommonData:ProblemDetails ;
    ns2:cause "test-value"^^xsd:string ;
    ns2:detail "test-value"^^xsd:string ;
    ns2:instance "test-value"^^xsd:string ;
    ns2:invalidParams [ a TS29571_CommonData:InvalidParam ;
            ns1:param "test-value"^^xsd:string ;
            ns1:reason "test-value"^^xsd:string ] ;
    ns2:nrfId "test-value"^^xsd:string ;
    ns2:status 50 ;
    ns2:supportedFeatures "!!!INVALID!!!"^^xsd:string ;
    ns2:title "test-value"^^xsd:string ;
    ns2:type "test-value"^^xsd:string .

