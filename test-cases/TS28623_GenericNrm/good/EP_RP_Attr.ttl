@prefix TS28623_GenericNrm: <https://example.org/TS28623_GenericNrm/> .
@prefix ns1: <https://example.org/TS28623_GenericNrm/SupportedPerfMetricGroup#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28623_GenericNrm:test_instance a TS28623_GenericNrm:EP_RP_Attr ;
    TS28623_GenericNrm:farEndEntity "test-value"^^xsd:string ;
    TS28623_GenericNrm:supportedPerfMetricGroups [ a TS28623_GenericNrm:SupportedPerfMetricGroup ;
            ns1:granularityPeriods 50 ;
            ns1:performanceMetrics "test-value"^^xsd:string ;
            ns1:reportingMethods "FILE_BASED_LOC_SET_BY_PRODUCER"^^xsd:string ;
            ns1:reportingPeriods 50 ] ;
    TS28623_GenericNrm:userLabel "test-value"^^xsd:string .

