@prefix TS28541_NrNrm: <http://ericsson.com/models/3gpp/TS28541/NrNrm#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28541/NrNrm/RimRSReportInfo#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS28541/NrNrm/RimRSReportConf#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28541_NrNrm:test_instance a TS28541_NrNrm:RimRSReportConf ;
    ns2:maxPropagationDelay 50 ;
    ns2:nrofRIMRSReportInfo 50 ;
    ns2:reportIndicator "ENABLE"^^xsd:string ;
    ns2:reportInterval 50 ;
    ns2:rimRSReportInfoList [ a TS28541_NrNrm:RimRSReportInfo ;
            ns1:detectedSetID 50 ;
            ns1:functionalityOfRIMRS "RS1"^^xsd:string ;
            ns1:propagationDelay 50 ] .

