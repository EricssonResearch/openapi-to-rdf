@prefix TS28541_NrNrm: <http://ericsson.com/models/3gpp/TS28541/NrNrm#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28541/NrNrm/SequenceDomainPara#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28541_NrNrm:test_instance a TS28541_NrNrm:SequenceDomainPara ;
    ns1:enableEnoughNotEnoughIndication "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    ns1:nrofRIMRSSequenceCandidatesofRS1 50 ;
    ns1:nrofRIMRSSequenceCandidatesofRS2 50 ;
    ns1:rIMRSScrambleTimerMultiplier 50 ;
    ns1:rIMRSScrambleTimerOffset 50 ;
    ns1:rimRSScrambleIdListofRS1 50 ;
    ns1:rimRSScrambleIdListofRS2 50 .

