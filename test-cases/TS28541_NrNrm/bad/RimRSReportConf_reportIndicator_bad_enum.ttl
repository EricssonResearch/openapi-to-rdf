@prefix TS28541_NrNrm: <http://ericsson.com/models/3gpp/TS28541/NrNrm#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28541_NrNrm:test_instance a TS28541_NrNrm:RimRSReportConf ;
    TS28541_NrNrm:maxPropagationDelay 50 ;
    TS28541_NrNrm:nrofRIMRSReportInfo 50 ;
    TS28541_NrNrm:reportIndicator "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    TS28541_NrNrm:reportInterval 50 ;
    TS28541_NrNrm:rimRSReportInfoList [ a TS28541_NrNrm:RimRSReportInfo ;
            TS28541_NrNrm:detectedSetID 50 ;
            TS28541_NrNrm:functionalityOfRIMRS "RS1"^^xsd:string ;
            TS28541_NrNrm:propagationDelay 50 ] .

