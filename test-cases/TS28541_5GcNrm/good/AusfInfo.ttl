@prefix TS28541_5GcNrm: <https://example.org/TS28541_5GcNrm/> .
@prefix ns1: <https://example.org/TS28541_5GcNrm/AusfInfo#> .
@prefix ns2: <https://example.org/TS28541_5GcNrm/SuciInfo#> .
@prefix ns3: <https://example.org/TS28541_5GcNrm/SupiRange#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28541_5GcNrm:test_instance a TS28541_5GcNrm:AusfInfo ;
    ns1:nFSrvGroupId "test-value"^^xsd:string ;
    ns1:routingIndicators "0"^^xsd:string ;
    ns1:suciInfos [ a TS28541_5GcNrm:SuciInfo ;
            ns2:hNwPubKeyIds 50 ;
            ns2:routingInds "test-value"^^xsd:string ] ;
    ns1:supiRanges [ a TS28541_5GcNrm:SupiRange ;
            ns3:end "test-value"^^xsd:string ;
            ns3:pattern "test-value"^^xsd:string ;
            ns3:start "test-value"^^xsd:string ] .

