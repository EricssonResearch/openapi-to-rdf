@prefix TS28312_IntentNrm: <http://ericsson.com/models/3gpp/TS28312/IntentNrm#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentNrm:test_instance a TS28312_IntentNrm:ExpectationFulfilmentResult ;
    TS28312_IntentNrm:expectaitonId "test-value"^^xsd:string ;
    TS28312_IntentNrm:expectationFulfilmentInfo [ a TS28312_IntentNrm:FulfilmentInfo ;
            TS28312_IntentNrm:fulfilmentStatus "FULFILLED"^^xsd:string ;
            TS28312_IntentNrm:notFulfilledReasons "test-value"^^xsd:string ;
            TS28312_IntentNrm:notFullfilledState "ACKNOWLEDGED"^^xsd:string ] ;
    TS28312_IntentNrm:targetFulfilmentResult [ a TS28312_IntentNrm:TargetFulfilmentResult ;
            TS28312_IntentNrm:targetAchievedValue 5e+01 ;
            TS28312_IntentNrm:targetFulfilmentInfo [ a TS28312_IntentNrm:FulfilmentInfo ;
                    TS28312_IntentNrm:fulfilmentStatus "FULFILLED"^^xsd:string ;
                    TS28312_IntentNrm:notFulfilledReasons "test-value"^^xsd:string ;
                    TS28312_IntentNrm:notFullfilledState "ACKNOWLEDGED"^^xsd:string ] ;
            TS28312_IntentNrm:targetName "test-value"^^xsd:string ] .

