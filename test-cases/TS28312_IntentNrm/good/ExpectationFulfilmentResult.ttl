@prefix TS28312_IntentNrm: <http://ericsson.com/models/3gpp/TS28312/IntentNrm#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28312/IntentNrm/FulfilmentInfo#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS28312/IntentNrm/ExpectationFulfilmentResult#> .
@prefix ns3: <http://ericsson.com/models/3gpp/TS28312/IntentNrm/TargetFulfilmentResult#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentNrm:test_instance a TS28312_IntentNrm:ExpectationFulfilmentResult ;
    ns2:expectaitonId "test-value"^^xsd:string ;
    ns2:expectationFulfilmentInfo [ a TS28312_IntentNrm:FulfilmentInfo ;
            ns1:fulfilmentStatus "FULFILLED"^^xsd:string ;
            ns1:notFulfilledReasons "test-value"^^xsd:string ;
            ns1:notFullfilledState "ACKNOWLEDGED"^^xsd:string ] ;
    ns2:targetFulfilmentResult [ a TS28312_IntentNrm:TargetFulfilmentResult ;
            ns3:targetAchievedValue 5e+01 ;
            ns3:targetFulfilmentInfo [ a TS28312_IntentNrm:FulfilmentInfo ;
                    ns1:fulfilmentStatus "FULFILLED"^^xsd:string ;
                    ns1:notFulfilledReasons "test-value"^^xsd:string ;
                    ns1:notFullfilledState "ACKNOWLEDGED"^^xsd:string ] ;
            ns3:targetName "test-value"^^xsd:string ] .

