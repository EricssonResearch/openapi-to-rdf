@prefix TS28312_IntentNrm: <https://example.org/TS28312_IntentNrm/> .
@prefix ns1: <https://example.org/TS28312_IntentNrm/FulfilmentInfo#> .
@prefix ns2: <https://example.org/TS28312_IntentNrm/TargetFulfilmentResult#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentNrm:test_instance a TS28312_IntentNrm:TargetFulfilmentResult ;
    ns2:targetAchievedValue 5e+01 ;
    ns2:targetFulfilmentInfo [ a TS28312_IntentNrm:FulfilmentInfo ;
            ns1:fulfilmentStatus "FULFILLED"^^xsd:string ;
            ns1:notFulfilledReasons "test-value"^^xsd:string ;
            ns1:notFullfilledState "ACKNOWLEDGED"^^xsd:string ] ;
    ns2:targetName "test-value"^^xsd:string .

