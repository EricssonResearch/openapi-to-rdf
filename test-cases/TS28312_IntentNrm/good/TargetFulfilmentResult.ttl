@prefix TS28312_IntentNrm: <http://ericsson.com/models/3gpp/TS28312/IntentNrm#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28312/IntentNrm/TargetFulfilmentResult#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS28312/IntentNrm/FulfilmentInfo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28312_IntentNrm:test_instance a TS28312_IntentNrm:TargetFulfilmentResult ;
    ns1:targetAchievedValue 5e+01 ;
    ns1:targetFulfilmentInfo [ a TS28312_IntentNrm:FulfilmentInfo ;
            ns2:fulfilmentStatus "FULFILLED"^^xsd:string ;
            ns2:notFulfilledReasons "test-value"^^xsd:string ;
            ns2:notFullfilledState "ACKNOWLEDGED"^^xsd:string ] ;
    ns1:targetName "test-value"^^xsd:string .

