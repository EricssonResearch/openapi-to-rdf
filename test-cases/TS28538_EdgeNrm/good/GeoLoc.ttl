@prefix TS28538_EdgeNrm: <http://ericsson.com/models/3gpp/TS28538/EdgeNrm#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28538/EdgeNrm/GeographicalCoordinates#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS28538/EdgeNrm/GeoLoc#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28538_EdgeNrm:test_instance a TS28538_EdgeNrm:GeoLoc ;
    ns2:civicLocation "test-value"^^xsd:string ;
    ns2:geographicalCoordinates [ a TS28538_EdgeNrm:GeographicalCoordinates ;
            ns1:latitude 50 ;
            ns1:longitude 50 ] .

