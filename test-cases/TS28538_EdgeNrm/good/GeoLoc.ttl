@prefix TS28538_EdgeNrm: <https://example.org/TS28538_EdgeNrm/> .
@prefix ns1: <https://example.org/TS28538_EdgeNrm/GeographicalCoordinates/> .
@prefix ns2: <https://example.org/TS28538_EdgeNrm/GeoLoc/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28538_EdgeNrm:test_instance a TS28538_EdgeNrm:GeoLoc ;
    ns2:civicLocation "test-value"^^xsd:string ;
    ns2:geographicalCoordinates [ a TS28538_EdgeNrm:GeographicalCoordinates ;
            ns1:latitude 50 ;
            ns1:longitude 50 ] .

