@prefix TS28538_EdgeNrm: <http://ericsson.com/models/3gpp/TS28538/EdgeNrm#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28538_EdgeNrm:test_instance a TS28538_EdgeNrm:GeoLoc ;
    TS28538_EdgeNrm:civicLocation "test-value"^^xsd:string ;
    TS28538_EdgeNrm:geographicalCoordinates [ a TS28538_EdgeNrm:GeographicalCoordinates ;
            TS28538_EdgeNrm:latitude 50 ;
            TS28538_EdgeNrm:longitude 50 ] .

