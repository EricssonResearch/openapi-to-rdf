@prefix TS28538_EdgeNrm: <http://ericsson.com/models/3gpp/TS28538/EdgeNrm#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28538/EdgeNrm/GeoLoc#> .
@prefix ns2: <http://ericsson.com/models/3gpp/TS28538/EdgeNrm/GeographicalCoordinates#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28538_EdgeNrm:test_instance a TS28538_EdgeNrm:GeoLoc ;
    ns1:civicLocation "test-value"^^xsd:string ;
    ns1:geographicalCoordinates [ a TS28538_EdgeNrm:GeographicalCoordinates ;
            ns2:latitude 50 ;
            ns2:longitude 50 ] .

