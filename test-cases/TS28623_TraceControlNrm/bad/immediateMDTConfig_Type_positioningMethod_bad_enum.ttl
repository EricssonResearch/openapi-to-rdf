@prefix TS28623_TraceControlNrm: <http://ericsson.com/models/3gpp/TS28623/TraceControlNrm#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28623_TraceControlNrm:test_instance a TS28623_TraceControlNrm:immediateMDTConfig_Type ;
    TS28623_TraceControlNrm:beamLevelMeasurement true ;
    TS28623_TraceControlNrm:collectionPeriodM6LTE "1024ms"^^xsd:string ;
    TS28623_TraceControlNrm:collectionPeriodM6NR "120ms"^^xsd:string ;
    TS28623_TraceControlNrm:collectionPeriodM7LTE 30 ;
    TS28623_TraceControlNrm:collectionPeriodM7NR 30 ;
    TS28623_TraceControlNrm:collectionPeriodRRMLTE "100ms"^^xsd:string ;
    TS28623_TraceControlNrm:collectionPeriodRRMNR "1024ms"^^xsd:string ;
    TS28623_TraceControlNrm:collectionPeriodRRMUMTS "100ms"^^xsd:string ;
    TS28623_TraceControlNrm:eventThreshold [ a TS28623_TraceControlNrm:eventThreshold_Type ;
            TS28623_TraceControlNrm:EventThreshold1F [ a TS28623_TraceControlNrm:EventThreshold1F ;
                    TS28623_TraceControlNrm:CPICH_EcNo -12 ;
                    TS28623_TraceControlNrm:CPICH_RSCP -48 ;
                    TS28623_TraceControlNrm:PathLoss 97 ] ;
            TS28623_TraceControlNrm:EventThreshold1I -48 ;
            TS28623_TraceControlNrm:EventThresholdRSRP "48"^^xsd:string ;
            TS28623_TraceControlNrm:EventThresholdRSRQ "17"^^xsd:string ;
            TS28623_TraceControlNrm:EventThresholdSINR 63 ] ;
    TS28623_TraceControlNrm:eventThresholdUphUMTS 15 ;
    TS28623_TraceControlNrm:excessPacketDelayThresholds [ a TS28623_TraceControlNrm:excessPacketDelayThreshold_Type ;
            TS28623_TraceControlNrm:excessPacketDelayThresholdValue "0.25MS"^^xsd:string ;
            TS28623_TraceControlNrm:fiveQIValue 50 ] ;
    TS28623_TraceControlNrm:listOfMeasurements [ a TS28623_TraceControlNrm:listOfMeasurements_Type ;
            TS28623_TraceControlNrm:LTE "M1"^^xsd:string ;
            TS28623_TraceControlNrm:NR "M1"^^xsd:string ;
            TS28623_TraceControlNrm:UMTS "M1"^^xsd:string ] ;
    TS28623_TraceControlNrm:measurementPeriodLTE "1024ms"^^xsd:string ;
    TS28623_TraceControlNrm:measurementPeriodUMTS "1000ms"^^xsd:string ;
    TS28623_TraceControlNrm:measurementQuantity "CPICH_ECNO"^^xsd:string ;
    TS28623_TraceControlNrm:positioningMethod "NOT_A_VALID_ENUM_VALUE"^^xsd:string ;
    TS28623_TraceControlNrm:reportAmount "1"^^xsd:string ;
    TS28623_TraceControlNrm:reportAmountM1LTE "1"^^xsd:string ;
    TS28623_TraceControlNrm:reportAmountM1NR "1"^^xsd:string ;
    TS28623_TraceControlNrm:reportAmountM4LTE "1"^^xsd:string ;
    TS28623_TraceControlNrm:reportAmountM4NR "1"^^xsd:string ;
    TS28623_TraceControlNrm:reportAmountM5LTE "1"^^xsd:string ;
    TS28623_TraceControlNrm:reportAmountM5NR "1"^^xsd:string ;
    TS28623_TraceControlNrm:reportAmountM6LTE "1"^^xsd:string ;
    TS28623_TraceControlNrm:reportAmountM6NR "1"^^xsd:string ;
    TS28623_TraceControlNrm:reportAmountM7LTE "1"^^xsd:string ;
    TS28623_TraceControlNrm:reportAmountM7NR "1"^^xsd:string ;
    TS28623_TraceControlNrm:reportInterval [ a TS28623_TraceControlNrm:reportInterval_Type ;
            TS28623_TraceControlNrm:LTE "120ms"^^xsd:string ;
            TS28623_TraceControlNrm:NR "120ms"^^xsd:string ;
            TS28623_TraceControlNrm:UMTS "250ms"^^xsd:string ] ;
    TS28623_TraceControlNrm:reportingTrigger "PERIODICAL"^^xsd:string .

