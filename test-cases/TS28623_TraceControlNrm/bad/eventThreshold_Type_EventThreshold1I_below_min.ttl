@prefix TS28623_TraceControlNrm: <http://ericsson.com/models/3gpp/TS28623/TraceControlNrm#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS28623/TraceControlNrm/eventThreshold_Type#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS28623_TraceControlNrm:test_instance a TS28623_TraceControlNrm:eventThreshold_Type ;
    ns1:EventThreshold1F [ a TS28623_TraceControlNrm:EventThreshold1F ;
            TS28623_TraceControlNrm:CPICH_EcNo -12 ;
            TS28623_TraceControlNrm:CPICH_RSCP -48 ;
            TS28623_TraceControlNrm:PathLoss 97 ] ;
    ns1:EventThreshold1I -121 ;
    ns1:EventThresholdRSRP "48"^^xsd:string ;
    ns1:EventThresholdRSRQ "17"^^xsd:string ;
    ns1:EventThresholdSINR 63 .

