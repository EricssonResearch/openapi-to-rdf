@prefix TS29512_Npcf_SMPolicyControl: <http://ericsson.com/models/3gpp/TS29512/Npcf_SMPolicyControl#> .
@prefix ns1: <http://ericsson.com/models/3gpp/TS29512/Npcf_SMPolicyControl/RedirectInformation#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

TS29512_Npcf_SMPolicyControl:test_instance a TS29512_Npcf_SMPolicyControl:RedirectInformation ;
    ns1:redirectAddressType "IPV4_ADDR"^^xsd:string ;
    ns1:redirectEnabled true ;
    ns1:redirectServerAddress "test-value"^^xsd:string .

